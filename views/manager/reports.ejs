<!-- Manager Reports View -->
<h1 id="pageTitle" class="page-title">Reports</h1>

<!-- Report Filters -->
<div class="report-card reports-filters-card">
  <div class="report-card-header">
    <h2>Generate Report</h2>
  </div>

  <div class="report-card-body">
    <div class="filter-row">
      <div class="filter-group">
        <label class="form-label" for="reportFrom">From</label>
        <input type="date" id="reportFrom" class="form-input" />
      </div>

      <div class="filter-group">
        <label class="form-label" for="reportTo">To</label>
        <input type="date" id="reportTo" class="form-input" />
      </div>

      <div class="filter-group">
        <label class="form-label" for="reportTeam">Team</label>
        <select id="reportTeam" class="form-select">
          <option value="">All Teams</option>
          <option value="1">Mufasa Solutions</option>
          <option value="2">Phoenix Team</option>
          <option value="3">Delta Squad</option>
        </select>
      </div>

      <button class="btn-submit" type="button">Generate</button>
    </div>
  </div>
</div>

<!-- AI Summary Section -->
<div class="ai-summary-card">
  <div class="ai-summary-header">
    <div class="ai-summary-title">
      <i class="fa-solid fa-wand-magic-sparkles"></i>
      <span>AI-Powered Summary</span>
    </div>
    <button class="btn-generate-ai" type="button">
      <i class="fa-solid fa-sparkles"></i>
      Generate Summary
    </button>
  </div>

  <div class="ai-summary-body">
    <div class="ai-summary-placeholder">
      <i class="fa-solid fa-robot"></i>
      <p>Click "Generate Summary" to create an AI-powered analysis of your team's activity, achievements, and areas for improvement.</p>
    </div>
  </div>
</div>

<!-- Report Preview -->
<div class="report-card">
  <div class="report-card-header">
    <h2>Engineering Department — Weekly Summary</h2>
    <span class="report-date">Mar 11 - Mar 18, 2026</span>
  </div>

  <div class="report-card-body">

    <!-- Stats Summary -->
    <div class="report-stats-grid">
      <div class="report-stat-card">
        <i class="fa-solid fa-users"></i>
        <div class="report-stat-info">
          <span class="report-stat-value">12</span>
          <span class="report-stat-label">Team Members</span>
        </div>
      </div>

      <div class="report-stat-card">
        <i class="fa-solid fa-clipboard-list"></i>
        <div class="report-stat-info">
          <span class="report-stat-value">156</span>
          <span class="report-stat-label">Total Entries</span>
        </div>
      </div>

      <div class="report-stat-card">
        <i class="fa-solid fa-trophy"></i>
        <div class="report-stat-info">
          <span class="report-stat-value">23</span>
          <span class="report-stat-label">Achievements</span>
        </div>
      </div>

      <div class="report-stat-card">
        <i class="fa-solid fa-bullseye"></i>
        <div class="report-stat-info">
          <span class="report-stat-value">3</span>
          <span class="report-stat-label">Goals Completed</span>
        </div>
      </div>
    </div>

    <!-- Export Actions -->
    <div class="action-row-left">
      <button class="btn-export-large" type="button" onclick="exportPDF()">
        <i class="fa-solid fa-file-pdf"></i> Export PDF
      </button>
      <button class="btn-export-large" type="button">
        <i class="fa-solid fa-file-excel"></i> Export Excel
      </button>
    </div>

    <!-- Success Message -->
    <p id="msg-confirmation" style="display:none; color:green; margin-top:10px;">
      ✅ Report generated successfully
    </p>

    <script>
      function exportPDF() {
        const idEquipo    = document.getElementById('reportTeam').value;
        const fechaInicio = document.getElementById('reportFrom').value;
        const fechaFin    = document.getElementById('reportTo').value;

        const idProyecto = '1'; // still hardcoded

        if (!idEquipo) {
          alert('Please select a team.');
          return;
        }
        if (!fechaInicio || !fechaFin) {
          alert('Please select a valid period (From and To).');
          return;
        }
        if (fechaInicio > fechaFin) {
          alert('Start date cannot be later than end date.');
          return;
        }

        const url = `/manager/reports/export-pdf?idEquipo=${idEquipo}&idProyecto=${idProyecto}&fechaInicio=${fechaInicio}&fechaFin=${fechaFin}`;

        window.location.href = url;

        const msg = document.getElementById('msg-confirmation');
        msg.style.display = 'block';
        setTimeout(() => { msg.style.display = 'none'; }, 4000);
      }
    </script>

  </div>
</div>