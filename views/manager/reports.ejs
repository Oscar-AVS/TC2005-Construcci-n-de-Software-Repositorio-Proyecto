<!-- Manager Reports View -->
<h1 id="pageTitle" class="page-title">Reports</h1>
<!-- Tabs del modulo de reportes -->
<div class="reports-tabs">
  <button
    type="button"
    class="reports-tab-button active"
    data-tab-target="standardReportPanel"
  >
    Standard Report
  </button>

  <button
    type="button"
    class="reports-tab-button"
    data-tab-target="periodComparisonPanel"
  >
    Period Comparison
  </button>
</div>

<div id="standardReportPanel" class="reports-tab-panel active"></div>

  <!-- Report Filters -->
  <div class="report-card reports-filters-card">
    <div class="report-card-header">
      <h2>Generate Report</h2>
    </div>

  <div class="report-card-body">
    <div class="filter-row">
      <div class="filter-group">
        <label class="form-label" for="quarterSelect">Quick Filters</label>
        <select id="quarterSelect" class="form-select">
  <option value="">Select a filter</option>

  <option value="LAST_WEEK">Last Week</option>
  <option value="LAST_MONTH">Last Month</option>

  <option value="Q1">Q1 (Jan - Mar)</option>
  <option value="Q2">Q2 (Apr - Jun)</option>
  <option value="Q3">Q3 (Jul - Sep)</option>
  <option value="Q4">Q4 (Oct - Dec)</option>
  </select>
      </div>

      <div class="filter-group">
        <label class="form-label" for="reportFrom">From</label>
        <input type="date" id="reportFrom" class="form-input" />
      </div>

      <div class="filter-group">
        <label class="form-label" for="reportTo">To</label>
        <input type="date" id="reportTo" class="form-input" />
      </div>

      <div class="filter-group">
        <label class="form-label" for="reportTeam">Team</label>
        <select id="reportTeam" class="form-select">
        <option value="">Select a Team</option>
        <% if (teams && teams.length > 0) { %>
          <% teams.forEach((team) => { %>
            <option value="<%= team.id_team %>"><%= team.team_name %></option>
            <% }) %>
          <% } %>
  </select>
  </div>

      <button class="btn-generate-ai" type="button" onclick="generateSummary()">
        <i class="fa-solid fa-sparkles"></i>
        Generate Summary &amp; Report
      </button>
    </div>
  </div>
</div>

    <div class="ai-summary-card">
  <div class="ai-summary-header">
    <div class="ai-summary-title">
      <i class="fa-solid fa-wand-magic-sparkles"></i>
      <span>AI-Powered Summary</span>
    </div>
  </div>


  <div class="ai-summary-body" id="aiSummaryBody">
    <!-- Placeholder (default state) -->
    <div class="ai-summary-placeholder" id="aiPlaceholder">
      <i class="fa-solid fa-robot"></i>
      <p>Click "Generate Summary" to create an AI-powered analysis of your team's activity, achievements, and areas for improvement.</p>
    </div>

    <!-- Loading state -->
    <div class="ai-summary-placeholder" id="aiLoading" style="display:none;">
      <i class="fa-solid fa-spinner fa-spin"></i>
      <p>Generating summary, please wait...</p>
    </div>

    <!-- Result -->
    <div id="aiResult" style="display:none;">
      <p id="aiOverall"></p>
      <h4>Highlights</h4>
      <ul id="aiHighlights"></ul>
      <h4>Risks</h4>
      <ul id="aiRisks"></ul>
      <h4>Recommendations</h4>
      <ul id="aiRecommendations"></ul>
    </div>
  </div>
</div>

<div id="reportMessage" class="report-message" style="display:none;"></div>


    <!-- Export Actions -->
    <div class="action-row-left">
      <button class="btn-export-large" type="button" onclick="exportPDF()">
        <i class="fa-solid fa-file-pdf"></i> Export PDF
      </button>
    </div>


<style>
  /* Tabs del modulo de reportes */
  .reports-tabs {
    display: flex;
    gap: 12px;
    margin-bottom: 20px;
  }

  .reports-tab-button {
    border: 1px solid #e5e7eb;
    background: #ffffff;
    color: #374151;
    padding: 10px 18px;
    border-radius: 10px;
    cursor: pointer;
    font-weight: 600;
    transition: all 0.2s ease;
  }

  .reports-tab-button.active {
    background: #f15a24;
    color: #ffffff;
    border-color: #f15a24;
  }

  .reports-tab-panel {
    display: none;
  }

  .reports-tab-panel.active {
    display: block;
  }

  /* Layout de los dos periodos a comparar */
  .comparison-periods-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  .comparison-period-card {
    border: 1px solid #e5e7eb;
    border-radius: 14px;
    background: #ffffff;
    padding: 18px;
  }

  .comparison-period-card h3 {
    margin-top: 0;
    margin-bottom: 16px;
    color: #111827;
  }

  .comparison-placeholder {
    min-height: 220px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 10px;
    color: #6b7280;
    text-align: center;
  }

  .comparison-placeholder i {
    font-size: 2rem;
    color: #f15a24;
  }

  @media (max-width: 900px) {
    .comparison-periods-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
    <script>
  let aiSummaryGenerated = false;

  function showReportMessage(message, type = 'info') {
    const messageBox = document.getElementById('reportMessage');
    messageBox.textContent = message;
    messageBox.className = `report-message ${type}`;
    messageBox.style.display = 'block';
  }

  function hideReportMessage() {
    const messageBox = document.getElementById('reportMessage');
    messageBox.textContent = '';
    messageBox.className = 'report-message';
    messageBox.style.display = 'none';
  }

  function generateReport() {
    const idEquipo = document.getElementById('reportTeam').value;
    const fechaInicio = document.getElementById('reportFrom').value;
    const fechaFin = document.getElementById('reportTo').value;

    if (!idEquipo) {
      showReportMessage('Please select a team.', 'error');
      return;
    }

    if (!fechaInicio || !fechaFin) {
      showReportMessage('Please select a valid period (From and To).', 'error');
      return;
    }

    if (fechaInicio > fechaFin) {
      showReportMessage('Start date cannot be later than end date.', 'error');
      return;
    }

    showReportMessage('Report generated successfully. Ready to export.', 'success');
  }

  async function generateSummary() {
    const idEquipo = document.getElementById('reportTeam').value;
    const fechaInicio = document.getElementById('reportFrom').value;
    const fechaFin = document.getElementById('reportTo').value;
    const idProyecto = '1';

    if (!idEquipo) {
      showReportMessage('Please select a team.', 'error');
      return;
    }

    if (!fechaInicio || !fechaFin) {
      showReportMessage('Please select a valid period (From and To).', 'error');
      return;
    }

    if (fechaInicio > fechaFin) {
      showReportMessage('Start date cannot be later than end date.', 'error');
      return;
    }

    hideReportMessage();
    aiSummaryGenerated = false;

    document.getElementById('aiPlaceholder').style.display = 'none';
    document.getElementById('aiResult').style.display = 'none';
    document.getElementById('aiLoading').style.display = 'flex';

    try {
      const url = `/manager/reports/ai-summary?idEquipo=${idEquipo}&idProyecto=${idProyecto}&fechaInicio=${fechaInicio}&fechaFin=${fechaFin}`;
      const response = await fetch(url);
      const data = await response.json();

      if (!response.ok) {
        showReportMessage(data.error || 'Error generating summary.', 'error');
        document.getElementById('aiLoading').style.display = 'none';
        document.getElementById('aiPlaceholder').style.display = 'flex';
        return;
      }

      document.getElementById('aiOverall').textContent = data.summary.overallAssessment;

      const highlightsList = document.getElementById('aiHighlights');
      highlightsList.innerHTML = '';
      data.summary.highlights.forEach((item) => {
        const li = document.createElement('li');
        li.textContent = item;
        highlightsList.appendChild(li);
      });

      const risksList = document.getElementById('aiRisks');
      risksList.innerHTML = '';
      data.summary.risks.forEach((item) => {
        const li = document.createElement('li');
        li.textContent = item;
        risksList.appendChild(li);
      });

      const recommendationsList = document.getElementById('aiRecommendations');
      recommendationsList.innerHTML = '';
      data.summary.recommendations.forEach((item) => {
        const li = document.createElement('li');
        li.textContent = item;
        recommendationsList.appendChild(li);
      });

      document.getElementById('aiLoading').style.display = 'none';
      document.getElementById('aiResult').style.display = 'block';
      aiSummaryGenerated = true;

      showReportMessage('AI summary generated successfully.', 'success');
    } catch (err) {
      console.error('Error generating summary:', err);
      showReportMessage('Unexpected error. Please try again.', 'error');
      document.getElementById('aiLoading').style.display = 'none';
      document.getElementById('aiPlaceholder').style.display = 'flex';
    }
  }

  function exportPDF() {
    const idEquipo = document.getElementById('reportTeam').value;
    const fechaInicio = document.getElementById('reportFrom').value;
    const fechaFin = document.getElementById('reportTo').value;
    const idProyecto = '1';

    if (!idEquipo) {
      showReportMessage('Please select a team.', 'error');
      return;
    }

    if (!fechaInicio || !fechaFin) {
      showReportMessage('Please select a valid period (From and To).', 'error');
      return;
    }

    if (fechaInicio > fechaFin) {
      showReportMessage('Start date cannot be later than end date.', 'error');
      return;
    }

    if (!aiSummaryGenerated) {
      showReportMessage('No AI summary generated yet. Please generate the summary before exporting the PDF.', 'error');
      return;
    }

    showReportMessage('Exporting PDF report...', 'info');

    const url = `/manager/reports/export-pdf?idEquipo=${idEquipo}&idProyecto=${idProyecto}&fechaInicio=${fechaInicio}&fechaFin=${fechaFin}`;
    window.location.href = url;
  }

  document.addEventListener('DOMContentLoaded', () => {
    const quarterSelect = document.getElementById('quarterSelect');
    const reportFrom = document.getElementById('reportFrom');
    const reportTo = document.getElementById('reportTo');
    const reportTeam = document.getElementById('reportTeam');

    function resetSummaryState() {
      aiSummaryGenerated = false;
      document.getElementById('aiResult').style.display = 'none';
      document.getElementById('aiLoading').style.display = 'none';
      document.getElementById('aiPlaceholder').style.display = 'flex';
      hideReportMessage();
    }

    if (quarterSelect) {
      quarterSelect.addEventListener('change', resetSummaryState);
    }

    if (reportFrom) {
      reportFrom.addEventListener('change', () => {
        quarterSelect.value = '';
        resetSummaryState();
      });
    }

    if (reportTo) {
      reportTo.addEventListener('change', () => {
        quarterSelect.value = '';
        resetSummaryState();
      });
    }

    if (reportTeam) {
      reportTeam.addEventListener('change', resetSummaryState);
    }

    if (quarterSelect && reportFrom && reportTo) {
      quarterSelect.addEventListener('change', () => {
        const selectedQuarter = quarterSelect.value;
        const year = new Date().getFullYear();

        let startDate = '';
        let endDate = '';

        switch (selectedQuarter) {
          case 'LAST_WEEK': {
            const today = new Date();
            const lastWeek = new Date();
            lastWeek.setDate(today.getDate() - 7);

            startDate = lastWeek.toISOString().split('T')[0];
            endDate = today.toISOString().split('T')[0];
            break;
          }

          case 'LAST_MONTH': {
            const today = new Date();

            const firstDayLastMonth = new Date(
              today.getFullYear(),
              today.getMonth() - 1,
              1
            );

            const lastDayLastMonth = new Date(
              today.getFullYear(),
              today.getMonth(),
              0
            );

            startDate = firstDayLastMonth.toISOString().split('T')[0];
            endDate = lastDayLastMonth.toISOString().split('T')[0];
            break;
          }

          case 'Q1':
            startDate = `${year}-01-01`;
            endDate = `${year}-03-31`;
            break;

          case 'Q2':
            startDate = `${year}-04-01`;
            endDate = `${year}-06-30`;
            break;

          case 'Q3':
            startDate = `${year}-07-01`;
            endDate = `${year}-09-30`;
            break;

          case 'Q4':
            startDate = `${year}-10-01`;
            endDate = `${year}-12-31`;
            break;

          default:
            startDate = '';
            endDate = '';
        }

        reportFrom.value = startDate;
        reportTo.value = endDate;
      });
    }
  });

    // Maneja el cambio entre tabs del modulo de reportes
  const reportsTabButtons = document.querySelectorAll('.reports-tab-button');
  const reportsTabPanels = document.querySelectorAll('.reports-tab-panel');

  const activateReportsTab = (targetId) => {
    reportsTabButtons.forEach((button) => {
      const isActive = button.dataset.tabTarget === targetId;
      button.classList.toggle('active', isActive);
    });

    reportsTabPanels.forEach((panel) => {
      panel.classList.toggle('active', panel.id === targetId);
    });
  };

  reportsTabButtons.forEach((button) => {
    button.addEventListener('click', () => {
      activateReportsTab(button.dataset.tabTarget);
    });
  });
</script>

  </div>
</div>

</div>

<div id="periodComparisonPanel" class="reports-tab-panel">
  <div class="report-card reports-filters-card">
    <div class="report-card-header">
      <h2>Compare Activity Between Periods</h2>
    </div>

    <div class="report-card-body">
      <div class="comparison-periods-grid">
        <div class="comparison-period-card">
          <h3>Period A</h3>

          <div class="filter-group">
            <label class="form-label" for="periodAFrom">From</label>
            <input type="date" id="periodAFrom" class="form-input" />
          </div>

          <div class="filter-group">
            <label class="form-label" for="periodATo">To</label>
            <input type="date" id="periodATo" class="form-input" />
          </div>
        </div>

        <div class="comparison-period-card">
          <h3>Period B</h3>

          <div class="filter-group">
            <label class="form-label" for="periodBFrom">From</label>
            <input type="date" id="periodBFrom" class="form-input" />
          </div>

          <div class="filter-group">
            <label class="form-label" for="periodBTo">To</label>
            <input type="date" id="periodBTo" class="form-input" />
          </div>
        </div>
      </div>

      <div class="action-row-left" style="margin-top: 20px;">
        <button type="button" class="btn-generate-ai" id="comparePeriodsBtn">
          <i class="fa-solid fa-code-compare"></i>
          Compare Periods
        </button>
      </div>
    </div>
  </div>

  <div class="report-card">
    <div class="report-card-header">
      <h2>Comparison Results</h2>
    </div>

    <div class="report-card-body">
      <div class="comparison-placeholder" id="comparisonPlaceholder">
        <i class="fa-solid fa-chart-column"></i>
        <p>Select Period A and Period B to compare team activity.</p>
      </div>
    </div>
  </div>
</div>