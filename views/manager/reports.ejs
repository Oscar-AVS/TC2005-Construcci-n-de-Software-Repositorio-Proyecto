<!-- Manager Reports View -->
<h1 id="pageTitle" class="page-title">Reports</h1>

<!-- Report Filters -->
<div class="report-card reports-filters-card">
  <div class="report-card-header">
    <h2>Generate Report</h2>
  </div>

  <div class="report-card-body">
    <div class="filter-row">
      <div class="filter-group">
        <label class="form-label" for="reportFrom">From</label>
        <input type="date" id="reportFrom" class="form-input" />
      </div>

      <div class="filter-group">
        <label class="form-label" for="reportTo">To</label>
        <input type="date" id="reportTo" class="form-input" />
      </div>

      <div class="filter-group">
        <label class="form-label" for="reportTeam">Team</label>
        <select id="reportTeam" class="form-select">
          <option value="">Select a Team</option>
          <option value="1">Mufasa Solutions</option>
          <option value="2">Phoenix Team</option>
          <option value="3">Delta Squad</option>
        </select>
      </div>

     <!-- AI Summary Section -->

    <button class="btn-generate-ai" type="button" onclick="generateSummary()">
      <i class="fa-solid fa-sparkles"></i>
      Generate Summary & Report
    </button>
    </div>
  </div>
</div>

    <div class="ai-summary-card">
  <div class="ai-summary-header">
    <div class="ai-summary-title">
      <i class="fa-solid fa-wand-magic-sparkles"></i>
      <span>AI-Powered Summary</span>
    </div>
  </div>


  <div class="ai-summary-body" id="aiSummaryBody">
    <!-- Placeholder (default state) -->
    <div class="ai-summary-placeholder" id="aiPlaceholder">
      <i class="fa-solid fa-robot"></i>
      <p>Click "Generate Summary" to create an AI-powered analysis of your team's activity, achievements, and areas for improvement.</p>
    </div>

    <!-- Loading state -->
    <div class="ai-summary-placeholder" id="aiLoading" style="display:none;">
      <i class="fa-solid fa-spinner fa-spin"></i>
      <p>Generating summary, please wait...</p>
    </div>

    <!-- Result -->
    <div id="aiResult" style="display:none;">
      <p id="aiOverall"></p>
      <h4>Highlights</h4>
      <ul id="aiHighlights"></ul>
      <h4>Risks</h4>
      <ul id="aiRisks"></ul>
      <h4>Recommendations</h4>
      <ul id="aiRecommendations"></ul>
    </div>
  </div>
</div>

<div id="reportMessage" class="report-message" style="display:none;"></div>


    <!-- Export Actions -->
    <div class="action-row-left">
      <button class="btn-export-large" type="button" onclick="exportPDF()">
        <i class="fa-solid fa-file-pdf"></i> Export PDF
      </button>
    </div>


    <script>
        function showReportMessage(message, type = 'info') {
          const messageBox = document.getElementById('reportMessage');
          messageBox.textContent = message;
          messageBox.className = `report-message ${type}`;
          messageBox.style.display = 'block';
        }

        function hideReportMessage() {
          const messageBox = document.getElementById('reportMessage');
          messageBox.textContent = '';
          messageBox.className = 'report-message';
          messageBox.style.display = 'none';
        }

        function generateReport() {
        const idEquipo = document.getElementById('reportTeam').value;
        const fechaInicio = document.getElementById('reportFrom').value;
        const fechaFin = document.getElementById('reportTo').value;

        if (!idEquipo) {
          showReportMessage('Please select a team.', 'error');
          return;
        }

        if (!fechaInicio || !fechaFin) {
          showReportMessage('Please select a valid period (From and To).', 'error');
          return;
        }

        if (fechaInicio > fechaFin) {
          showReportMessage('Start date cannot be later than end date.', 'error');
          return;
        }

        showReportMessage('Report generated successfully. Ready to export.', 'success');
      }

      async function generateSummary() {
        const idEquipo = document.getElementById('reportTeam').value;
        const fechaInicio = document.getElementById('reportFrom').value;
        const fechaFin = document.getElementById('reportTo').value;
        const idProyecto = '1';

        if (!idEquipo) {
          showReportMessage('Please select a team.', 'error');
          return;
        }
        if (!fechaInicio || !fechaFin) {
          showReportMessage('Please select a valid period (From and To).', 'error');
          return;
        }
        if (fechaInicio > fechaFin) {
          showReportMessage('Start date cannot be later than end date.', 'error');
          return;
        }

        hideReportMessage();

        document.getElementById('aiPlaceholder').style.display = 'none';
        document.getElementById('aiResult').style.display = 'none';
        document.getElementById('aiLoading').style.display = 'flex';

        try {
          const url = `/manager/reports/ai-summary?idEquipo=${idEquipo}&idProyecto=${idProyecto}&fechaInicio=${fechaInicio}&fechaFin=${fechaFin}`;
          const response = await fetch(url);
          const data = await response.json();

          if (!response.ok) {
            showReportMessage(data.error || 'Error generating summary.', 'error');
            document.getElementById('aiLoading').style.display = 'none';
            document.getElementById('aiPlaceholder').style.display = 'flex';
            return;
          }

          document.getElementById('aiOverall').textContent = data.summary.overallAssessment;

          const highlightsList = document.getElementById('aiHighlights');
          highlightsList.innerHTML = '';
          data.summary.highlights.forEach((item) => {
            const li = document.createElement('li');
            li.textContent = item;
            highlightsList.appendChild(li);
          });

          const risksList = document.getElementById('aiRisks');
          risksList.innerHTML = '';
          data.summary.risks.forEach((item) => {
            const li = document.createElement('li');
            li.textContent = item;
            risksList.appendChild(li);
          });

          const recommendationsList = document.getElementById('aiRecommendations');
          recommendationsList.innerHTML = '';
          data.summary.recommendations.forEach((item) => {
            const li = document.createElement('li');
            li.textContent = item;
            recommendationsList.appendChild(li);
          });

          document.getElementById('aiLoading').style.display = 'none';
          showReportMessage('AI summary generated successfully.', 'success');
          document.getElementById('aiResult').style.display = 'block';
        } catch (err) {
          console.error('Error generating summary:', err);
          showReportMessage('Unexpected error. Please try again.', 'error');
          document.getElementById('aiLoading').style.display = 'none';
          document.getElementById('aiPlaceholder').style.display = 'flex';
        }
      }

      function exportPDF() {
          const idEquipo = document.getElementById('reportTeam').value;
          const fechaInicio = document.getElementById('reportFrom').value;
          const fechaFin = document.getElementById('reportTo').value;
          const idProyecto = '1';

          if (!idEquipo) {
            showReportMessage('Please select a team.', 'error');
            return;
          }

          if (!fechaInicio || !fechaFin) {
            showReportMessage('Please select a valid period (From and To).', 'error');
            return;
          }

          if (fechaInicio > fechaFin) {
            showReportMessage('Start date cannot be later than end date.', 'error');
            return;
          }

          showReportMessage('Exporting PDF report...', 'info');

          const url = `/manager/reports/export-pdf?idEquipo=${idEquipo}&idProyecto=${idProyecto}&fechaInicio=${fechaInicio}&fechaFin=${fechaFin}`;
          window.location.href = url;
        }     


      document.addEventListener('DOMContentLoaded', () => {
      const generateButton = document.getElementById('generateReportBtn');

      if (generateButton) {
        generateButton.addEventListener('click', generateReport);
      }
    });
    </script>

  </div>
</div>