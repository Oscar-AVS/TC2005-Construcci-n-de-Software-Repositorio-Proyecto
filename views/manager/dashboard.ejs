<!-- Period Comparison -->
<div class="summary-grid">
  <div class="comparison-card">
    <div class="comparison-header">
      <h3>Entries vs Last Period</h3>
      <span class="comparison-badge up">
        <i class="fa-solid fa-arrow-up"></i> 12%
      </span>
    </div>
    <div class="comparison-values">
      <div class="comparison-period">
        <span class="period-label">This Period</span>
        <span class="period-value current">156</span>
      </div>
      <div class="comparison-period">
        <span class="period-label">Last Period</span>
        <span class="period-value">139</span>
      </div>
    </div>
  </div>

  <div class="comparison-card">
    <div class="comparison-header">
      <h3>Achievements vs Last Period</h3>
      <span class="comparison-badge up">
        <i class="fa-solid fa-arrow-up"></i> 21%
      </span>
    </div>
    <div class="comparison-values">
      <div class="comparison-period">
        <span class="period-label">This Period</span>
        <span class="period-value current">23</span>
      </div>
      <div class="comparison-period">
        <span class="period-label">Last Period</span>
        <span class="period-value">19</span>
      </div>
    </div>
  </div>
</div>

