            <div class="blocker-item">
              <img src="https://www.shutterstock.com/image-vector/blank-avatar-photo-place-holder-600nw-1095249842.jpg" alt="Lakshmi Martinez" />
              <div class="blocker-content">
                <p class="blocker-author">Lakshmi Martinez</p>
                <p class="blocker-text">Pending API documentation from Slack</p>
              </div>
              <span class="blocker-date">Yesterday</span>
            </div>
