<!-- Manager Highlights View -->
<h1 id="pageTitle" class="page-title">Highlights</h1>

<!-- Add Highlight Card -->
<div class="report-card">
  <div class="report-card-header">
    <h2>Add New Highlight</h2>
  </div>

  <div class="report-card-body">
    <form id="highlightForm">
      <input type="hidden" id="csrfToken" value="<%= csrfToken %>">

      <div class="form-row-grid">
        <div class="form-field">
          <label class="form-label" for="highlightTitle">Highlight Title</label>
          <input type="text" id="highlightTitle" name="title" class="form-input" placeholder="Enter highlight title..." />
        </div>

        <div class="form-field">
          <label class="form-label" for="highlightProject">Related Project</label>
          <select id="highlightProject" name="id_project" class="form-select">
            <option value="">Select a project...</option>
            <% if (availableProjects && availableProjects.length > 0) { %>
              <% availableProjects.forEach((project) => { %>
                <option value="<%= project.id_project %>"><%= project.project_name %></option>
              <% }); %>
            <% } %>
          </select>
        </div>
      </div>

      <div class="form-row-grid">
        <div class="form-field">
          <label class="form-label" for="highlightType">Highlight Type</label>
          <select id="highlightType" name="highlight_type" class="form-select">
            <option value="">Select a type...</option>
            <option value="technical">Technical</option>
            <option value="business">Business</option>
            <option value="team">Team</option>
            <option value="product">Product</option>
          </select>
        </div>

        <div class="form-field">
          <label class="form-label" for="highlightDate">Date</label>
          <input type="date" id="highlightDate" name="highlight_date" class="form-input" />
        </div>
      </div>

      <div class="form-field">
        <label class="form-label" for="highlightDesc">Description</label>
        <textarea id="highlightDesc" name="description" rows="3" placeholder="Describe this achievement..."></textarea>
      </div>

      <div class="form-field">
        <label class="form-label" for="highlightImpact">Impact</label>
        <textarea id="highlightImpact" name="impact" rows="2" placeholder="Describe the impact..."></textarea>
      </div>

      <div id="highlightFormMessage" class="form-message" style="display:none;"></div>

      <div class="action-row">
        <button class="btn-submit" type="submit">Add Highlight</button>
      </div>
    </form>
  </div>
</div>

<!-- Highlights Grid -->
<div class="report-card">
  <div class="report-card-header">
    <h2>Recent Highlights</h2>
    <span class="item-count">
      <%= highlights ? highlights.length : 0 %> highlight<%= highlights && highlights.length === 1 ? '' : 's' %>
    </span>
  </div>

  <div class="report-card-body">
    <% if (highlights && highlights.length > 0) { %>
      <div class="highlights-grid" id="highlightsGrid">
        <% highlights.forEach((highlight) => { %>
          <div class="highlight-card" data-id="<%= highlight.id_highlight %>">
            <div class="highlight-header">
              <div class="highlight-icon">
                <i class="fa-solid fa-trophy"></i>
              </div>
              <span class="highlight-date">
                <%= new Date(highlight.highlight_date).toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: 'numeric' }) %>
              </span>
            </div>

            <h3 class="highlight-title"><%= highlight.title %></h3>
            <p class="highlight-desc"><%= highlight.description %></p>

            <% if (highlight.impact) { %>
              <p class="highlight-impact"><span>Impact:</span> <%= highlight.impact %></p>
            <% } %>

            <div class="highlight-footer">
              <div class="highlight-tags">
                <% if (highlight.project_name) { %>
                  <span class="highlight-tag"><%= highlight.project_name %></span>
                <% } else if (highlight.team_name) { %>
                  <span class="highlight-tag"><%= highlight.team_name %></span>
                <% } else { %>
                  <span class="highlight-tag"><%= highlight.highlight_type %></span>
                <% } %>
              </div>

              <div class="highlight-actions">
                <button
                  class="btn-icon edit-highlight-btn"
                  type="button"
                  title="Edit"
                  data-id="<%= highlight.id_highlight %>"
                  data-title="<%= highlight.title %>"
                  data-description="<%= highlight.description %>"
                  data-impact="<%= highlight.impact || '' %>"
                  data-type="<%= highlight.highlight_type %>"
                  data-date="<%= highlight.highlight_date ? new Date(highlight.highlight_date).toISOString().split('T')[0] : '' %>"
                  data-project="<%= highlight.id_project || '' %>"
                >
                  <i class="fa-solid fa-pen"></i>
                </button>

                <button class="btn-icon btn-danger delete-highlight-btn" type="button" title="Delete">
                  <i class="fa-solid fa-trash"></i>
                </button>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <div id="highlightsEmptyState" class="empty-state">
        <p>No highlights registered yet.</p>
      </div>
      <div class="highlights-grid" id="highlightsGrid" style="display:none;"></div>
    <% } %>
  </div>
</div>

<!-- Edit Highlight Modal -->
<div class="modal-overlay" id="editHighlightModal">
  <div class="modal">
    <div class="modal-header">
      <h2>Edit Highlight</h2>
      <button class="modal-close" type="button" id="closeEditHighlightModal">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>

    <div id="editHighlightMessage" class="form-message" style="display:none; margin-bottom:12px;"></div>

    <div class="form-row-grid">
      <div class="form-field">
        <label class="form-label">Highlight Title</label>
        <input type="text" id="editHighlightTitle" class="form-input" placeholder="Enter highlight title..." />
      </div>

      <div class="form-field">
        <label class="form-label">Related Project</label>
        <select id="editHighlightProject" class="form-select">
          <option value="">Select a project...</option>
          <% if (availableProjects && availableProjects.length > 0) { %>
            <% availableProjects.forEach((project) => { %>
              <option value="<%= project.id_project %>"><%= project.project_name %></option>
            <% }); %>
          <% } %>
        </select>
      </div>
    </div>

    <div class="form-row-grid">
      <div class="form-field">
        <label class="form-label">Highlight Type</label>
        <select id="editHighlightType" class="form-select">
          <option value="">Select a type...</option>
          <option value="technical">Technical</option>
          <option value="business">Business</option>
          <option value="team">Team</option>
          <option value="product">Product</option>
        </select>
      </div>

      <div class="form-field">
        <label class="form-label">Date</label>
        <input type="date" id="editHighlightDate" class="form-input" />
      </div>
    </div>

    <div class="form-field">
      <label class="form-label">Description</label>
      <textarea id="editHighlightDesc" rows="3" placeholder="Describe this achievement..."></textarea>
    </div>

    <div class="form-field">
      <label class="form-label">Impact</label>
      <textarea id="editHighlightImpact" rows="2" placeholder="Describe the impact..."></textarea>
    </div>

    <div class="action-row" style="justify-content:flex-end; gap:12px; margin-top:16px;">
      <button type="button" id="cancelEditHighlightModal" class="btn-draft">Cancel</button>
      <button type="button" id="saveEditHighlightBtn" class="btn-submit">Save Changes</button>
    </div>
  </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal-overlay" id="deleteHighlightModal">
  <div class="modal" style="max-width:400px; text-align:center;">
    <div class="modal-header" style="justify-content:center; border:none;">
      <h2>Delete Highlight</h2>
    </div>
    <p style="color:var(--text-secondary); font-size:14px;">Are you sure you want to delete this highlight? This action cannot be undone.</p>
    <div class="action-row" style="justify-content:center; gap:16px; margin-top:16px;">
      <button type="button" id="cancelDeleteHighlight" class="btn-draft">Cancel</button>
      <button type="button" id="confirmDeleteHighlight" class="btn-submit" style="background:#dc2626;">Delete</button>
    </div>
  </div>
</div>

<script src="/js/highlights.js"></script>
