<!-- Manager Highlights View -->
<h1 id="pageTitle" class="page-title">Highlights</h1>

<!-- Add Highlight Card -->
<div class="report-card">
  <div class="report-card-header">
    <h2>Add New Highlight</h2>
  </div>

  <div class="report-card-body">
    <div class="form-row-grid">
      <div class="form-field">
        <label class="form-label" for="highlightTitle">Highlight Title</label>
        <input type="text" id="highlightTitle" class="form-input" placeholder="Enter highlight title..." />
      </div>

      <div class="form-field">
        <label class="form-label" for="highlightProject">Related Project</label>
        <select id="highlightProject" class="form-select">
          <option value="">Select a project...</option>
          <option value="1">Internal Tools</option>
          <option value="2">API Integration</option>
          <option value="3">Dashboard Redesign</option>
        </select>
      </div>
    </div>

    <div class="form-field">
      <label class="form-label" for="highlightDesc">Description</label>
      <textarea id="highlightDesc" rows="3" placeholder="Describe this achievement..."></textarea>
    </div>

    <div class="action-row">
      <button class="btn-draft" type="button">Save as Draft</button>
      <button class="btn-submit" type="button">Add Highlight</button>
    </div>
  </div>
</div>

