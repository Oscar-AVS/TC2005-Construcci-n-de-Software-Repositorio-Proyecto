<!-- Manager Highlights View -->
<h1 id="pageTitle" class="page-title">Highlights</h1>

<!-- Add Highlight Card -->
<div class="report-card">
  <div class="report-card-header">
    <h2>Add New Highlight</h2>
  </div>

  <div class="report-card-body">
    <form id="highlightForm">
      <input type="hidden" id="csrfToken" value="<%= csrfToken %>">

      <div class="form-row-grid">
        <div class="form-field">
          <label class="form-label" for="highlightTitle">Highlight Title</label>
          <input
            type="text"
            id="highlightTitle"
            name="title"
            class="form-input"
            placeholder="Enter highlight title..."
          />
        </div>

        <div class="form-field">
          <label class="form-label" for="highlightProject">Related Project</label>
          <select id="highlightProject" name="id_project" class="form-select">
            <option value="">Select a project...</option>
            <% if (availableProjects && availableProjects.length > 0) { %>
              <% availableProjects.forEach((project) => { %>
                <option value="<%= project.id_project %>">
                  <%= project.project_name %>
                </option>
              <% }); %>
            <% } %>
          </select>
        </div>
      </div>

      <div class="form-row-grid">
        <div class="form-field">
          <label class="form-label" for="highlightType">Highlight Type</label>
          <select id="highlightType" name="highlight_type" class="form-select">
            <option value="">Select a type...</option>
            <option value="technical">Technical</option>
            <option value="business">Business</option>
            <option value="team">Team</option>
            <option value="product">Product</option>
          </select>
        </div>

        <div class="form-field">
          <label class="form-label" for="highlightDate">Date</label>
          <input
            type="date"
            id="highlightDate"
            name="highlight_date"
            class="form-input"
          />
        </div>
      </div>

      <div class="form-field">
        <label class="form-label" for="highlightDesc">Description</label>
        <textarea
          id="highlightDesc"
          name="description"
          rows="3"
          placeholder="Describe this achievement..."
        ></textarea>
      </div>

      <div class="form-field">
        <label class="form-label" for="highlightImpact">Impact</label>
        <textarea
          id="highlightImpact"
          name="impact"
          rows="2"
          placeholder="Describe the impact..."
        ></textarea>
      </div>

      <div id="highlightFormMessage" class="form-message" style="display: none;"></div>

      <div class="action-row">
        <button class="btn-draft" type="button" disabled>Save as Draft</button>
        <button class="btn-submit" type="submit">Add Highlight</button>
      </div>
    </form>
  </div>
</div>

<!-- Highlights Grid -->
<div class="report-card">
  <div class="report-card-header">
    <h2>Recent Highlights</h2>
    <span class="item-count">
      <%= highlights ? highlights.length : 0 %> highlight<%= highlights && highlights.length === 1 ? '' : 's' %>
    </span>
  </div>

  <div class="report-card-body">
    <% if (highlights && highlights.length > 0) { %>
      <div class="highlights-grid" id="highlightsGrid">
        <% highlights.forEach((highlight) => { %>
          <div class="highlight-card" data-id="<%= highlight.id_highlight %>">
            <div class="highlight-header">
              <div class="highlight-icon">
                <i class="fa-solid fa-trophy"></i>
              </div>

              <span class="highlight-date">
                <%= new Date(highlight.highlight_date).toLocaleDateString('en-US', {
                  month: 'short',
                  day: '2-digit',
                  year: 'numeric',
                }) %>
              </span>
            </div>

            <h3 class="highlight-title"><%= highlight.title %></h3>

            <p class="highlight-desc"><%= highlight.description %></p>

            <% if (highlight.impact) { %>
              <p class="highlight-desc">
                <strong>Impact:</strong> <%= highlight.impact %>
              </p>
            <% } %>

            <div class="highlight-footer">
              <div class="highlight-tags">
                <% if (highlight.project_name) { %>
                  <span class="highlight-tag"><%= highlight.project_name %></span>
                <% } else if (highlight.team_name) { %>
                  <span class="highlight-tag"><%= highlight.team_name %></span>
                <% } else { %>
                  <span class="highlight-tag"><%= highlight.highlight_type %></span>
                <% } %>
              </div>

              <div class="highlight-actions">
                <button class="btn-icon" type="button" title="Edit">
                  <i class="fa-solid fa-pen"></i>
                </button>
                <button class="btn-icon btn-danger" type="button" title="Delete">
                  <i class="fa-solid fa-trash"></i>
                </button>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <div id="highlightsEmptyState" class="empty-state">
        <p>No highlights registered yet.</p>
      </div>

      <div class="highlights-grid" id="highlightsGrid" style="display: none;"></div>
    <% } %>
  </div>
</div>
</div>

<script src="/js/highlights.js"></script>