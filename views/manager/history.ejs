<!-- Manager History View -->
<h1 id="pageTitle" class="page-title">Contribution History</h1>

<!-- Advanced Filters -->
<div class="report-card filters-card">
  <div class="report-card-header">
    <h2>Filter History</h2>
  </div>

  <div class="report-card-body">
    <!-- Formulario que manda los filtros por query params -->
    <form action="/manager/history" method="GET" class="filters-grid">
      <div class="filter-group">
        <label class="form-label" for="filterUser">User</label>
        <select id="filterUser" name="id_user" class="form-select">
          <option value="">All Users</option>
          <% users.forEach((user) => { %>
            <option
              value="<%= user.id_user %>"
              <%= String(filters.id_user) === String(user.id_user) ? 'selected' : '' %>
            >
              <%= user.full_name %>
            </option>
          <% }); %>
        </select>
      </div>

      <div class="filter-group">
        <label class="form-label" for="filterProject">Project</label>
        <select id="filterProject" name="id_project" class="form-select">
          <option value="">All Projects</option>
          <% projects.forEach((project) => { %>
            <option
              value="<%= project.id_project %>"
              <%= String(filters.id_project) === String(project.id_project) ? 'selected' : '' %>
            >
              <%= project.project_name %>
            </option>
          <% }); %>
        </select>
      </div>

      <div class="filter-group">
        <label class="form-label" for="filterTeam">Team</label>
        <select id="filterTeam" name="id_team" class="form-select">
          <option value="">All Teams</option>
          <% teams.forEach((team) => { %>
            <option
              value="<%= team.id_team %>"
              <%= String(filters.id_team) === String(team.id_team) ? 'selected' : '' %>
            >
              <%= team.team_name %>
            </option>
          <% }); %>
        </select>
      </div>

      <div class="filter-group">
        <label class="form-label" for="filterFrom">From</label>
        <input
          type="date"
          id="filterFrom"
          name="date_from"
          class="form-input"
          value="<%= filters.date_from || '' %>"
        />
      </div>

      <div class="filter-group">
        <label class="form-label" for="filterTo">To</label>
        <input
          type="date"
          id="filterTo"
          name="date_to"
          class="form-input"
          value="<%= filters.date_to || '' %>"
        />
      </div>

      <!-- Boton para aplicar filtros -->
      <button class="btn-submit" type="submit">Apply Filters</button>
    </form>
  </div>
</div>

<!-- History List -->
<div class="report-card">
  <div class="report-card-header">
    <h2>Activity Log</h2>
    <span class="item-count"><%= totalEntries %> entr<%= totalEntries === 1 ? 'y' : 'ies' %></span>
  </div>

  <div class="report-card-body">
    <div class="history-list">

  <% if (logs.length === 0) { %>
    <!-- Mensaje cuando no hay resultados -->
    <p class="empty-text">No contributions found for the selected filters.</p>
  <% } %>

  <% logs.forEach((log) => { %>
    <div class="history-entry">
      
      <!-- Avatar -->
      <img
        class="history-avatar"
        src="https://www.shutterstock.com/image-vector/blank-avatar-photo-place-holder-600nw-1095249842.jpg"
        alt="<%= log.full_name %>"
      />

      <!-- Contenido principal -->
      <div class="history-content">
        <!-- Nombre del usuario -->
        <p class="history-author"><%= log.full_name %></p>

        <!-- Texto del log -->
        <p class="history-text">
          <%= log.completed || '' %>
          <% if (log.planned) { %>
            • Next: <%= log.planned %>
          <% } %>
        </p>
      </div>

      <!-- Meta info -->
      <div class="history-meta">
        <!-- Proyecto -->
        <span class="history-project">
          <%= log.project_name || 'No project' %>
        </span>

        <!-- Fecha -->
        <span class="history-date">
          <%= new Date(log.created_at).toLocaleDateString('en-US', {
            month: 'short',
            day: 'numeric',
            year: 'numeric'
          }) %>
        </span>
      </div>

    </div>
  <% }); %>

</div>

    <!-- Pagination hint -->
    <div class="action-row" style="justify-content: center; margin-top: 24px;">
      <button class="btn-draft" type="button">Load More</button>
    </div>
  </div>
</div> 