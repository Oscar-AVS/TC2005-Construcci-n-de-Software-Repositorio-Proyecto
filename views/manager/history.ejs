<!-- Manager History View -->
<h1 id="pageTitle" class="page-title">Contribution History</h1>

<!-- Advanced Filters -->
<div class="report-card filters-card">
  <div class="report-card-header">
    <h2>Filter History</h2>
  </div>

  <div class="report-card-body">
    <div class="filters-grid">
      <div class="filter-group">
        <label class="form-label" for="filterUser">User</label>
        <select id="filterUser" class="form-select">
          <option value="">All Users</option>
          <option value="1">Francisco Arreola</option>
          <option value="2">Lakshmi Martinez Jara</option>
          <option value="3">Oscar Vilchis</option>
        </select>
      </div>

      <div class="filter-group">
        <label class="form-label" for="filterProject">Project</label>
        <select id="filterProject" class="form-select">
          <option value="">All Projects</option>
          <option value="1">Internal Tools</option>
          <option value="2">API Integration</option>
          <option value="3">Dashboard Redesign</option>
        </select>
      </div>

      <div class="filter-group">
        <label class="form-label" for="filterTeam">Team</label>
        <select id="filterTeam" class="form-select">
          <option value="">All Teams</option>
          <option value="1">Mufasa Solutions</option>
          <option value="2">Phoenix Team</option>
          <option value="3">Delta Squad</option>
        </select>
      </div>

      <div class="filter-group">
        <label class="form-label" for="filterFrom">From</label>
        <input type="date" id="filterFrom" class="form-input" />
      </div>

      <div class="filter-group">
        <label class="form-label" for="filterTo">To</label>
        <input type="date" id="filterTo" class="form-input" />
      </div>

      <button class="btn-submit" type="button">Apply Filters</button>
    </div>
  </div>
</div>

