<!-- Manager History View -->
<h1 id="pageTitle" class="page-title">Contribution History</h1>

<!-- Advanced Filters -->
<div class="report-card filters-card">
  <div class="report-card-header">
    <h2>Filter History</h2>
  </div>

  <div class="report-card-body">
    <!-- Formulario que manda los filtros por query params -->
    <form action="/manager/history" method="GET" class="filters-grid">
      <div class="filter-group">
        <label class="form-label" for="filterUser">User</label>
        <select id="filterUser" name="id_user" class="form-select">
          <option value="">All Users</option>
          <% users.forEach((user) => { %>
            <option
              value="<%= user.id_user %>"
              <%= String(filters.id_user) === String(user.id_user) ? 'selected' : '' %>
            >
              <%= user.full_name %>
            </option>
          <% }); %>
        </select>
      </div>

      <div class="filter-group">
        <label class="form-label" for="filterProject">Project</label>
        <select id="filterProject" name="id_project" class="form-select">
          <option value="">All Projects</option>
          <% projects.forEach((project) => { %>
            <option
              value="<%= project.id_project %>"
              <%= String(filters.id_project) === String(project.id_project) ? 'selected' : '' %>
            >
              <%= project.project_name %>
            </option>
          <% }); %>
        </select>
      </div>

      <div class="filter-group">
        <label class="form-label" for="filterTeam">Team</label>
        <select id="filterTeam" name="id_team" class="form-select">
          <option value="">All Teams</option>
          <% teams.forEach((team) => { %>
            <option
              value="<%= team.id_team %>"
              <%= String(filters.id_team) === String(team.id_team) ? 'selected' : '' %>
            >
              <%= team.team_name %>
            </option>
          <% }); %>
        </select>
      </div>

      <div class="filter-group">
        <label class="form-label" for="filterFrom">From</label>
        <input
          type="date"
          id="filterFrom"
          name="date_from"
          class="form-input"
          value="<%= filters.date_from || '' %>"
        />
      </div>

      <div class="filter-group">
        <label class="form-label" for="filterTo">To</label>
        <input
          type="date"
          id="filterTo"
          name="date_to"
          class="form-input"
          value="<%= filters.date_to || '' %>"
        />
      </div>

      <!-- Boton para aplicar filtros -->
      <button class="btn-submit" type="submit">Apply Filters</button>
    </form>
  </div>
</div>

