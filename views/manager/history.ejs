<!-- Manager History View -->
<h1 id="pageTitle" class="page-title">Contribution History</h1>

<!-- Advanced Filters -->
<div class="report-card filters-card">
  <div class="report-card-header">
    <h2>Filter History</h2>
  </div>

  <div class="report-card-body">
    <!-- Formulario que manda los filtros por query params -->
    <form action="/manager/history" method="GET" class="filters-grid">
      <div class="filter-group">
        <label class="form-label" for="filterUser">User</label>
        <select id="filterUser" name="id_user" class="form-select">
          <option value="">All Users</option>
          <% users.forEach((user) => { %>
            <option
              value="<%= user.id_user %>"
              <%= String(filters.id_user) === String(user.id_user) ? 'selected' : '' %>
            >
              <%= user.full_name %>
            </option>
          <% }); %>
        </select>
      </div>

      <div class="filter-group">
        <label class="form-label" for="filterProject">Project</label>
        <select id="filterProject" name="id_project" class="form-select">
          <option value="">All Projects</option>
          <% projects.forEach((project) => { %>
            <option
              value="<%= project.id_project %>"
              <%= String(filters.id_project) === String(project.id_project) ? 'selected' : '' %>
            >
              <%= project.project_name %>
            </option>
          <% }); %>
        </select>
      </div>

      <div class="filter-group">
        <label class="form-label" for="filterTeam">Team</label>
        <select id="filterTeam" name="id_team" class="form-select">
          <option value="">All Teams</option>
          <% teams.forEach((team) => { %>
            <option
              value="<%= team.id_team %>"
              <%= String(filters.id_team) === String(team.id_team) ? 'selected' : '' %>
            >
              <%= team.team_name %>
            </option>
          <% }); %>
        </select>
      </div>

      <div class="filter-group">
  <!-- Filtro rapido de fechas predefinidas -->
        <label class="form-label" for="quickDateFilter">Quick Filter</label>
        <select id="quickDateFilter" class="form-select">
          <option value="">Select a filter</option>
          <option value="last_week">Last Week</option>
          <option value="last_month">Last Month</option>
          <option value="q1">Q1 (Jan - Mar)</option>
          <option value="q2">Q2 (Apr - Jun)</option>
          <option value="q3">Q3 (Jul - Sep)</option>
          <option value="q4">Q4 (Oct - Dec)</option>
        </select>
      </div>

      <div class="filter-group">
        <label class="form-label" for="filterFrom">From</label>
        <input
          type="date"
          id="filterFrom"
          name="date_from"
          class="form-input"
          value="<%= filters.date_from || '' %>"
        />
      </div>

      <div class="filter-group">
        <label class="form-label" for="filterTo">To</label>
        <input
          type="date"
          id="filterTo"
          name="date_to"
          class="form-input"
          value="<%= filters.date_to || '' %>"
        />
      </div>

      <!-- Boton para aplicar filtros -->
      <button class="btn-submit" type="submit">Apply Filters</button>
    </form>
  </div>
</div>

<!-- History List -->
<div class="report-card">
  <div class="report-card-header">
    <h2>Activity Log</h2>
    <span class="item-count"><%= totalEntries %> entr<%= totalEntries === 1 ? 'y' : 'ies' %></span>
  </div>

  <div class="report-card-body">
    <div class="history-list">

  <% if (logs.length === 0) { %>
    <!-- Mensaje cuando no hay resultados -->
    <p class="empty-text">No contributions found for the selected filters.</p>
  <% } %>

  <% logs.forEach((log) => { %>
    <div class="history-entry">
      
      <!-- Avatar -->
      <img
        class="history-avatar"
        src="https://www.shutterstock.com/image-vector/blank-avatar-photo-place-holder-600nw-1095249842.jpg"
        alt="<%= log.full_name %>"
      />

      <!-- Contenido principal -->
      <div class="history-content">
        <!-- Nombre del usuario -->
        <p class="history-author"><%= log.full_name %></p>

        <!-- Texto del log -->
        <p class="history-text">
          <%= log.completed || '' %>
          <% if (log.planned) { %>
            • Next: <%= log.planned %>
          <% } %>
        </p>
      </div>

      <!-- Meta info -->
      <div class="history-meta">
        <!-- Proyecto -->
        <span class="history-project">
          <%= log.project_name || 'No project' %>
        </span>

        <!-- Fecha -->
        <span class="history-date">
          <%= new Date(log.created_at).toLocaleDateString('en-US', {
            month: 'short',
            day: 'numeric',
            year: 'numeric'
          }) %>
        </span>
      </div>

    </div>
  <% }); %>

</div>

    <!-- Pagination hint -->
    <div class="action-row" style="justify-content: center; margin-top: 24px;">
      <button class="btn-draft" type="button">Load More</button>
    </div>
  </div>
</div> 

<script>
  // Toma los inputs de fechas y el select del filtro rapido
  const quickDateFilter = document.getElementById('quickDateFilter');
  const filterFrom = document.getElementById('filterFrom');
  const filterTo = document.getElementById('filterTo');

  // Convierte una fecha a formato YYYY-MM-DD para usarla en input type="date"
  const formatDateInput = (date) => {
    const year = date.getFullYear();
    const month = String(date.getMonth() + 1).padStart(2, '0');
    const day = String(date.getDate()).padStart(2, '0');

    return `${year}-${month}-${day}`;
  };

  // Calcula el rango segun el filtro rapido elegido
  const applyQuickDateFilter = (value) => {
    const today = new Date();
    let startDate = null;
    let endDate = new Date(today);

    // Semana pasada
    if (value === 'last_week') {
      startDate = new Date(today);
      startDate.setDate(today.getDate() - 7);
    }

    // Mes pasado
    if (value === 'last_month') {
      startDate = new Date(today);
      startDate.setDate(today.getDate() - 30);
    }

    // Trimestres del año actual
    if (value === 'q1') {
      startDate = new Date(today.getFullYear(), 0, 1);
      endDate = new Date(today.getFullYear(), 2, 31);
    }

    if (value === 'q2') {
      startDate = new Date(today.getFullYear(), 3, 1);
      endDate = new Date(today.getFullYear(), 5, 30);
    }

    if (value === 'q3') {
      startDate = new Date(today.getFullYear(), 6, 1);
      endDate = new Date(today.getFullYear(), 8, 30);
    }

    if (value === 'q4') {
      startDate = new Date(today.getFullYear(), 9, 1);
      endDate = new Date(today.getFullYear(), 11, 31);
    }
    if (!startDate) {
      return;
    }

    // Llena los campos From y To
    filterFrom.value = formatDateInput(startDate);
    filterTo.value = formatDateInput(endDate);
  };

  // Aplica el filtro rapido cuando cambia el select
  quickDateFilter.addEventListener('change', () => {
    applyQuickDateFilter(quickDateFilter.value);
  });
</script>