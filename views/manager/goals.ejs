<!-- Manager Goals View -->
<h1 id="pageTitle" class="page-title">Goals</h1>

<!-- Add Goal Card -->
<div class="report-card">
  <div class="report-card-header">
    <h2>Create New Goal</h2>
  </div>

  <div class="report-card-body">
    <div class="form-row-grid">
      <div class="form-field">
        <label class="form-label" for="goalTitle">Goal Title</label>
        <input type="text" id="goalTitle" class="form-input" placeholder="Enter goal title..." />
      </div>

      <div class="form-field">
        <label class="form-label" for="goalProject">Link to Project</label>
        <select id="goalProject" class="form-select">
          <option value="">Select a project...</option>
          <option value="1">Internal Tools</option>
          <option value="2">API Integration</option>
          <option value="3">Dashboard Redesign</option>
        </select>
      </div>
    </div>

    <div class="form-field">
      <label class="form-label" for="goalDesc">Description</label>
      <textarea id="goalDesc" rows="3" placeholder="Describe the goal and expected outcomes..."></textarea>
    </div>

    <div class="form-row-grid">
      <div class="form-field">
        <label class="form-label" for="goalDue">Due Date</label>
        <input type="date" id="goalDue" class="form-input" />
      </div>

      <div class="form-field">
        <label class="form-label" for="goalStatus">Status</label>
        <select id="goalStatus" class="form-select">
          <option value="pending">Pending</option>
          <option value="in-progress">In Progress</option>
          <option value="completed">Completed</option>
        </select>
      </div>
    </div>

    <div class="action-row">
      <button class="btn-draft" type="button">Save as Draft</button>
      <button class="btn-submit" type="button">Create Goal</button>
    </div>
  </div>
</div>

<!-- Goals List -->
<div class="goals-list">
  <% if (goals.length === 0) { %>
    <div class="empty-state">
      <p>No goals have been created yet.</p>
    </div>
  <% } %>

  <% goals.forEach((goal) => { %>
    <div class="goal-card <%= goal.status %>">
      <div class="goal-icon">
        <i class="fa-solid fa-bullseye"></i>
      </div>

      <div class="goal-content">
        <div class="goal-header">
          <h3 class="goal-title">
            <%= goal.title %>
            <% if (goal.is_draft) { %>
              <span class="draft-badge">Draft</span>
            <% } %>
          </h3>

          <span class="goal-status <%= goal.status %>">
            <%= goal.status.charAt(0).toUpperCase() + goal.status.slice(1) %>
          </span>
        </div>

        <p class="goal-desc">
          <%= goal.description || 'No description provided.' %>
        </p>

        <div class="goal-meta">
          <span class="goal-meta-item">
            <i class="fa-solid fa-flag"></i>
            Priority: <%= goal.priority.charAt(0).toUpperCase() + goal.priority.slice(1) %>
          </span>

          <span class="goal-meta-item">
            <i class="fa-solid fa-calendar-days"></i>
            Start:
            <%= goal.start_date ? new Date(goal.start_date).toLocaleDateString('en-US') : 'Not set' %>
          </span>

          <span class="goal-meta-item">
            <i class="fa-solid fa-calendar-check"></i>
            End:
            <%= goal.end_date ? new Date(goal.end_date).toLocaleDateString('en-US') : 'Not set' %>
          </span>
        </div>
      </div>

      <div class="goal-actions">
        <button class="btn-icon" type="button" title="Edit">
          <i class="fa-solid fa-pen"></i>
        </button>
        <button class="btn-icon btn-danger" type="button" title="Delete">
          <i class="fa-solid fa-trash"></i>
        </button>
      </div>
    </div>
  <% }); %>
  </div>
</div>