<!-- Manager Goals View -->
<h1 id="pageTitle" class="page-title">Goals</h1>

<!-- Add Goal Card -->
<div class="report-card">
  <div class="report-card-header">
    <h2>Create New Goal</h2>
  </div>

  <div class="report-card-body">
    <div class="form-row-grid">
      <div class="form-field">
        <label class="form-label" for="goalTitle">Goal Title</label>
        <input type="text" id="goalTitle" class="form-input" placeholder="Enter goal title..." />
      </div>

      <div class="form-field">
        <label class="form-label" for="goalProject">Link to Project</label>
        <select id="goalProject" class="form-select">
          <option value="">Select a project...</option>
          <option value="1">Internal Tools</option>
          <option value="2">API Integration</option>
          <option value="3">Dashboard Redesign</option>
        </select>
      </div>
    </div>

    <div class="form-field">
      <label class="form-label" for="goalDesc">Description</label>
      <textarea id="goalDesc" rows="3" placeholder="Describe the goal and expected outcomes..."></textarea>
    </div>

    <div class="form-row-grid">
      <div class="form-field">
        <label class="form-label" for="goalDue">Due Date</label>
        <input type="date" id="goalDue" class="form-input" />
      </div>

      <div class="form-field">
        <label class="form-label" for="goalStatus">Status</label>
        <select id="goalStatus" class="form-select">
          <option value="pending">Pending</option>
          <option value="in-progress">In Progress</option>
          <option value="completed">Completed</option>
        </select>
      </div>
    </div>

    <div class="action-row">
      <button class="btn-draft" type="button">Save as Draft</button>
      <button class="btn-submit" type="button">Create Goal</button>
    </div>
  </div>
</div>

<!-- Goals List -->
