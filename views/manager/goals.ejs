<meta name="csrf-token" content="<%= csrfToken %>" />
<link rel="stylesheet" href="/css/manager/goals.css" />
<h1 id="pageTitle" class="page-title">Goals</h1>

<div class="goals-tabs">
  <button
    type="button"
    class="goals-tab-button active"
    data-tab-target="manageGoalsPanel"
  >
    Manage Goals
  </button>

  <button
    type="button"
    class="goals-tab-button"
    data-tab-target="goalImpactPanel"
  >
    Goal Impact
  </button>
</div>

<div id="manageGoalsPanel" class="goals-tab-panel active">
  <div class="report-card">
    <div class="report-card-header">
      <h2 id="goalFormTitle">Create New Goal</h2>
    </div>

    <div class="report-card-body">
      <form id="goalForm" class="goal-form">
        <div id="goalFormMessage" class="form-message"></div>

        <div class="form-row-grid">
          <div class="form-field">
            <label class="form-label" for="title">Goal Title</label>
            <input
              type="text"
              id="title"
              name="title"
              class="form-input"
              placeholder="Enter goal title..."
            />
          </div>

          <div class="form-field">
            <label class="form-label" for="priority">Priority</label>
            <select id="priority" name="priority" class="form-select">
              <option value="">Select priority...</option>
              <option value="low">Low</option>
              <option value="medium">Medium</option>
              <option value="high">High</option>
              <option value="critical">Critical</option>
            </select>
          </div>
        </div>

        <div class="form-field">
          <label class="form-label" for="description">Description</label>
          <textarea
            id="description"
            name="description"
            rows="4"
            class="form-textarea"
            placeholder="Describe the goal and expected outcomes..."
          ></textarea>
        </div>

        <div class="form-row-grid">
          <div class="form-field">
            <label class="form-label" for="startDate">Start Date</label>
            <input
              type="date"
              id="startDate"
              name="start_date"
              class="form-input"
            />
          </div>

          <div class="form-field">
            <label class="form-label" for="endDate">End Date</label>
            <input
              type="date"
              id="endDate"
              name="end_date"
              class="form-input"
            />
          </div>
        </div>

        <div class="form-field">
          <label class="form-label" for="status">Status</label>
          <select id="status" name="status" class="form-select">
            <option value="">Select status...</option>
            <option value="active">Active</option>
            <option value="paused">Paused</option>
            <option value="completed">Completed</option>
            <option value="cancelled">Cancelled</option>
          </select>
        </div>

        <div class="action-row">
          <button id="saveDraftButton" class="btn-draft" type="button">
            Save as Draft
          </button>
          <button id="createGoalButton" class="btn-submit" type="button">
            Create Goal
          </button>
        </div>
      </form>
    </div>
  </div>

  <div class="report-card">
    <div class="report-card-header">
      <h2>Goals</h2>
      <span class="item-count"><%= goals.length %> goal<%= goals.length === 1 ? '' : 's' %></span>
    </div>

    <div class="report-card-body">
      <div id="goalsListMessage" class="form-message"></div>

      <div class="goals-list">
        <% if (goals.length === 0) { %>
          <div class="empty-state">
            <p>No goals have been created yet.</p>
          </div>
        <% } %>

        <% goals.forEach((goal) => { %>
          <div class="goal-card <%= goal.status %>">
            <div class="goal-icon">
              <i class="fa-solid fa-bullseye"></i>
            </div>

            <div class="goal-content">
              <div class="goal-header">
                <h3 class="goal-title">
                  <%= goal.title %>
                  <% if (goal.is_draft) { %>
                    <span class="draft-badge">Draft</span>
                  <% } %>
                </h3>

                <span class="goal-status <%= goal.status %>">
                  <%= goal.status.charAt(0).toUpperCase() + goal.status.slice(1) %>
                </span>
              </div>

              <p class="goal-desc">
                <%= goal.description || 'No description provided.' %>
              </p>

              <div class="goal-meta">
                <span class="goal-meta-item">
                  <i class="fa-solid fa-flag"></i>
                  Priority:
                  <%= goal.priority ? goal.priority.charAt(0).toUpperCase() + goal.priority.slice(1) : 'Not set' %>
                </span>

                <span class="goal-meta-item">
                  <i class="fa-solid fa-calendar-days"></i>
                  Start:
                  <%= goal.start_date ? new Date(goal.start_date).toLocaleDateString('en-US') : 'Not set' %>
                </span>

                <span class="goal-meta-item">
                  <i class="fa-solid fa-calendar-check"></i>
                  End:
                  <%= goal.end_date ? new Date(goal.end_date).toLocaleDateString('en-US') : 'Not set' %>
                </span>
              </div>
            </div>

            <div class="goal-linked-projects linked-projects-area">
              <span class="goal-meta-item">
                <i class="fa-solid fa-diagram-project"></i>
                Linked Projects:
              </span>

              <% if (goal.linkedProjects && goal.linkedProjects.length > 0) { %>
                <div class="linked-project-tags">
                  <% goal.linkedProjects.forEach((project) => { %>
                    <span class="linked-project-tag">
                      <span class="linked-project-name"><%= project.project_name %></span>
                    </span>
                  <% }); %>
                </div>
              <% } else { %>
                <p class="no-linked-projects">No linked projects yet.</p>
              <% } %>
            </div>

            <div class="goal-actions">
              <div class="goal-secondary-actions">
                <button
                  class="btn-icon edit-goal-button"
                  type="button"
                  title="Edit"
                  data-goal-id="<%= goal.id_goal %>"
                >
                  <i class="fa-solid fa-pen"></i>
                </button>

                <button
                  class="btn-icon btn-danger delete-goal-button"
                  type="button"
                  title="Delete"
                  data-goal-id="<%= goal.id_goal %>"
                >
                  <i class="fa-solid fa-trash"></i>
                </button>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    </div>
  </div>
</div>

<div id="goalImpactPanel" class="goals-tab-panel">
  <div class="report-card">
    <div class="report-card-header">
      <h2>Goal Impact</h2>
      <span class="item-count">
        <%= createdGoals.length %> created goal<%= createdGoals.length === 1 ? '' : 's' %>
      </span>
    </div>

    <div class="report-card-body">
      <p class="goal-impact-intro">
        Select a created goal to view its base impact structure. Draft goals are not shown here.
      </p>

      <div class="goal-impact-layout">
        <div class="goal-impact-list">
          <% if (createdGoals.length === 0) { %>
            <div class="empty-state">
              <p>No created goals are available for impact view.</p>
            </div>
          <% } %>

          <% createdGoals.forEach((goal) => { %>
            <button
              type="button"
              class="impact-goal-item"
              data-impact-goal-id="<%= goal.id_goal %>"
              data-impact-goal-title="<%= goal.title %>"
              data-impact-goal-description="<%= goal.description || 'No description provided.' %>"
              data-impact-goal-status="<%= goal.status %>"
              data-impact-goal-priority="<%= goal.priority || 'Not set' %>"
              data-impact-goal-start="<%= goal.start_date ? new Date(goal.start_date).toLocaleDateString('en-US') : 'Not set' %>"
              data-impact-goal-end="<%= goal.end_date ? new Date(goal.end_date).toLocaleDateString('en-US') : 'Not set' %>"
              data-impact-projects='<%- JSON.stringify((goalImpactMap && goalImpactMap[goal.id_goal] && goalImpactMap[goal.id_goal].projects) || []) %>'
              data-impact-teams='<%- JSON.stringify((goalImpactMap && goalImpactMap[goal.id_goal] && goalImpactMap[goal.id_goal].teams) || []) %>'
              data-impact-logs='<%- JSON.stringify((goalImpactMap && goalImpactMap[goal.id_goal] && goalImpactMap[goal.id_goal].logs) || []) %>'
              data-impact-highlights='<%- JSON.stringify((goalImpactMap && goalImpactMap[goal.id_goal] && goalImpactMap[goal.id_goal].highlights) || []) %>'
            >
              <div class="impact-goal-item-top">
                <span class="impact-goal-title"><%= goal.title %></span>
                <span class="goal-status <%= goal.status %>">
                  <%= goal.status.charAt(0).toUpperCase() + goal.status.slice(1) %>
                </span>
              </div>

              <div class="impact-goal-item-meta">
                <span>
                  <i class="fa-solid fa-flag"></i>
                  <%= goal.priority ? goal.priority.charAt(0).toUpperCase() + goal.priority.slice(1) : 'Not set' %>
                </span>
                <span>
                  <i class="fa-solid fa-calendar-days"></i>
                  <%= goal.start_date ? new Date(goal.start_date).toLocaleDateString('en-US') : 'Not set' %>
                </span>
                <span>
                  <i class="fa-solid fa-calendar-check"></i>
                  <%= goal.end_date ? new Date(goal.end_date).toLocaleDateString('en-US') : 'Not set' %>
                </span>
              </div>
            </button>
          <% }); %>
        </div>

        <div class="goal-impact-preview report-card-inner">
          <div id="impactEmptyState" class="goal-impact-empty">
            <i class="fa-solid fa-chart-line"></i>
            <h3>Select a goal</h3>
            <p>
              Choose one created goal from the left side to prepare its impact summary view.
            </p>
          </div>

          <div id="impactGoalDetails" class="goal-impact-details hidden">
            <div class="goal-impact-details-header">
              <h3 id="impactGoalTitle">Goal title</h3>
              <span id="impactGoalStatus" class="goal-status active">Active</span>
            </div>

            <p id="impactGoalDescription" class="goal-impact-description">
              Goal description
            </p>

            <div class="goal-impact-meta-grid">
              <div class="goal-impact-meta-card">
                <span class="goal-impact-meta-label">Priority</span>
                <strong id="impactGoalPriority">Medium</strong>
              </div>

              <div class="goal-impact-meta-card">
                <span class="goal-impact-meta-label">Start Date</span>
                <strong id="impactGoalStart">Not set</strong>
              </div>

              <div class="goal-impact-meta-card">
                <span class="goal-impact-meta-label">End Date</span>
                <strong id="impactGoalEnd">Not set</strong>
              </div>

              <div class="goal-impact-meta-card">
                <span class="goal-impact-meta-label">Current Stage</span>
                <strong>Base structure ready</strong>
              </div>
            </div>

            <div class="goal-impact-data-section">


              <div class="goal-impact-data-block">
                <h4>Linked Projects</h4>
                <div id="impactProjectsList" class="goal-impact-tags-wrap">
                  <p class="goal-impact-empty-text">No linked projects found.</p>
                </div>
              </div>

              <div class="goal-impact-data-block">
                <h4>Participating Teams</h4>
                <div id="impactTeamsList" class="goal-impact-tags-wrap">
                  <p class="goal-impact-empty-text">No participating teams found.</p>
                </div>
              </div>

              <div class="goal-impact-data-block">
                <h4>Related Highlights</h4>
                <div id="impactHighlightsList" class="goal-impact-highlights-wrap">
                  <p class="goal-impact-empty-text">No related highlights found.</p>
                </div>
              </div>

              <div class="goal-impact-data-block">
                <div class="goal-impact-section-header">
                  <h4>Contributions / Logs</h4>
                  <span class="goal-impact-section-hint">Recent activity</span>
                </div>

                <div id="impactLogsList" class="goal-impact-logs-wrap compact">
                  <p class="goal-impact-empty-text">No contributions found.</p>
                </div>
              </div>
            </div>


            <div class="goal-impact-summary-section">
                <div id="impactSummaryEmpty" class="goal-impact-summary-empty">
                  <h4>AI Goal Impact Summary</h4>
                  <p>Generate a summary to see the executive overview for this goal.</p>
                </div>

              <div id="impactSummaryContent" class="goal-impact-summary-content hidden">
                <div class="goal-impact-summary-header">
                  <h4>AI Goal Impact Summary</h4>
                  <span class="goal-impact-summary-badge">Executive View</span>
                </div>

              <div class="goal-impact-summary-hero">
                <h5>Overall Impact</h5>
                <p id="impactSummaryOverall">—</p>
              </div>

            <div class="goal-impact-summary-grid">
              <div class="goal-impact-summary-block">
                <h5>Projects Driving This Goal</h5>
                <ul id="impactSummaryProjects" class="goal-impact-summary-list"></ul>
              </div>

              <div class="goal-impact-summary-block">
                <h5>Team Participation</h5>
                <p id="impactSummaryTeamParticipation">—</p>
              </div>

            <div class="goal-impact-summary-block">
              <h5>Key Contributions</h5>
              <ul id="impactSummaryContributions" class="goal-impact-summary-list"></ul>
            </div>

            <div class="goal-impact-summary-block">
              <h5>Relevant Highlights</h5>
              <ul id="impactSummaryHighlights" class="goal-impact-summary-list"></ul>
            </div>

            <div class="goal-impact-summary-block">
              <h5>Risks / Gaps</h5>
              <ul id="impactSummaryRisks" class="goal-impact-summary-list"></ul>
            </div>

            <div class="goal-impact-summary-block">
              <h5>Recommendations</h5>
              <ul id="impactSummaryRecommendations" class="goal-impact-summary-list"></ul>
            </div>
    </div>
  </div>
</div>       

           

            <div class="goal-impact-placeholder-actions">
              <button type="button" id="generateSummaryBtn" class="btn-draft">
                Generate Summary
              </button>

              <button type="button" id="exportGoalPdfBtn" class="btn-submit">
                  Export PDF
                </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Edit Goal Modal -->
<div class="modal-overlay" id="editGoalModal">
  <div class="modal">
    <div class="modal-header">
      <h2>Edit Goal</h2>
      <button class="modal-close" type="button" id="closeEditGoalModalBtn">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>

    <div id="editGoalFormMessage" class="form-message" style="margin-bottom:12px;"></div>

    <div class="form-row-grid">
      <div class="form-field">
        <label class="form-label">Goal Title</label>
        <input type="text" id="editTitle" class="form-input" placeholder="Enter goal title..." />
      </div>
      <div class="form-field">
        <label class="form-label">Priority</label>
        <select id="editPriority" class="form-select">
          <option value="">Select priority...</option>
          <option value="low">Low</option>
          <option value="medium">Medium</option>
          <option value="high">High</option>
          <option value="critical">Critical</option>
        </select>
      </div>
    </div>

    <div class="form-field">
      <label class="form-label">Description</label>
      <textarea id="editDescription" rows="4" class="form-textarea" placeholder="Describe the goal and expected outcomes..."></textarea>
    </div>

    <div class="form-row-grid">
      <div class="form-field">
        <label class="form-label">Start Date</label>
        <input type="date" id="editStartDate" class="form-input" />
      </div>
      <div class="form-field">
        <label class="form-label">End Date</label>
        <input type="date" id="editEndDate" class="form-input" />
      </div>
    </div>

    <div class="form-field">
      <label class="form-label">Status</label>
      <select id="editStatus" class="form-select">
        <option value="">Select status...</option>
        <option value="active">Active</option>
        <option value="paused">Paused</option>
        <option value="completed">Completed</option>
        <option value="cancelled">Cancelled</option>
      </select>
    </div>

    <hr style="border:none; border-top:1px solid #e5e7eb; margin:20px 0 16px;" />

    <div class="form-field">
      <label class="form-label">Linked Projects</label>
      <div id="editLinkedProjects" style="display:flex; flex-wrap:wrap; gap:8px; min-height:30px; align-items:center; margin-top:6px;">
        <p id="editNoLinkedMsg" style="margin:0; color:#9ca3af; font-size:0.88rem;">No linked projects.</p>
      </div>
    </div>

    <div class="form-field" style="margin-top:12px;">
      <label class="form-label">Add Projects</label>
      <div id="editProjectCheckboxes" style="display:flex; flex-direction:column; gap:4px; max-height:130px; overflow-y:auto; border:1px solid #e5e7eb; border-radius:8px; padding:8px; background:#fafafa; margin-top:6px;">
        <p id="editNoAvailableMsg" style="margin:0; color:#9ca3af; font-size:0.88rem;">All projects already linked.</p>
      </div>
      <button type="button" id="editLinkProjectsBtn" class="btn-draft" style="margin-top:8px; width:100%;">
        <i class="fa-solid fa-link"></i> Link Selected
      </button>
    </div>

    <div class="action-row" style="justify-content:flex-end; gap:12px; margin-top:16px;">
      <button type="button" id="cancelEditGoalModalBtn" class="btn-draft">Cancel</button>
      <button type="button" id="saveEditGoalBtn" class="btn-submit">Save Changes</button>
    </div>
  </div>
</div>

<div id="deleteGoalModal" class="custom-modal hidden">
  <div class="custom-modal-backdrop"></div>

  <div class="custom-modal-content">
    <h3>Delete goal</h3>
    <p>Are you sure you want to delete this goal?</p>

    <div class="modal-actions">
      <button id="cancelDeleteBtn" class="btn-secondary" type="button">
        Cancel
      </button>
      <button id="confirmDeleteBtn" class="btn-danger" type="button">
        Delete
      </button>
    </div>
  </div>
</div>
<script src="/js/manager/goals.js"></script>