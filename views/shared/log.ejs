<h1 id="pageTitle" class="page-title">My Activity Log</h1>

<% if (typeof successMessage !== 'undefined' && successMessage) { %>
  <div id="toastSuccess" class="toast-notification success">
    <i class="fa-solid fa-circle-check"></i> <%= successMessage %>
  </div>
  <script>
    setTimeout(() => {
      const t = document.getElementById('toastSuccess');
      if (t) {
        t.style.opacity = '0';
        setTimeout(() => t.remove(), 300);
      }
    }, 3000);
  </script>
<% } %>

<!-- Daily Report Form -->
<div class="report-card">
  <div class="report-card-header">
    <h2>Today's Report</h2>
    <span class="report-date"><%= new Date().toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' }) %></span>
  </div>

  <div class="report-card-body">
    <form action="<%= logBase %>/log" method="POST" id="logForm">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <div class="form-row-grid">
        <div class="form-field">
          <label class="form-label" for="completedInput">Completed (one per line)</label>
          <textarea
            id="completedInput"
            name="completed"
            rows="4"
            placeholder="Completed homepage redesign&#10;Fixed responsive issues"
            required
          ></textarea>
        </div>

        <div class="form-field">
          <label class="form-label" for="plannedInput">Planned for tomorrow (one per line)</label>
          <textarea
            id="plannedInput"
            name="planned"
            rows="4"
            placeholder="Write unit tests for signup form&#10;Review and merge PR #42"
            required
          ></textarea>
        </div>
      </div>

      <div class="form-row-grid">
        <div class="form-field">
          <label class="form-label" for="blockerInput">Blockers</label>
          <textarea
            id="blockerInput"
            name="blocker"
            rows="2"
            placeholder="Describe any blockers..."
          ></textarea>
        </div>

        <div class="form-field">
          <label class="form-label">Projects</label>
          <div id="projectSelects">
            <div class="project-select-row">
              <select name="id_projects" class="form-select project-select" required>
                <option value="">Select project...</option>
                <% for (let project of projects) { %>
                  <option value="<%= project.id_project %>"><%= project.project_name %></option>
                <% } %>
              </select>
            </div>
          </div>
        </div>
      </div>

      <div class="action-row">
        <button class="btn-submit" type="submit">Submit Report</button>
      </div>
    </form>
  </div>
</div>

<!-- Entry History -->
<div class="report-card">
  <div class="report-card-header">
    <h2>Entry History</h2>
  </div>

  <div class="report-card-body">
    <form action="<%= logBase %>/log" method="GET">
      <div class="filter-row">
        <div class="filter-group">
          <label class="form-label" for="logQuickFilter">Quick Filters</label>
          <select id="logQuickFilter" class="form-select">
            <option value="">Select a filter</option>
            <option value="LAST_WEEK">Last Week</option>
            <option value="LAST_MONTH">Last Month</option>
            <option value="Q1">Q1 (Jan - Mar)</option>
            <option value="Q2">Q2 (Apr - Jun)</option>
            <option value="Q3">Q3 (Jul - Sep)</option>
            <option value="Q4">Q4 (Oct - Dec)</option>
          </select>
        </div>

        <div class="filter-group">
          <label class="form-label" for="filterProject">Project</label>
          <select id="filterProject" name="id_project" class="form-select">
            <option value="">All Projects</option>
            <% for (let project of projects) { %>
              <option value="<%= project.id_project %>" <%= filters.id_project == project.id_project ? 'selected' : '' %>>
                <%= project.project_name %>
              </option>
            <% } %>
          </select>
        </div>

        <div class="filter-group">
          <label class="form-label" for="filterDateFrom">From</label>
          <input type="date" id="filterDateFrom" name="date_from" class="form-input" value="<%= filters.date_from || '' %>" />
        </div>

        <div class="filter-group">
          <label class="form-label" for="filterDateTo">To</label>
          <input type="date" id="filterDateTo" name="date_to" class="form-input" value="<%= filters.date_to || '' %>" />
        </div>

        <button class="btn-submit btn-filter-submit" type="submit">
          <i class="fa-solid fa-filter"></i> Filter
        </button>
      </div>
    </form>
  </div>
</div>

<!-- Entries List -->
<div class="entries-list">
  <% if (logs.length > 0) { %>
    <% for (let log of logs) { %>
      <div class="entry-card">
        <div class="entry-card-header">
          <div class="entry-meta">
            <span class="entry-project-tag"><i class="fa-solid fa-folder-open"></i> <%= log.project_names %></span>
            <span class="entry-project-tag blue"><i class="fa-solid fa-users"></i> <%= log.team_names %></span>
          </div>
          <div class="entry-actions">
            <span class="entry-date"><%= new Date(log.created_at).toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' }) %></span>
            <div style="display: flex; gap: 6px;">
              <button class="btn-icon" type="button" title="Edit" onclick="openEditModal(<%= JSON.stringify(log) %>)">
                <i class="fa-solid fa-pen"></i>
              </button>
              <button class="btn-icon btn-danger" type="button" title="Delete" onclick="openDeleteModal(<%= log.id_log %>)">
                <i class="fa-solid fa-trash"></i>
              </button>
            </div>
          </div>
        </div>
        <div class="entry-card-body">
          <div class="entry-row completed">
            <span class="entry-label">Completed</span>
            <p><%= log.completed %></p>
          </div>
          <div class="entry-row planned">
            <span class="entry-label">Planned</span>
            <p><%= log.planned %></p>
          </div>
          <% if (log.blockers.length > 0) { %>
            <% for (let blocker of log.blockers) { %>
              <div class="entry-row has-blocker">
                <span class="entry-label">Blocker</span>
                <p>
                  <%= blocker.description %>
                  <span class="tag <%= blocker.resolution_status === 'resolved' ? 'tag-resolved' : 'tag-pending' %>">
                    <%= blocker.resolution_status %>
                  </span>
                </p>
              </div>
            <% } %>
          <% } else { %>
            <div class="entry-row">
              <span class="entry-label">Blockers</span>
              <p class="no-blocker">None</p>
            </div>
          <% } %>
        </div>
      </div>
    <% } %>
  <% } else { %>
    <p>No log entries yet.</p>
  <% } %>

  <!-- Pagination -->
  <% if (totalPages > 1) { %>
    <div class="pagination-footer" style="display: flex; justify-content: space-between; align-items: center; margin-top: 24px; padding: 16px; background: #fff; border-radius: 12px; border: 1px solid #e1e4e8;">
      <a href="?page=<%= page - 1 %>&id_project=<%= filters.id_project || '' %>&date_from=<%= filters.date_from || '' %>&date_to=<%= filters.date_to || '' %>" 
         class="btn-draft" <%= !hasPrevPage ? 'style="pointer-events: none; opacity: 0.5;"' : '' %>>
        <i class="fa-solid fa-chevron-left"></i> Previous
      </a>
      <span style="color: #5f6b85; font-size: 14px; font-weight: 500;">Page <%= page %> of <%= totalPages %></span>
      <a href="?page=<%= page + 1 %>&id_project=<%= filters.id_project || '' %>&date_from=<%= filters.date_from || '' %>&date_to=<%= filters.date_to || '' %>" 
         class="btn-draft" <%= !hasNextPage ? 'style="pointer-events: none; opacity: 0.5;"' : '' %>>
        Next <i class="fa-solid fa-chevron-right"></i>
      </a>
    </div>
  <% } %>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal-overlay" id="deleteModal">
  <div class="modal" style="max-width: 400px; text-align: center;">
    <div class="modal-header" style="justify-content: center; border: none;">
      <h2>Delete Entry</h2>
    </div>
    <p style="color: var(--text-secondary); font-size: 14px;">Are you sure you want to delete this entry? This action cannot be undone.</p>
    <form action="<%= logBase %>/log/delete" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <input type="hidden" name="id_log" id="deleteIdLog" />
      <div class="action-row" style="justify-content: center; gap: 16px; margin-top: 16px;">
        <button type="button" class="btn-draft" onclick="closeDeleteModal()">Cancel</button>
        <button type="submit" class="btn-submit" style="background: #dc2626;">Delete</button>
      </div>
    </form>
  </div>
</div>

<!-- Edit Modal -->
<div class="modal-overlay" id="editModal">
  <div class="modal">
    <div class="modal-header">
      <h2>Edit Log Entry</h2>
      <button class="modal-close" type="button" onclick="closeEditModal()">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>

    <form action="<%= logBase %>/log/edit" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <input type="hidden" name="id_log" id="editIdLog" />

      <div class="form-field">
        <label class="form-label">Completed</label>
        <textarea name="completed" id="editCompleted" rows="3" required></textarea>
      </div>

      <div class="form-field">
        <label class="form-label">Planned</label>
        <textarea name="planned" id="editPlanned" rows="3" required></textarea>
      </div>

      <div class="form-field">
        <label class="form-label">Projects</label>
        <div id="editProjectSelects"></div>
      </div>

      <div class="form-field">
        <label class="form-label">Blocker</label>
        <textarea name="blocker" id="editBlocker" rows="2" placeholder="Describe any blockers..."></textarea>
        <input type="hidden" name="blocker_id" id="editBlockerId" />
      </div>

      <div class="form-field">
        <label class="form-label">Blocker Status</label>
        <select name="blocker_status" id="editBlockerStatus" class="form-select">
          <option value="">Select status...</option>
          <option value="pending">Pending</option>
          <option value="resolved">Resolved</option>
        </select>
      </div>

      <div class="action-row" style="justify-content: center; gap: 16px;">
        <button type="button" class="btn-draft" onclick="closeEditModal()">Cancel</button>
        <button type="submit" class="btn-submit">Save Changes</button>
      </div>
    </form>
  </div>
</div>

<script>
  setTimeout(() => {
    const success = document.getElementById('toastSuccess');
    const error = document.getElementById('toastError');

    if (success) {
      success.style.opacity = '0';
      setTimeout(() => success.remove(), 300);
    }

    if (error) {
      error.style.opacity = '0';
      setTimeout(() => error.remove(), 300);
    }
  }, 3000);
</script>