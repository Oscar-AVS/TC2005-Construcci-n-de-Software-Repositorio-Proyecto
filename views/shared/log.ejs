<h1 id="pageTitle" class="page-title">My Activity Log</h1>

<!-- Daily Report Form -->
<div class="report-card">
  <div class="report-card-header">
    <h2>Today's Report</h2>
    <span class="report-date"><%= new Date().toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' }) %></span>
  </div>

  <div class="report-card-body">
    <form action="/employee/log" method="POST" id="logForm">
      <div class="form-row-grid">
        <div class="form-field">
          <label class="form-label" for="completedInput">Completed (one per line)</label>
          <textarea
            id="completedInput"
            name="completed"
            rows="4"
            placeholder="Completed homepage redesign&#10;Fixed responsive issues"
            required
          ></textarea>
        </div>

        <div class="form-field">
          <label class="form-label" for="plannedInput">Planned for tomorrow (one per line)</label>
          <textarea
            id="plannedInput"
            name="planned"
            rows="4"
            placeholder="Write unit tests for signup form&#10;Review and merge PR #42"
            required
          ></textarea>
        </div>
      </div>

      <div class="form-row-grid">
        <div class="form-field">
          <label class="form-label" for="blockerInput">Blockers</label>
          <textarea
            id="blockerInput"
            name="blocker"
            rows="2"
            placeholder="Describe any blockers..."
          ></textarea>
        </div>

        <div class="form-field">
          <label class="form-label">Projects</label>
          <div id="projectSelects">
            <div class="project-select-row">
              <select name="id_projects" class="form-select project-select">
                <option value="">Select project...</option>
                <% for (let project of projects) { %>
                  <option value="<%= project.id_project %>"><%= project.project_name %></option>
                <% } %>
              </select>
            </div>
          </div>
        </div>
      </div>

      <div class="action-row">
        <button class="btn-submit" type="submit">Submit Report</button>
      </div>
    </form>
  </div>
</div>

<!-- Entry History -->
<div class="report-card">
  <div class="report-card-header">
    <h2>Entry History</h2>
  </div>

  <div class="report-card-body">
    <form action="/employee/log" method="GET">
      <div class="filter-row">
        <div class="filter-group">
          <label class="form-label" for="filterProject">Project</label>
          <select id="filterProject" name="id_project" class="form-select">
            <option value="">All Projects</option>
            <% for (let project of projects) { %>
              <option value="<%= project.id_project %>" <%= filters.id_project == project.id_project ? 'selected' : '' %>>
                <%= project.project_name %>
              </option>
            <% } %>
          </select>
        </div>

        <div class="filter-group">
          <label class="form-label" for="filterDateFrom">From</label>
          <input type="date" id="filterDateFrom" name="date_from" class="form-input" value="<%= filters.date_from || '' %>" />
        </div>

        <div class="filter-group">
          <label class="form-label" for="filterDateTo">To</label>
          <input type="date" id="filterDateTo" name="date_to" class="form-input" value="<%= filters.date_to || '' %>" />
        </div>

        <button class="btn-submit" type="submit">Filter</button>
      </div>
    </form>
  </div>
</div>

<!-- Entries List -->
<div class="entries-list">
  <% if (logs.length > 0) { %>
    <% for (let log of logs) { %>
      <div class="entry-card">
        <div class="entry-card-header">
          <div class="entry-meta">
            <span class="entry-project-tag"><%= log.project_names %></span>
            <span class="entry-project-tag blue"><%= log.team_names %></span>
          </div>
          <div class="entry-actions">
            <span class="entry-date"><%= new Date(log.created_at).toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' }) %></span>
            <div style="display: flex; gap: 6px;">
              <button class="btn-icon" type="button" title="Edit" onclick="openEditModal(<%= JSON.stringify(log) %>)">
                <i class="fa-solid fa-pen"></i>
              </button>
              <button class="btn-icon btn-danger" type="button" title="Delete" onclick="openDeleteModal(<%= log.id_log %>)">
                <i class="fa-solid fa-trash"></i>
              </button>
            </div>
          </div>
        </div>
        <div class="entry-card-body">
          <div class="entry-row completed">
            <span class="entry-label">Completed</span>
            <p><%= log.completed %></p>
          </div>
          <div class="entry-row planned">
            <span class="entry-label">Planned</span>
            <p><%= log.planned %></p>
          </div>
          <% if (log.blockers.length > 0) { %>
            <% for (let blocker of log.blockers) { %>
              <div class="entry-row has-blocker">
                <span class="entry-label">Blocker</span>
                <p>
                  <%= blocker.description %>
                  <span class="tag <%= blocker.resolution_status === 'resolved' ? 'tag-resolved' : 'tag-pending' %>">
                    <%= blocker.resolution_status %>
                  </span>
                </p>
              </div>
            <% } %>
          <% } else { %>
            <div class="entry-row">
              <span class="entry-label">Blockers</span>
              <p class="no-blocker">None</p>
            </div>
          <% } %>
        </div>
      </div>
    <% } %>
  <% } else { %>
    <p>No log entries yet.</p>
  <% } %>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal-overlay" id="deleteModal">
  <div class="modal" style="max-width: 400px; text-align: center;">
    <div class="modal-header" style="justify-content: center; border: none;">
      <h2>Delete Entry</h2>
    </div>
    <p style="color: var(--text-secondary); font-size: 14px;">Are you sure you want to delete this entry? This action cannot be undone.</p>
    <form action="/employee/log/delete" method="POST">
      <input type="hidden" name="id_log" id="deleteIdLog" />
      <div class="action-row" style="justify-content: center; gap: 16px; margin-top: 16px;">
        <button type="button" class="btn-draft" onclick="closeDeleteModal()">Cancel</button>
        <button type="submit" class="btn-submit" style="background: #dc2626;">Delete</button>
      </div>
    </form>
  </div>
</div>

<!-- Edit Modal -->
<div class="modal-overlay" id="editModal">
  <div class="modal">
    <div class="modal-header">
      <h2>Edit Log Entry</h2>
      <button class="modal-close" type="button" onclick="closeEditModal()">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>

    <form action="/employee/log/edit" method="POST">
      <input type="hidden" name="id_log" id="editIdLog" />

      <div class="form-field">
        <label class="form-label">Completed</label>
        <textarea name="completed" id="editCompleted" rows="3" required></textarea>
      </div>

      <div class="form-field">
        <label class="form-label">Planned</label>
        <textarea name="planned" id="editPlanned" rows="3" required></textarea>
      </div>

      <div class="form-field">
        <label class="form-label">Projects</label>
        <div id="editProjectSelects"></div>
      </div>

      <div class="form-field">
        <label class="form-label">Blocker</label>
        <textarea name="blocker" id="editBlocker" rows="2" placeholder="Describe any blockers..."></textarea>
        <input type="hidden" name="blocker_id" id="editBlockerId" />
      </div>

      <div class="form-field">
        <label class="form-label">Blocker Status</label>
        <select name="blocker_status" id="editBlockerStatus" class="form-select">
          <option value="">Select status...</option>
          <option value="pending">Pending</option>
          <option value="resolved">Resolved</option>
        </select>
      </div>

      <div class="action-row" style="justify-content: center; gap: 16px;">
        <button type="button" class="btn-draft" onclick="closeEditModal()">Cancel</button>
        <button type="submit" class="btn-submit">Save Changes</button>
      </div>
    </form>
  </div>
</div>

<script>
  const allProjects = [
    <% for (let project of projects) { %>
      { id: '<%= project.id_project %>', name: '<%= project.project_name %>' },
    <% } %>
  ];

  const container = document.getElementById('projectSelects');

  function getSelectedIds() {
    return Array.from(container.querySelectorAll('.project-select'))
      .map((s) => s.value)
      .filter((v) => v !== '');
  }

  function rebuildSelects() {
    const selectedIds = getSelectedIds();
    const rows = container.querySelectorAll('.project-select-row');

    rows.forEach((row, index) => {
      const select = row.querySelector('.project-select');
      const currentVal = select.value;

      select.innerHTML = '<option value="">Select project...</option>';
      allProjects.forEach((p) => {
        if (p.id === currentVal || !selectedIds.includes(p.id)) {
          const opt = document.createElement('option');
          opt.value = p.id;
          opt.textContent = p.name;
          if (p.id === currentVal) opt.selected = true;
          select.appendChild(opt);
        }
      });

      let removeBtn = row.querySelector('.btn-remove-project');
      if (rows.length > 1) {
        if (!removeBtn) {
          removeBtn = document.createElement('button');
          removeBtn.type = 'button';
          removeBtn.className = 'btn-icon btn-danger btn-remove-project';
          removeBtn.innerHTML = '<i class="fa-solid fa-xmark"></i>';
          removeBtn.addEventListener('click', () => {
            row.remove();
            rebuildSelects();
          });
          row.appendChild(removeBtn);
        }
      } else {
        if (removeBtn) removeBtn.remove();
      }
    });

    const allSelected = selectedIds.length === allProjects.length;
    const lastSelect = container.querySelector('.project-select-row:last-child .project-select');
    const lastHasValue = lastSelect && lastSelect.value !== '';

    if (lastHasValue && !allSelected) {
      addSelectRow();
    }
  }

  function addSelectRow() {
    const selectedIds = getSelectedIds();
    const row = document.createElement('div');
    row.className = 'project-select-row';

    const select = document.createElement('select');
    select.name = 'id_projects';
    select.className = 'form-select project-select';
    select.innerHTML = '<option value="">Select project...</option>';

    allProjects.forEach((p) => {
      if (!selectedIds.includes(p.id)) {
        const opt = document.createElement('option');
        opt.value = p.id;
        opt.textContent = p.name;
        select.appendChild(opt);
      }
    });

    select.addEventListener('change', rebuildSelects);
    row.appendChild(select);
    container.appendChild(row);
    rebuildSelects();
  }

  container.querySelector('.project-select').addEventListener('change', rebuildSelects);

  function openEditModal(log) {
    document.getElementById('editIdLog').value = log.id_log;
    document.getElementById('editCompleted').value = log.completed;
    document.getElementById('editPlanned').value = log.planned;

    if (log.blockers && log.blockers.length > 0) {
      const blocker = log.blockers[0];
      document.getElementById('editBlocker').value = blocker.description;
      document.getElementById('editBlockerId').value = blocker.id_blocker;
      document.getElementById('editBlockerStatus').value = blocker.resolution_status;
    } else {
      document.getElementById('editBlocker').value = '';
      document.getElementById('editBlockerId').value = '';
      document.getElementById('editBlockerStatus').value = '';
    }

    const editContainer = document.getElementById('editProjectSelects');
    editContainer.innerHTML = '';
    const row = document.createElement('div');
    row.className = 'project-select-row';
    const select = document.createElement('select');
    select.name = 'id_projects';
    select.className = 'form-select project-select';
    select.innerHTML = '<option value="">Select project...</option>';
    allProjects.forEach((p) => {
      const opt = document.createElement('option');
      opt.value = p.id;
      opt.textContent = p.name;
      select.appendChild(opt);
    });
    select.addEventListener('change', () => rebuildEditSelects());
    row.appendChild(select);
    editContainer.appendChild(row);
    document.getElementById('editModal').classList.add('active');
  }

  function closeEditModal() {
    document.getElementById('editModal').classList.remove('active');
  }

  document.getElementById('editModal').addEventListener('click', function(e) {
    if (e.target === this) closeEditModal();
  });

  function openDeleteModal(id_log) {
    document.getElementById('deleteIdLog').value = id_log;
    document.getElementById('deleteModal').classList.add('active');
  }

  function closeDeleteModal() {
    document.getElementById('deleteModal').classList.remove('active');
  }

  document.getElementById('deleteModal').addEventListener('click', function(e) {
    if (e.target === this) closeDeleteModal();
  });

  function rebuildEditSelects() {
    const cont = document.getElementById('editProjectSelects');
    const selectedIds = Array.from(cont.querySelectorAll('.project-select'))
      .map((s) => s.value).filter((v) => v !== '');
    const rows = cont.querySelectorAll('.project-select-row');

    rows.forEach((row) => {
      const select = row.querySelector('.project-select');
      const currentVal = select.value;
      select.innerHTML = '<option value="">Select project...</option>';
      allProjects.forEach((p) => {
        if (p.id === currentVal || !selectedIds.includes(p.id)) {
          const opt = document.createElement('option');
          opt.value = p.id;
          opt.textContent = p.name;
          if (p.id === currentVal) opt.selected = true;
          select.appendChild(opt);
        }
      });
      let removeBtn = row.querySelector('.btn-remove-project');
      if (rows.length > 1) {
        if (!removeBtn) {
          removeBtn = document.createElement('button');
          removeBtn.type = 'button';
          removeBtn.className = 'btn-icon btn-danger btn-remove-project';
          removeBtn.innerHTML = '<i class="fa-solid fa-xmark"></i>';
          removeBtn.addEventListener('click', () => { row.remove(); rebuildEditSelects(); });
          row.appendChild(removeBtn);
        }
      } else {
        if (removeBtn) removeBtn.remove();
      }
    });

    const allSelected = selectedIds.length === allProjects.length;
    const lastSelect = cont.querySelector('.project-select-row:last-child .project-select');
    if (lastSelect && lastSelect.value !== '' && !allSelected) {
      const newRow = document.createElement('div');
      newRow.className = 'project-select-row';
      const newSelect = document.createElement('select');
      newSelect.name = 'id_projects';
      newSelect.className = 'form-select project-select';
      newSelect.innerHTML = '<option value="">Select project...</option>';
      allProjects.forEach((p) => {
        if (!selectedIds.includes(p.id)) {
          const opt = document.createElement('option');
          opt.value = p.id;
          opt.textContent = p.name;
          newSelect.appendChild(opt);
        }
      });
      newSelect.addEventListener('change', () => rebuildEditSelects());
      newRow.appendChild(newSelect);
      cont.appendChild(newRow);
    }
  }
</script>