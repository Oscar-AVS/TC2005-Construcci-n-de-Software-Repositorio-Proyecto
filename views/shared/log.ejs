<h1 id="pageTitle" class="page-title">My Activity Log</h1>

<% if (typeof successMessage !== 'undefined' && successMessage) { %>
  <div id="toastSuccess" class="toast-notification">
    <i class="fa-solid fa-circle-check"></i> <%= successMessage %>
  </div>
<% } %>

<% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
  <div id="toastError" class="toast-notification error">
    <i class="fa-solid fa-circle-exclamation"></i> <%= errorMessage %>
  </div>
<% } %>

<style>
  .toast-notification {
    background: #10b981;
    color: white;
    padding: 12px 24px;
    border-radius: 8px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 24px;
    font-weight: 500;
    transition: opacity 0.3s ease;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    animation: slideDown 0.3s ease-out forwards;
  }

  .toast-notification.error {
    background: #ef4444;
  }

  @keyframes slideDown {
    from { transform: translateY(-10px); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
  }
</style>

<script>
  setTimeout(() => {
    const success = document.getElementById('toastSuccess');
    const error = document.getElementById('toastError');

    if (success) {
      success.style.opacity = '0';
      setTimeout(() => success.remove(), 300);
    }

    if (error) {
      error.style.opacity = '0';
      setTimeout(() => error.remove(), 300);
    }
  }, 3000);
</script>