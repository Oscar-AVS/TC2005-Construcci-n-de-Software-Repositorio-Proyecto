<h1 id="pageTitle" class="page-title">Self-Review</h1>

<!-- Period Selection -->
<div class="report-card reports-filters-card">
  <div class="report-card-header">
    <h2>Review Period</h2>
  </div>

  <div class="report-card-body">
    <div class="filter-row">
      <div class="filter-group">
        <label class="form-label" for="srQuickFilter">Quick Filters</label>
        <select id="srQuickFilter" class="form-select">
          <option value="">Select a filter</option>
          <option value="LAST_WEEK">Last Week</option>
          <option value="LAST_MONTH">Last Month</option>
          <option value="Q1">Q1 (Jan - Mar)</option>
          <option value="Q2">Q2 (Apr - Jun)</option>
          <option value="Q3">Q3 (Jul - Sep)</option>
          <option value="Q4">Q4 (Oct - Dec)</option>
        </select>
      </div>

      <div class="filter-group">
        <label class="form-label" for="periodFrom">From</label>
        <input type="date" id="periodFrom" class="form-input" />
      </div>

      <div class="filter-group">
        <label class="form-label" for="periodTo">To</label>
        <input type="date" id="periodTo" class="form-input" />
      </div>

      <button class="btn-generate-ai" type="button" onclick="generateSelfReview()">
        <i class="fa-solid fa-sparkles"></i>
        Generate Review
      </button>
    </div>
  </div>
</div>

<!-- AI Summary Card -->
<div class="ai-summary-card" id="aiSummarySection">
  <div class="ai-summary-header">
    <div class="ai-summary-title">
      <i class="fa-solid fa-wand-magic-sparkles"></i>
      <span>AI-Powered Self-Review</span>
    </div>
  </div>

  <div class="ai-summary-body" id="aiSummaryBody">
    <!-- Placeholder -->
    <div class="ai-summary-placeholder" id="aiPlaceholder">
      <i class="fa-solid fa-robot"></i>
      <p>Select a review period and click "Generate Review" to create an AI-powered self-review based on your logs, achievements, and blockers.</p>
    </div>

    <!-- Loading -->
    <div class="ai-summary-placeholder" id="aiLoading" style="display:none;">
      <i class="fa-solid fa-spinner fa-spin"></i>
      <p>Analyzing your data and generating self-review, please wait...</p>
    </div>

    <!-- Error -->
    <div id="reviewError" style="display:none; background: #fee2e2; color: #e74c3c; border: 1px solid #fca5a5; border-radius: 10px; padding: 12px 16px; font-size: 14px;">
      <i class="fa-solid fa-circle-exclamation" style="margin-right: 6px;"></i>
      <span id="reviewErrorText"></span>
    </div>
  </div>
</div>

<!-- Self Review Content (hidden until generated) -->
<div id="reviewContent" style="display: none;">

  <div class="report-card">
    <div class="report-card-header">
      <h2>My Self-Review</h2>
      <span class="item-count" id="reviewPeriodLabel"></span>
    </div>

    <div class="report-card-body">
      <div class="review-grid">

        <!-- Left Column -->
        <div class="review-column">

          <!-- Achievements (from DB) -->
          <div class="review-section">
            <div class="section-header">
              <i class="fa-solid fa-trophy"></i>
              <h3>My Achievements</h3>
            </div>
            <p class="section-hint">Pulled from your registered achievements.</p>
            <ul class="review-achievements" id="achievementsList">
              <li style="color: #9ca3af; font-style: italic;">No achievements in this period.</li>
            </ul>
          </div>

          <!-- What I Worked On (from DB) -->
          <div class="review-section">
            <div class="section-header">
              <i class="fa-solid fa-briefcase"></i>
              <h3>What I Worked On</h3>
            </div>
            <p class="section-hint">Summary of your logged activities.</p>
            <div class="work-breakdown" id="projectBreakdown">
              <p style="color: #9ca3af; font-style: italic;">No log entries in this period.</p>
            </div>
          </div>

        </div>

        <!-- Right Column -->
        <div class="review-column">

          <!-- What I Did Well (AI) -->
          <div class="review-section">
            <div class="section-header">
              <i class="fa-solid fa-thumbs-up"></i>
              <h3>What I Did Well</h3>
            </div>
            <textarea id="doneWell" rows="4" placeholder="AI will generate this section..."></textarea>
          </div>

          <!-- Contributions (AI) -->
          <div class="review-section">
            <div class="section-header">
              <i class="fa-solid fa-hands-helping"></i>
              <h3>My Contributions</h3>
            </div>
            <textarea id="contributions" rows="4" placeholder="AI will generate this section..."></textarea>
          </div>

        </div>

      </div>

      <!-- Full Width Sections (AI) -->
      <div class="review-section full-width">
        <div class="section-header">
          <i class="fa-solid fa-mountain"></i>
          <h3>Challenges I Overcame</h3>
        </div>
        <textarea id="challenges" rows="3" placeholder="AI will generate this section..."></textarea>
      </div>

      <div class="review-section full-width">
        <div class="section-header">
          <i class="fa-solid fa-seedling"></i>
          <h3>Areas for Growth</h3>
        </div>
        <textarea id="growth" rows="3" placeholder="AI will generate this section..."></textarea>
      </div>

      <!-- Action Row: Export left, Submit right -->
      <div class="action-row-split" style="margin-top: 30px;">
        <div class="export-actions">
          <button class="btn-export-large" type="button" onclick="exportPDF()">
            <i class="fa-solid fa-file-pdf"></i> Export to PDF
          </button>
          <button class="btn-draft" type="button" onclick="openClearDraftModal()" style="margin-left: 10px; color: #e74c3c; border-color: #fca5a5;">
            <i class="fa-solid fa-trash-can"></i> Start Fresh
          </button>
        </div>
      </div>

    </div>
  </div>

  <form id="exportPdfForm" method="POST" action="<%= selfReviewBase %>/self-review/export-pdf" target="_blank" style="display: none;">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" id="exportFechaInicio" name="fechaInicio">
    <input type="hidden" id="exportFechaFin" name="fechaFin">
    <input type="hidden" id="exportDoneWell" name="doneWell">
    <input type="hidden" id="exportContributions" name="contributions">
    <input type="hidden" id="exportChallenges" name="challenges">
    <input type="hidden" id="exportGrowth" name="growth">
    <input type="hidden" id="exportAchievements" name="achievements">
    <input type="hidden" id="exportProjects" name="projects">
  </form>

  <!-- Clear Draft Modal -->
  <div id="clearDraftModal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.4); backdrop-filter: blur(4px); z-index: 9999; align-items: center; justify-content: center;">
    <div style="background: #fff; width: min(420px, 90vw); border-radius: 20px; padding: 32px; box-shadow: 0 24px 48px rgba(0,0,0,0.2); text-align: center;">
      <div style="width: 56px; height: 56px; border-radius: 50%; background: #fee2e2; display: flex; align-items: center; justify-content: center; margin: 0 auto 16px; font-size: 24px; color: #e74c3c;">
        <i class="fa-solid fa-trash-can"></i>
      </div>
      <h3 style="margin: 0 0 8px 0; font-size: 22px; color: #1f2a44;">Start Fresh</h3>
      <p style="color: #5f6b85; margin-bottom: 28px; font-size: 14px; line-height: 1.5;">Are you sure you want to discard this self-review and start fresh? All text will be lost.</p>
      <div style="display: flex; justify-content: center; gap: 12px;">
        <button type="button" onclick="closeClearDraftModal()" style="display: inline-flex; align-items: center; gap: 8px; border: none; background: #f1f5f9; color: #374151; padding: 12px 24px; border-radius: 12px; font-weight: 700; cursor: pointer; font-size: 14px;">
          <i class="fa-solid fa-xmark"></i> Cancel
        </button>
        <button type="button" onclick="executeClearDraft()" style="display: inline-flex; align-items: center; gap: 8px; border: none; background: #e74c3c; color: #fff; padding: 12px 24px; border-radius: 12px; font-weight: 700; cursor: pointer; font-size: 14px;">
          <i class="fa-solid fa-trash-can"></i> Discard
        </button>
      </div>
    </div>
  </div>

</div>

<script>
  async function generateSelfReview() {
    const fechaInicio = document.getElementById('periodFrom').value;
    const fechaFin = document.getElementById('periodTo').value;

    const errorDiv = document.getElementById('reviewError');
    const errorText = document.getElementById('reviewErrorText');
    errorDiv.style.display = 'none';

    if (!fechaInicio || !fechaFin) {
      errorText.textContent = 'Please select a valid period (From and To).';
      errorDiv.style.display = 'block';
      document.getElementById('aiPlaceholder').style.display = 'none';
      return;
    }

    if (fechaInicio > fechaFin) {
      errorText.textContent = 'Start date cannot be later than end date.';
      errorDiv.style.display = 'block';
      document.getElementById('aiPlaceholder').style.display = 'none';
      return;
    }

    // Show loading
    document.getElementById('aiSummarySection').style.display = 'block';
    document.getElementById('aiPlaceholder').style.display = 'none';
    document.getElementById('aiLoading').style.display = 'flex';
    document.getElementById('reviewContent').style.display = 'none';

    try {
      const url = `<%= selfReviewBase %>/self-review/generate?fechaInicio=${fechaInicio}&fechaFin=${fechaFin}`;
      const response = await fetch(url);
      const data = await response.json();

      if (!response.ok) {
        errorText.textContent = data.error || 'Error generating self-review.';
        errorDiv.style.display = 'block';
        document.getElementById('aiLoading').style.display = 'none';
        return;
      }

      // Period label
      document.getElementById('reviewPeriodLabel').textContent = `${fechaInicio} — ${fechaFin}`;

      // Achievements
      const achievementsList = document.getElementById('achievementsList');
      if (data.achievements && data.achievements.length > 0) {
        achievementsList.innerHTML = data.achievements
          .map(a => `<li>${a.description}</li>`)
          .join('');
        document.getElementById('exportAchievements').value = JSON.stringify(data.achievements);
      } else {
        achievementsList.innerHTML = '<li style="color: #9ca3af; font-style: italic;">No achievements in this period.</li>';
        document.getElementById('exportAchievements').value = '[]';
      }

      // Project breakdown
      const projectBreakdown = document.getElementById('projectBreakdown');
      if (data.projectBreakdown && data.projectBreakdown.length > 0) {
        const maxCount = Math.max(...data.projectBreakdown.map(p => p.log_count));
        projectBreakdown.innerHTML = data.projectBreakdown.map(p => {
          const pct = Math.round((p.log_count / maxCount) * 100);
          return `
            <div class="work-item">
              <span class="work-name">${p.project_name}</span>
              <div class="work-bar">
                <div class="work-fill" style="width: ${pct}%;"></div>
              </div>
              <span class="work-count">${p.log_count} entries</span>
            </div>
          `;
        }).join('');
        document.getElementById('exportProjects').value = JSON.stringify(data.projectBreakdown);
      } else {
        projectBreakdown.innerHTML = '<p style="color: #9ca3af; font-style: italic;">No log entries in this period.</p>';
        document.getElementById('exportProjects').value = '[]';
      }

      // AI sections
      document.getElementById('doneWell').value = data.ai.whatIDidWell || '';
      document.getElementById('contributions').value = data.ai.myContributions || '';
      document.getElementById('challenges').value = data.ai.challengesOvercome || '';
      document.getElementById('growth').value = data.ai.areasForGrowth || '';

      // Hide AI placeholder section
      document.getElementById('aiSummarySection').style.display = 'none';
      document.getElementById('aiLoading').style.display = 'none';
      document.getElementById('reviewContent').style.display = 'block';

      // Save to localStorage automatically
      saveDraft();

    } catch (err) {
      console.error('Error generating self-review:', err);
      errorText.textContent = 'Unexpected error. Please try again.';
      errorDiv.style.display = 'block';
      document.getElementById('aiSummarySection').style.display = 'block';
      document.getElementById('aiLoading').style.display = 'none';
    }
  }

  function saveDraft() {
    const draft = {
      fechaInicio: document.getElementById('periodFrom').value,
      fechaFin: document.getElementById('periodTo').value,
      achievementsHtml: document.getElementById('achievementsList').innerHTML,
      projectBreakdownHtml: document.getElementById('projectBreakdown').innerHTML,
      doneWell: document.getElementById('doneWell').value,
      contributions: document.getElementById('contributions').value,
      challenges: document.getElementById('challenges').value,
      growth: document.getElementById('growth').value,
      rawAchievements: document.getElementById('exportAchievements').value,
      rawProjects: document.getElementById('exportProjects').value
    };
    localStorage.setItem('selfReview_draft', JSON.stringify(draft));
  }

  function loadDraft() {
    const draftStr = localStorage.getItem('selfReview_draft');
    if (draftStr) {
      try {
        const draft = JSON.parse(draftStr);
        document.getElementById('periodFrom').value = draft.fechaInicio;
        document.getElementById('periodTo').value = draft.fechaFin;
        document.getElementById('reviewPeriodLabel').textContent = `${draft.fechaInicio} — ${draft.fechaFin}`;
        
        document.getElementById('achievementsList').innerHTML = draft.achievementsHtml;
        document.getElementById('projectBreakdown').innerHTML = draft.projectBreakdownHtml;
        
        document.getElementById('doneWell').value = draft.doneWell;
        document.getElementById('contributions').value = draft.contributions;
        document.getElementById('challenges').value = draft.challenges;
        document.getElementById('growth').value = draft.growth;

        document.getElementById('exportAchievements').value = draft.rawAchievements || '[]';
        document.getElementById('exportProjects').value = draft.rawProjects || '[]';

        document.getElementById('aiSummarySection').style.display = 'none';
        document.getElementById('reviewContent').style.display = 'block';
      } catch (e) {
        console.error('Failed to parse draft.');
      }
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    const textareas = ['doneWell', 'contributions', 'challenges', 'growth'];
    textareas.forEach(id => {
      document.getElementById(id).addEventListener('input', saveDraft);
    });

    loadDraft();

    const srQuickFilter = document.getElementById('srQuickFilter');
    const periodFrom = document.getElementById('periodFrom');
    const periodTo = document.getElementById('periodTo');

    const quickFilterMap = {
      LAST_WEEK: 'lastWeek',
      LAST_MONTH: 'lastMonth',
      Q1: 'q1', Q2: 'q2', Q3: 'q3', Q4: 'q4'
    };

    srQuickFilter.addEventListener('change', () => {
      const mapped = quickFilterMap[srQuickFilter.value];
      if (mapped) setDates(mapped);
    });

    periodFrom.addEventListener('change', () => { srQuickFilter.value = ''; });
    periodTo.addEventListener('change', () => { srQuickFilter.value = ''; });
  });

  function openClearDraftModal() {
    document.getElementById('clearDraftModal').style.display = 'flex';
  }

  function closeClearDraftModal() {
    document.getElementById('clearDraftModal').style.display = 'none';
  }

  function executeClearDraft() {
    // Close modal
    closeClearDraftModal();
    
    // Clear localStorage
    localStorage.removeItem('selfReview_draft');
    
    // Reset inputs
    document.getElementById('periodFrom').value = '';
    document.getElementById('periodTo').value = '';
    document.getElementById('doneWell').value = '';
    document.getElementById('contributions').value = '';
    document.getElementById('challenges').value = '';
    document.getElementById('growth').value = '';
    
    // Toggle UI back to starting state
    document.getElementById('reviewContent').style.display = 'none';
    document.getElementById('aiSummarySection').style.display = 'block';
    document.getElementById('aiPlaceholder').style.display = 'flex';
  }

  function exportPDF() {
    const fechaInicio = document.getElementById('periodFrom').value;
    const fechaFin = document.getElementById('periodTo').value;

    if (!fechaInicio || !fechaFin) {
      alert('Please select a valid period.');
      return;
    }

    // Populate hidden form
    document.getElementById('exportFechaInicio').value = fechaInicio;
    document.getElementById('exportFechaFin').value = fechaFin;
    document.getElementById('exportDoneWell').value = document.getElementById('doneWell').value;
    document.getElementById('exportContributions').value = document.getElementById('contributions').value;
    document.getElementById('exportChallenges').value = document.getElementById('challenges').value;
    document.getElementById('exportGrowth').value = document.getElementById('growth').value;

    // Submit form to open PDF in new tab
    document.getElementById('exportPdfForm').submit();
  }

  function setDates(shortcut) {
    const today = new Date();
    let fromDate, toDate;
    const year = today.getFullYear();

    const formatDate = (date) => {
      return date.toISOString().split('T')[0];
    };

    switch(shortcut) {
      case 'lastWeek':
        toDate = new Date(today);
        fromDate = new Date(today);
        fromDate.setDate(today.getDate() - 7);
        break;
      case 'lastMonth':
        toDate = new Date(today);
        fromDate = new Date(today);
        fromDate.setMonth(today.getMonth() - 1);
        break;
      case 'q1':
        fromDate = new Date(year, 0, 1);
        toDate = new Date(year, 2, 31);
        break;
      case 'q2':
        fromDate = new Date(year, 3, 1);
        toDate = new Date(year, 5, 30);
        break;
      case 'q3':
        fromDate = new Date(year, 6, 1);
        toDate = new Date(year, 8, 30);
        break;
      case 'q4':
        fromDate = new Date(year, 9, 1);
        toDate = new Date(year, 11, 31);
        break;
    }

    if (fromDate && toDate) {
      document.getElementById('periodFrom').value = formatDate(fromDate);
      document.getElementById('periodTo').value = formatDate(toDate);
    }
  }
</script>