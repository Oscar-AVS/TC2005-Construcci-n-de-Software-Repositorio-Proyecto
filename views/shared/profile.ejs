<h1 id="pageTitle" class="page-title">My Profile</h1>

<div class="profile-container">

  <div class="report-card profile-card">
    <div class="profile-header">
      <div class="profile-avatar-wrapper">
        <div style="width: 80px; height: 80px; border-radius: 50%; background: #e74c3c; display: flex; align-items: center; justify-content: center; color: #fff; font-weight: 700; font-size: 32px; margin: 0 auto;">
          <%= user.full_name.charAt(0).toUpperCase() %>
        </div>
      </div>
      <h2 class="profile-name"><%= user.full_name %></h2>
      <p class="profile-role"><%= role.charAt(0).toUpperCase() + role.slice(1).replace(/-/g, ' ') %></p>
    </div>
  </div>

  <% if (typeof error !== 'undefined' && error) { %>
    <div style="background: #fee2e2; color: #e74c3c; border: 1px solid #fca5a5; border-radius: 10px; padding: 12px 16px; font-size: 14px; margin-bottom: 16px;">
      <i class="fa-solid fa-circle-exclamation" style="margin-right: 6px;"></i><%= error %>
    </div>
  <% } %>

  <% if (typeof success !== 'undefined' && success) { %>
    <div style="background: #dcfce7; color: #166534; border: 1px solid #bbf7d0; border-radius: 10px; padding: 12px 16px; font-size: 14px; margin-bottom: 16px;">
      <i class="fa-solid fa-circle-check" style="margin-right: 6px;"></i><%= success %>
    </div>
  <% } %>

  <div class="profile-settings">

    <div class="report-card">
      <div class="report-card-header">
        <div class="header-with-icon">
          <i class="fa-brands fa-slack"></i>
          <h2>Slack Integration</h2>
        </div>
      </div>
      <div class="report-card-body">
        <p class="field-hint">Connect your Slack account to sync activity log entries automatically.</p>
        <form action="/<%= role %>/profile/slack" method="POST" id="slackForm">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <div class="form-field">
            <label class="form-label" for="slackUsername">Slack Username</label>
            <div class="input-with-icon">
              <span class="input-icon">@</span>
              <input
                type="text"
                id="slackUsername"
                name="slack_user"
                class="form-input with-icon"
                placeholder="username"
                value="<%= user.slack_user || '' %>"
              />
            </div>
          </div>
          <div class="action-row">
            <% if (user.slack_user) { %>
              <button class="btn-submit" type="button" onclick="openSlackModal()">Save Changes</button>
            <% } else { %>
              <button class="btn-submit" type="submit">Save Changes</button>
            <% } %>
          </div>
        </form>
      </div>
    </div>

    <div class="report-card">
      <div class="report-card-header">
        <div class="header-with-icon">
          <i class="fa-solid fa-envelope"></i>
          <h2>Email Address</h2>
        </div>
      </div>
      <div class="report-card-body">
        <div class="form-field">
          <label class="form-label" for="email">Email</label>
          <input
            type="email"
            id="email"
            class="form-input disabled"
            value="<%= user.email %>"
            disabled
          />
          <p class="field-hint">Contact your administrator to change your email.</p>
        </div>
      </div>
    </div>

    <div class="report-card full-width">
      <div class="report-card-header">
        <div class="header-with-icon">
          <i class="fa-solid fa-lock"></i>
          <h2>Change Password</h2>
        </div>
      </div>
      <div class="report-card-body">
        <form action="/<%= role %>/profile/password" method="POST">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <div class="password-grid">
            <div class="form-field">
              <label class="form-label" for="currentPassword">Current Password</label>
              <input type="password" id="currentPassword" name="current_password" class="form-input" placeholder="••••••••" required />
            </div>
            <div class="form-field">
              <label class="form-label" for="newPassword">New Password</label>
              <input type="password" id="newPassword" name="new_password" class="form-input" placeholder="••••••••" required />
            </div>
            <div class="form-field">
              <label class="form-label" for="confirmPassword">Confirm Password</label>
              <input type="password" id="confirmPassword" name="confirm_password" class="form-input" placeholder="••••••••" required />
            </div>
          </div>
          <div class="action-row">
            <button class="btn-submit" type="submit">Update Password</button>
          </div>
        </form>
      </div>
    </div>

  </div>

</div>

<!-- Slack Confirm Modal -->
<% if (user.slack_user) { %>
<div id="slackModal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.4); backdrop-filter: blur(4px); z-index: 9999; align-items: center; justify-content: center;">
  <div style="background: #fff; width: min(420px, 90vw); border-radius: 20px; padding: 32px; box-shadow: 0 24px 48px rgba(0,0,0,0.2); text-align: center;">
    <div style="width: 56px; height: 56px; border-radius: 50%; background: #fff7ed; display: flex; align-items: center; justify-content: center; margin: 0 auto 16px; font-size: 24px; color: #f25c2a;">
      <i class="fa-brands fa-slack"></i>
    </div>
    <h3 style="margin: 0 0 8px 0; font-size: 22px; color: #1f2a44;">Update Slack Username</h3>
    <p style="color: #5f6b85; margin-bottom: 28px; font-size: 14px; line-height: 1.5;">
      Your current Slack username is <strong style="color: #1f2a44;">@<%= user.slack_user %></strong>. Are you sure you want to update it?
    </p>
    <div style="display: flex; justify-content: center; gap: 12px;">
      <button type="button" onclick="closeSlackModal()" style="display: inline-flex; align-items: center; gap: 8px; border: none; background: #f1f5f9; color: #374151; padding: 12px 24px; border-radius: 12px; font-weight: 700; cursor: pointer; font-size: 14px;">
        <i class="fa-solid fa-xmark"></i> Cancel
      </button>
      <button type="button" onclick="document.getElementById('slackForm').submit()" style="display: inline-flex; align-items: center; gap: 8px; border: none; background: #f25c2a; color: #fff; padding: 12px 24px; border-radius: 12px; font-weight: 700; cursor: pointer; font-size: 14px;">
        <i class="fa-solid fa-check"></i> Update
      </button>
    </div>
  </div>
</div>

<script>
  function openSlackModal() {
    document.getElementById('slackModal').style.display = 'flex';
  }
  function closeSlackModal() {
    document.getElementById('slackModal').style.display = 'none';
  }
  document.getElementById('slackModal').addEventListener('click', (e) => {
    if (e.target === document.getElementById('slackModal')) closeSlackModal();
  });
</script>
<% } %>