<h1 id="pageTitle" class="page-title">Projects</h1>

<% if (success) { %>
 <div class="alert alert-success">
   <i class="fa-solid fa-circle-check"></i> <%= success %>
 </div>
<% } %>
<% if (error) { %>
 <div class="alert alert-error">
   <i class="fa-solid fa-circle-exclamation"></i> <%= error %>
 </div>
<% } %>

<!-- Caso 4.5: Project status chart -->
<!-- Project status summary -->
<div class="report-card" style="border: none; box-shadow: 0 4px 20px rgba(0,0,0,0.06); border-radius: 16px; overflow: hidden; margin-bottom: 24px;">
  <div class="report-card-header" style="background: #fff; border-bottom: 1px solid #f1f3f7; padding: 18px 22px;">
    <h2 style="font-size: 16px; font-weight: 700; color: #1f2a44; margin: 0;">
      Project Status Distribution
    </h2>
  </div>

  <div class="report-card-body" style="padding: 20px 22px; display: grid; grid-template-columns: 240px 1fr; gap: 24px; align-items: start;">
    <div style="height: 190px; max-width: 240px; position: relative;">
      <canvas id="projectStatusChart"></canvas>
    </div>

    <div style="max-height: 210px; overflow-y: auto; padding-right: 8px;">
      <% const groupedProjects = {
        not_started: [],
        in_progress: [],
        on_hold: [],
        at_risk: [],
        completed: [],
        archived: []
      }; %>

      <% projects.forEach(p => {
        if (groupedProjects[p.progress_status]) {
          groupedProjects[p.progress_status].push(p);
        }
      }); %>

      <% const projectStatusLabels = {
        not_started: 'Not Started',
        in_progress: 'In Progress',
        on_hold: 'On Hold',
        at_risk: 'At Risk',
        completed: 'Completed',
        archived: 'Archived'
      }; %>

      <% Object.keys(groupedProjects).forEach(status => { %>
        <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 10px 12px; margin-bottom: 10px;">
          <h4 style="font-size: 12px; font-weight: 800; color: #1f2a44; margin: 0 0 6px;">
            <%= projectStatusLabels[status] %> (<%= groupedProjects[status].length %>)
          </h4>

          <% if (groupedProjects[status].length === 0) { %>
            <p style="font-size: 11px; color: #94a3b8; margin: 0;">No projects</p>
          <% } else { %>
            <ul style="list-style: none; padding: 0; margin: 0;">
              <% groupedProjects[status].forEach(p => { %>
                <li style="font-size: 11px; color: #334155; margin-bottom: 4px;">
                  • <%= p.project_name %>
                </li>
              <% }) %>
            </ul>
          <% } %>
        </div>
      <% }) %>
    </div>
  </div>
</div>

<!-- Action Bar -->
<div class="action-bar">
  <div class="search-box">
    <i class="fa-solid fa-search"></i>
    <input type="text" placeholder="Search projects..." class="search-input" id="searchInput" />
  </div>
  <div class="action-buttons">
    <select class="form-select filter-select" id="statusFilter">
      <option value="">All Status</option>
      <option value="not_started">Not Started</option>
      <option value="in_progress">In Progress</option>
      <option value="on_hold">On Hold</option>
      <option value="at_risk">At Risk</option>
      <option value="completed">Completed</option>
      <option value="archived">Archived</option>
    </select>
    <button class="btn-submit" type="button" id="btnNewProject">
      <i class="fa-solid fa-plus"></i> New Project
    </button>
  </div>
 </div>
 
 <!-- Projects Grid -->
 <div class="projects-grid" id="projectsGrid">
  <% if (projects.length === 0) { %>
    <p style="color: var(--text-secondary); padding: 1rem 0;">No hay proyectos registrados aún.</p>
  <% } %>

  <% projects.forEach(project => { %>
    <div class="project-card" style="display:none;"
      data-status="<%= project.progress_status %>"
      data-name="<%= project.project_name.toLowerCase() %>">
 
      <div class="project-card-header">
        <div class="project-card-status <%= project.progress_status %>"><%= project.progress_status.replace(/_/g, ' ').replace(/\b\w/g, l => l.toUpperCase()) %></div>
        <div class="project-card-actions">
          <button class="btn-icon btn-delete-project" title="Delete"
            data-id="<%= project.id_project %>"
            data-name="<%= project.project_name %>">
            <i class="fa-solid fa-trash"></i>
          </button>
        </div>
      </div>
 
      <h3 class="project-card-title"><%= project.project_name %></h3>
      <p class="project-card-desc"><%= project.description || 'Sin descripción.' %></p>
 
      <div class="project-card-dates">
        <div class="date-item">
          <i class="fa-solid fa-calendar-plus"></i>
          <span>Started: <%= project.start_date
            ? new Date(project.start_date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
            : '—' %></span>
        </div>
        <div class="date-item">
          <i class="fa-solid fa-calendar-check"></i>
          <span>Due: <%= project.end_date
            ? new Date(project.end_date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
            : '—' %></span>
        </div>
      </div>
 
      <% if (project.team_name) { %>
        <div class="project-card-team">
          <span class="team-label"><i class="fa-solid fa-users"></i> <%= project.team_name %></span>
        </div>
      <% } %>
 
      <a href="/project-manager/project/<%= project.id_project %>" class="project-card-link">
        View Details <i class="fa-solid fa-arrow-right"></i>
      </a>
    </div>
  <% }) %>
 </div>

<div id="paginationBar" style="display:none; align-items:center; justify-content:center; gap:12px; margin-top:24px; flex-wrap:wrap;">
  <button id="pgPrev" class="btn-draft" type="button" style="padding:8px 18px; display:flex; align-items:center; gap:6px;">
    <i class="fa-solid fa-chevron-left"></i> Prev
  </button>
  <span id="pgInfo" style="font-size:14px; color:var(--text-secondary); font-weight:500;"></span>
  <button id="pgNext" class="btn-draft" type="button" style="padding:8px 18px; display:flex; align-items:center; gap:6px;">
    Next <i class="fa-solid fa-chevron-right"></i>
  </button>
</div>

 <!-- MODAL: Caso 4.1 — Alta de proyecto -->
<div class="modal-overlay" id="modalCreateProject">
  <div class="modal">
    <div class="modal-header">
      <h2>New Project</h2>
      <button class="modal-close" type="button" id="btnCloseCreate">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>
 
    <form action="/project-manager/projects/create" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
 
      <div class="form-field">
        <label class="form-label" for="newProjectName">Project Name *</label>
        <input type="text" id="newProjectName" name="project_name"
          class="form-input" placeholder="e.g. Platform Redesign"
          required maxlength="150" />
      </div>
 
      <div class="form-field">
        <label class="form-label" for="newProjectDesc">Description</label>
        <textarea id="newProjectDesc" name="description"
          rows="3" maxlength="500"
          placeholder="What is this project about?"></textarea>
      </div>
 
      <div class="form-field">
        <label class="form-label" for="newProjectStatus">Status</label>
        <select id="newProjectStatus" name="progress_status" class="form-select">
          <option value="not_started">Not Started</option>
          <option value="in_progress">In Progress</option>
          <option value="on_hold">On Hold</option>
          <option value="at_risk">At Risk</option>
          <option value="completed">Completed</option>
          <option value="archived">Archived</option>
        </select>
      </div>
 
      <div class="form-row-grid">
        <div class="form-field">
          <label class="form-label" for="newStartDate">Start Date</label>
          <input type="date" id="newStartDate" name="start_date" class="form-input" />
        </div>
        <div class="form-field">
          <label class="form-label" for="newEndDate">End Date</label>
          <input type="date" id="newEndDate" name="end_date" class="form-input" />
        </div>
      </div>
 
      <div class="action-row" style="justify-content: flex-end; gap: 12px;">
        <button type="button" class="btn-draft" id="btnCancelCreate">Cancel</button>
        <button type="submit" class="btn-submit">
          <i class="fa-solid fa-plus"></i> Register Project
        </button>
      </div>
    </form>
  </div>
 </div>
 
 
 <!-- MODAL: Caso 4.3 — Confirmación eliminación -->
 <div class="modal-overlay" id="modalDeleteProject">
  <div class="modal" style="max-width: 400px; text-align: center;">
    <div class="modal-header" style="justify-content: center; border: none;">
      <h2>Delete Project</h2>
    </div>
    <p style="color: var(--text-secondary); font-size: 14px;">
      Are you sure you want to delete
      <strong id="deleteProjectName" style="color: var(--text-primary); font-weight: 700;"></strong>?
    </p>
    <form id="formDeleteProject" method="POST" action="">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <div class="action-row" style="justify-content: center; gap: 16px; margin-top: 16px;">
        <button type="button" class="btn-draft" id="btnCancelDelete">Cancel</button>
        <button type="submit" class="btn-submit" style="background: #dc2626;">
          <i class="fa-solid fa-trash"></i> Confirm Delete
        </button>
      </div>
    </form>
  </div>
 </div>

 <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

 <script>
  const searchInput  = document.getElementById('searchInput');
  const statusFilter = document.getElementById('statusFilter');
  const statusChartData = <%- JSON.stringify(statusChartData) %>;

  const CARDS_PER_PAGE = 6;
  let currentPage = 1;

  function getFilteredCards() {
    const query  = searchInput.value.toLowerCase().trim();
    const status = statusFilter.value;
    return [...document.querySelectorAll('#projectsGrid .project-card')].filter(card =>
      card.dataset.name.includes(query) && (!status || card.dataset.status === status)
    );
  }

  function renderPagination(current, total) {
    const bar = document.getElementById('paginationBar');
    if (total <= 1) { bar.style.display = 'none'; return; }
    bar.style.display = 'flex';
    document.getElementById('pgPrev').disabled = current === 1;
    document.getElementById('pgNext').disabled = current === total;
    document.getElementById('pgInfo').textContent = `Page ${current} of ${total}`;
  }

  function applyPage() {
    const filtered = getFilteredCards();
    const total = Math.ceil(filtered.length / CARDS_PER_PAGE) || 1;
    if (currentPage > total) currentPage = 1;

    document.querySelectorAll('#projectsGrid .project-card')
      .forEach(c => c.style.display = 'none');

    const start = (currentPage - 1) * CARDS_PER_PAGE;
    filtered.slice(start, start + CARDS_PER_PAGE)
      .forEach(c => c.style.display = '');

    renderPagination(currentPage, total);
  }

  // Gráfica del Caso 4.5: muestra cuántos proyectos existen por estado de avance
  document.addEventListener('DOMContentLoaded', () => {
  const chartCanvas = document.getElementById('projectStatusChart');

  if (chartCanvas && window.Chart) {
    new Chart(chartCanvas, {
      type: 'doughnut',
      data: {
        labels: statusChartData.map(item => item.label),
        datasets: [{
          data: statusChartData.map(item => item.total),
          backgroundColor: [
            '#1e3a8a',
            '#1d4ed8',
            '#2563eb',
            '#3b82f6',
            '#60a5fa',
            '#93c5fd'
          ],
          borderWidth: 2,
          borderColor: '#ffffff'
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: {
            position: 'bottom'
          }
        }
      }
    });
  }
});

  searchInput.addEventListener('input',  () => { currentPage = 1; applyPage(); });
  statusFilter.addEventListener('change', () => { currentPage = 1; applyPage(); });

  document.getElementById('pgPrev').addEventListener('click', () => {
    if (currentPage > 1) { currentPage--; applyPage(); }
  });
  document.getElementById('pgNext').addEventListener('click', () => {
    const total = Math.ceil(getFilteredCards().length / CARDS_PER_PAGE) || 1;
    if (currentPage < total) { currentPage++; applyPage(); }
  });

  applyPage();
 
  // Modal helpers — igual que en log.ejs
  function openModal(modal)  { modal.classList.add('active'); }
  function closeModal(modal) { modal.classList.remove('active'); }
 
  document.querySelectorAll('.modal-overlay').forEach(overlay => {
    overlay.addEventListener('click', function(e) {
      if (e.target === this) closeModal(this);
    });
  });
 
  // Modal Alta (4.1)
  const modalCreate = document.getElementById('modalCreateProject');
  document.getElementById('btnNewProject').addEventListener('click', () => openModal(modalCreate));
  document.getElementById('btnCloseCreate').addEventListener('click', () => closeModal(modalCreate));
  document.getElementById('btnCancelCreate').addEventListener('click', () => closeModal(modalCreate));
 
  // Modal Eliminar (4.3)
  const modalDelete     = document.getElementById('modalDeleteProject');
  const formDelete      = document.getElementById('formDeleteProject');
  const deleteNameLabel = document.getElementById('deleteProjectName');
 
  document.querySelectorAll('.btn-delete-project').forEach(btn => {
    btn.addEventListener('click', () => {
      deleteNameLabel.textContent = btn.dataset.name;
      formDelete.action = `/project-manager/projects/${btn.dataset.id}/delete`;
      openModal(modalDelete);
    });
  });
  document.getElementById('btnCancelDelete').addEventListener('click', () => closeModal(modalDelete));
 
  // Auto-dismiss alerts
  document.querySelectorAll('.alert').forEach(el => {
    setTimeout(() => el.style.display = 'none', 4000);
  });

  // Validación de fechas en frontend
const newStartDate = document.getElementById('newStartDate');
const newEndDate = document.getElementById('newEndDate');

if (newStartDate && newEndDate) {
  newStartDate.addEventListener('change', () => {
    newEndDate.min = newStartDate.value;
  });
}
 </script>

