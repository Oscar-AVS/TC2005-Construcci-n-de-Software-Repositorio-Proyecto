<h1 id="pageTitle" class="page-title">Projects</h1>

<!-- Action Bar -->
<div class="action-bar">
  <div class="search-box">
    <i class="fa-solid fa-search"></i>
    <input type="text" placeholder="Search projects..." class="search-input" />
  </div>

  <div class="action-buttons">
    <select class="form-select filter-select">
      <option value="">All Status</option>
      <option value="active">Active</option>
      <option value="on-hold">On Hold</option>
      <option value="completed">Completed</option>
    </select>
    <button class="btn-submit" type="button">
      <i class="fa-solid fa-plus"></i> New Project
    </button>
  </div>
</div>

<!-- Projects Grid -->
<div class="projects-grid">
  <!-- Project Card 1 -->
  <div class="project-card">
    <div class="project-card-header">
      <div class="project-card-status active">Active</div>
      <div class="project-card-actions">
        <button class="btn-icon" title="Edit">
          <i class="fa-solid fa-pen"></i>
        </button>
        <button class="btn-icon" title="More">
          <i class="fa-solid fa-ellipsis-vertical"></i>
        </button>
      </div>
    </div>

    <h3 class="project-card-title">Internal Tools</h3>
    <p class="project-card-desc">Building internal productivity tools for the engineering team including dashboards and automation scripts.</p>

    <div class="project-card-dates">
      <div class="date-item">
        <i class="fa-solid fa-calendar-plus"></i>
        <span>Started: Feb 15, 2026</span>
      </div>
      <div class="date-item">
        <i class="fa-solid fa-calendar-check"></i>
        <span>Due: Mar 30, 2026</span>
      </div>
    </div>

    <div class="project-card-team">
      <div class="team-avatars">
        <img src="https://www.shutterstock.com/image-vector/blank-avatar-photo-place-holder-600nw-1095249842.jpg" alt="Member" title="Francisco Arreola" />
        <img src="https://www.shutterstock.com/image-vector/blank-avatar-photo-place-holder-600nw-1095249842.jpg" alt="Member" title="Lakshmi Martinez" />
        <img src="https://www.shutterstock.com/image-vector/blank-avatar-photo-place-holder-600nw-1095249842.jpg" alt="Member" title="Oscar Vilchis" />
        <img src="https://www.shutterstock.com/image-vector/blank-avatar-photo-place-holder-600nw-1095249842.jpg" alt="Member" title="Víctor Esquivel" />
      </div>
      <span class="team-label">Mufasa Solutions</span>
    </div>

    <a href="/project-manager/project/1" class="project-card-link">
      View Details <i class="fa-solid fa-arrow-right"></i>
    </a>
  </div>

  <!-- Project Card 2 -->
  <div class="project-card">
    <div class="project-card-header">
      <div class="project-card-status on-hold">On Hold</div>
      <div class="project-card-actions">
        <button class="btn-icon" title="Edit">
          <i class="fa-solid fa-pen"></i>
        </button>
        <button class="btn-icon" title="More">
          <i class="fa-solid fa-ellipsis-vertical"></i>
        </button>
      </div>
    </div>

    <h3 class="project-card-title">API Integration</h3>
    <p class="project-card-desc">Integrating third-party APIs for payment processing and user authentication services.</p>

    <div class="project-card-dates">
      <div class="date-item">
        <i class="fa-solid fa-calendar-plus"></i>
        <span>Started: Mar 1, 2026</span>
      </div>
      <div class="date-item">
        <i class="fa-solid fa-calendar-check"></i>
        <span>Due: Apr 15, 2026</span>
      </div>
    </div>

    <div class="project-card-team">
      <div class="team-avatars">
        <img src="https://www.shutterstock.com/image-vector/blank-avatar-photo-place-holder-600nw-1095249842.jpg" alt="Member" title="Oscar Vilchis" />
        <img src="https://www.shutterstock.com/image-vector/blank-avatar-photo-place-holder-600nw-1095249842.jpg" alt="Member" title="Víctor Esquivel" />
        <img src="https://www.shutterstock.com/image-vector/blank-avatar-photo-place-holder-600nw-1095249842.jpg" alt="Member" title="Carlos Mendez" />
      </div>
      <span class="team-label">Phoenix Team</span>
    </div>

    <a href="/project-manager/project/2" class="project-card-link">
      View Details <i class="fa-solid fa-arrow-right"></i>
    </a>
  </div>

  <!-- Project Card 3 -->
  <div class="project-card">
    <div class="project-card-header">
      <div class="project-card-status completed">Completed</div>
      <div class="project-card-actions">
        <button class="btn-icon" title="Edit">
          <i class="fa-solid fa-pen"></i>
        </button>
        <button class="btn-icon" title="More">
          <i class="fa-solid fa-ellipsis-vertical"></i>
        </button>
      </div>
    </div>

    <h3 class="project-card-title">Dashboard Redesign</h3>
    <p class="project-card-desc">Complete redesign of the analytics dashboard with improved UX and new visualization components.</p>

    <div class="project-card-dates">
      <div class="date-item">
        <i class="fa-solid fa-calendar-plus"></i>
        <span>Started: Jan 10, 2026</span>
      </div>
      <div class="date-item">
        <i class="fa-solid fa-calendar-check"></i>
        <span>Delivered: Mar 10, 2026</span>
      </div>
    </div>

    <div class="project-card-team">
      <div class="team-avatars">
        <img src="https://www.shutterstock.com/image-vector/blank-avatar-photo-place-holder-600nw-1095249842.jpg" alt="Member" title="Lakshmi Martinez" />
        <img src="https://www.shutterstock.com/image-vector/blank-avatar-photo-place-holder-600nw-1095249842.jpg" alt="Member" title="Sofia Torres" />
        <img src="https://www.shutterstock.com/image-vector/blank-avatar-photo-place-holder-600nw-1095249842.jpg" alt="Member" title="Juan Perez" />
        <span class="avatar-more">+2</span>
      </div>
      <span class="team-label">Delta Squad</span>
    </div>

    <a href="/project-manager/project/3" class="project-card-link">
      View Details <i class="fa-solid fa-arrow-right"></i>
    </a>
  </div>
</div>