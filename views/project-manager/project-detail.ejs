  <div class="modal" style="max-width: 400px; text-align: center; padding: 32px;">
    <div style="width: 64px; height: 64px; background: #fee2e2; color: #ef4444; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 28px; margin: 0 auto 20px;">
      <i class="fa-solid fa-user-xmark"></i>
    </div>
    <h3 style="font-size: 20px; font-weight: 700; color: #1f2a44; margin: 0 0 12px;">Remove Member</h3>
