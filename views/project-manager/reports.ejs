<h1 id="pageTitle" class="page-title">Reports</h1>

<div class="report-card filters-card">
  <div class="report-card-header">
    <h2>Generate Report</h2>
  </div>

  <div class="report-card-body">
    <div class="filters-grid">
      <div class="filter-group">
        <label class="form-label" for="filterProject">Project</label>
        <select id="filterProject" class="form-select">
          <option value="">Select a project</option>
          <% projects.forEach(project => { %>
            <option
              value="<%= project.id_project %>"
              <%= String(filters.id_project) === String(project.id_project) ? 'selected' : '' %>>
              <%= project.project_name %>
            </option>
          <% }) %>
        </select>
      </div>

      <div class="filter-group">
        <label class="form-label" for="filterTeam">Team</label>
        <select id="filterTeam" class="form-select">
          <option value="">Select a team</option>
          <% teams.forEach(team => { %>
            <option
              value="<%= team.id_team %>"
              <%= String(filters.id_team) === String(team.id_team) ? 'selected' : '' %>>
              <%= team.team_name %>
            </option>
          <% }) %>
        </select>
      </div>

      <div class="filter-group">
        <label class="form-label" for="filterFrom">From</label>
        <input
          type="date"
          id="filterFrom"
          class="form-input"
          value="<%= filters.date_from || '' %>" />
      </div>

      <div class="filter-group">
        <label class="form-label" for="filterTo">To</label>
        <input
          type="date"
          id="filterTo"
          class="form-input"
          value="<%= filters.date_to || '' %>" />
      </div>
    </div>

    <div class="action-row" style="justify-content: flex-end; gap: 12px; margin-top: 16px;">
      <button class="btn-submit" type="button" onclick="generateSummary()">
        <i class="fa-solid fa-sparkles"></i> Generate Summary
      </button>

      <button class="btn-export" type="button" onclick="exportPDF()">
        <i class="fa-solid fa-file-pdf"></i> Export PDF
      </button>
    </div>
  </div>
</div>

<div id="reportMessage" class="alert alert-error" style="display:none; margin-bottom: 20px;"></div>

<div
  id="projectTeamRangeBox"
  class="report-card project-range-card"
  style="display: none;"
>
  <div class="report-card-body">
    <p id="projectTeamRangeText" class="project-range-text"></p>
  </div>
</div>

<div class="ai-summary-card">
  <div class="ai-summary-header">
    <div class="ai-summary-title">
      <i class="fa-solid fa-wand-magic-sparkles"></i>
      <span>AI-Powered Summary</span>
    </div>
  </div>

  <div class="ai-summary-body" id="aiSummaryBody">
    <div class="ai-summary-placeholder" id="aiPlaceholder">
      <i class="fa-solid fa-robot"></i>
      <p>Select a project, team, and date range, then click "Generate Summary".</p>
    </div>

    <div class="ai-summary-placeholder" id="aiLoading" style="display:none;">
      <i class="fa-solid fa-spinner fa-spin"></i>
      <p>Generating summary, please wait...</p>
    </div>

    <div id="aiResult" style="display:none;">
      <p id="aiOverall"></p>

      <h4>Highlights</h4>
      <ul id="aiHighlights"></ul>

      <h4>Risks</h4>
      <ul id="aiRisks"></ul>

      <h4>Recommendations</h4>
      <ul id="aiRecommendations"></ul>
    </div>
  </div>
</div>

<script>
  function formatDateForDisplay(dateString) {
    if (!dateString) return 'Not set';

    const date = new Date(dateString);
    if (Number.isNaN(date.getTime())) return 'Not set';

    return date.toLocaleDateString('en-US', {
      month: 'short',
      day: 'numeric',
      year: 'numeric',
    });
  }

  async function loadProjectTeamRange() {
    const projectSelect = document.getElementById('filterProject');
    const teamSelect = document.getElementById('filterTeam');
    const rangeBox = document.getElementById('projectTeamRangeBox');
    const rangeText = document.getElementById('projectTeamRangeText');

    const id_project = projectSelect.value;
    const id_team = teamSelect.value;

    if (!id_project || !id_team) {
      rangeBox.style.display = 'none';
      rangeText.textContent = '';
      return;
    }

    rangeBox.style.display = 'block';
    rangeText.textContent = 'Loading project range...';

    try {
      const params = new URLSearchParams({
        id_project,
        id_team,
      });

      const response = await fetch(`/project-manager/reports/project-team-range?${params.toString()}`);
      const data = await response.json();

      if (!response.ok) {
        throw new Error(data.error || 'Could not load project range.');
      }

      const startDate = formatDateForDisplay(data.project.start_date);
      const endDate = formatDateForDisplay(data.project.end_date);

      rangeText.innerHTML = `
        <strong>${data.team.team_name}</strong> is working on
        <strong>${data.project.project_name}</strong>
        from <span class="range-date">${startDate}</span>
        to <span class="range-date">${endDate}</span>.
      `;
    } catch (err) {
      console.error('Error loading project/team range:', err);
      rangeText.textContent = err.message || 'Could not load project range.';
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    const projectSelect = document.getElementById('filterProject');
    const teamSelect = document.getElementById('filterTeam');

    if (projectSelect) {
      projectSelect.addEventListener('change', loadProjectTeamRange);
    }

    if (teamSelect) {
      teamSelect.addEventListener('change', loadProjectTeamRange);
    }

    if (projectSelect && teamSelect && projectSelect.value && teamSelect.value) {
      loadProjectTeamRange();
    }
  });
</script>

<script>
  function showReportMessage(message, type = 'error') {
    const messageBox = document.getElementById('reportMessage');
    messageBox.innerHTML = `<i class="fa-solid fa-circle-exclamation"></i> ${message}`;
    messageBox.className = type === 'success'
      ? 'alert alert-success'
      : 'alert alert-error';
    messageBox.style.display = 'block';
  }

  function hideReportMessage() {
    const messageBox = document.getElementById('reportMessage');
    messageBox.innerHTML = '';
    messageBox.style.display = 'none';
  }

  function getReportFilters() {
    return {
      idProyecto: document.getElementById('filterProject').value,
      idEquipo: document.getElementById('filterTeam').value,
      fechaInicio: document.getElementById('filterFrom').value,
      fechaFin: document.getElementById('filterTo').value,
    };
  }

  function validateReportFilters() {
    const { idProyecto, idEquipo, fechaInicio, fechaFin } = getReportFilters();

    if (!idProyecto) {
      showReportMessage('Please select a project.');
      return null;
    }

    if (!idEquipo) {
      showReportMessage('Please select a team.');
      return null;
    }

    if (!fechaInicio || !fechaFin) {
      showReportMessage('Please select a valid period (From and To).');
      return null;
    }

    if (fechaInicio > fechaFin) {
      showReportMessage('Start date cannot be later than end date.');
      return null;
    }

    hideReportMessage();
    return { idProyecto, idEquipo, fechaInicio, fechaFin };
  }

  async function generateSummary() {
    const filters = validateReportFilters();
    if (!filters) return;

    document.getElementById('aiPlaceholder').style.display = 'none';
    document.getElementById('aiResult').style.display = 'none';
    document.getElementById('aiLoading').style.display = 'flex';

    try {
      const params = new URLSearchParams({
        idEquipo: filters.idEquipo,
        idProyecto: filters.idProyecto,
        fechaInicio: filters.fechaInicio,
        fechaFin: filters.fechaFin,
      });

      const response = await fetch(`/project-manager/reports/ai-summary?${params.toString()}`);
      const data = await response.json();

      if (!response.ok) {
        throw new Error(data.error || 'Error generating summary.');
      }

      document.getElementById('aiOverall').textContent = data.summary.overallAssessment;

      const highlightsList = document.getElementById('aiHighlights');
      highlightsList.innerHTML = '';
      data.summary.highlights.forEach((item) => {
        const li = document.createElement('li');
        li.textContent = item;
        highlightsList.appendChild(li);
      });

      const risksList = document.getElementById('aiRisks');
      risksList.innerHTML = '';
      data.summary.risks.forEach((item) => {
        const li = document.createElement('li');
        li.textContent = item;
        risksList.appendChild(li);
      });

      const recommendationsList = document.getElementById('aiRecommendations');
      recommendationsList.innerHTML = '';
      data.summary.recommendations.forEach((item) => {
        const li = document.createElement('li');
        li.textContent = item;
        recommendationsList.appendChild(li);
      });

      document.getElementById('aiLoading').style.display = 'none';
      document.getElementById('aiResult').style.display = 'block';
      showReportMessage('AI summary generated successfully.', 'success');
    } catch (err) {
      console.error('Error generating summary:', err);
      document.getElementById('aiLoading').style.display = 'none';
      document.getElementById('aiPlaceholder').style.display = 'flex';
      showReportMessage(err.message || 'Unexpected error. Please try again.');
    }
  }

  function exportPDF() {
    const filters = validateReportFilters();
    if (!filters) return;

    const params = new URLSearchParams({
      idEquipo: filters.idEquipo,
      idProyecto: filters.idProyecto,
      fechaInicio: filters.fechaInicio,
      fechaFin: filters.fechaFin,
    });

    window.open(`/project-manager/reports/export-pdf?${params.toString()}`, '_blank');
  }
</script>