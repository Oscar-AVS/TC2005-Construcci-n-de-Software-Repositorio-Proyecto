<!-- Dashboard Tabs -->
<script>
  window.personalWeeklyData = <%- JSON.stringify(weeklyData) %>;
  window.logsByDay = <%- JSON.stringify(logsByDay) %>;
  window.todayWeekday = <%= new Date().getDay() === 0 ? 6 : new Date().getDay() - 1 %>;
  window.orgWeeklyData = <%- JSON.stringify(orgWeeklyData) %>;
  window.orgLogsByDay = <%- JSON.stringify(orgLogsByDay) %>;
  window.teamsData = <%- JSON.stringify(teams) %>;
</script>

<div class="dashboard-tabs">
  <button type="button" class="dashboard-tab <%= activeTab === 'pm-dashboard' ? 'active' : '' %>" data-tab="pm-dashboard">
    <i class="fa-solid fa-folder-open"></i> PM Dashboard
  </button>
  <button type="button" class="dashboard-tab <%= activeTab === 'activity' ? 'active' : '' %>" data-tab="activity">
    <i class="fa-solid fa-chart-line"></i> Activity
  </button>
</div>

<!-- TAB 1: PM DASHBOARD -->
<div class="tab-content <%= activeTab === 'pm-dashboard' ? 'active' : '' %>" id="tab-pm-dashboard">

  <!-- Stats Row -->
  <div class="pm-stats-row">
    <div class="stat-card">
      <div class="stat-icon stat-icon-blue">
        <i class="fa-solid fa-folder-open"></i>
      </div>
      <div class="stat-info">
        <p class="stat-value"><%= stats.activeProjects %></p>
        <p class="stat-label">Active Projects</p>
      </div>
    </div>

    <div class="stat-card">
      <div class="stat-icon stat-icon-green">
        <i class="fa-solid fa-users"></i>
      </div>
      <div class="stat-info">
        <p class="stat-value"><%= stats.activeUsers %></p>
        <p class="stat-label">Team Members</p>
      </div>
    </div>

    <div class="stat-card">
      <div class="stat-icon stat-icon-yellow">
        <i class="fa-solid fa-triangle-exclamation"></i>
      </div>
      <div class="stat-info">
        <p class="stat-value"><%= stats.activeBlockers %></p>
        <p class="stat-label">Active Blockers</p>
      </div>
    </div>

    <div class="stat-card">
      <div class="stat-icon stat-icon-accent">
        <i class="fa-solid fa-check-circle"></i>
      </div>
      <div class="stat-info">
        <p class="stat-value"><%= stats.completedThisMonth %></p>
        <p class="stat-label">Completed This Month</p>
      </div>
    </div>
  </div>

  <!-- Main Grid -->
  <div class="pm-dashboard-grid">
    <!-- Projects Overview -->
    <div class="report-card">
      <div class="report-card-header">
        <h2>Projects Overview</h2>
        <a href="/project-manager/projects" class="btn-link">View All</a>
      </div>

      <div class="report-card-body">
        <div class="projects-summary">
          <% if (projects.length === 0) { %>
            <p style="color: var(--text-muted); font-size: 14px; padding: 12px;">No active projects.</p>
          <% } else { %>
            <% projects.forEach(project => { %>
              <div class="project-summary-card">
                <div class="project-summary-header">
                  <div class="project-summary-info">
                    <h3 class="project-summary-name"><%= project.project_name %></h3>
                    <span class="project-status <%= project.progress_status %>">
                      <%= project.progress_status.replace(/_/g, ' ').replace(/\b\w/g, l => l.toUpperCase()) %>
                    </span>
                  </div>
                </div>
                <div class="project-summary-meta">
                  <span><i class="fa-solid fa-calendar"></i> Starts: <%= project.start_date ? new Date(project.start_date).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) : 'N/A' %></span>
                </div>
              </div>
            <% }) %>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Active Blockers -->
    <div class="report-card">
      <div class="report-card-header">
        <h2>Active Blockers</h2>
        <span class="item-count"><%= blockers.length %> blocker<%= blockers.length !== 1 ? 's' : '' %></span>
      </div>

      <div class="report-card-body">
        <div class="blockers-list">
          <% if (blockers.length === 0) { %>
            <p style="color: var(--text-muted); font-size: 14px; padding: 12px;">No active blockers.</p>
          <% } else { %>
            <% blockers.forEach(blocker => { %>
              <div class="blocker-item <%= blocker.severity || 'low' %>">
                <div class="blocker-priority">
                  <i class="fa-solid fa-circle-exclamation"></i>
                </div>
                <div class="blocker-content">
                  <p class="blocker-title"><%= blocker.description %></p>
                  <div class="blocker-meta">
                    <span class="blocker-project"><%= blocker.project_name %></span>
                    <span class="blocker-author"><%= blocker.reporter_name %></span>
                    <span class="blocker-date"><%= new Date(blocker.detected_at).toLocaleDateString('en-US', { day: 'numeric', month: 'short' }) %></span>
                  </div>
                </div>
              </div>
            <% }) %>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <!-- Recent Activity -->
  <div class="report-card">
    <div class="report-card-header">
      <h2>Recent Activity</h2>
    </div>

    <div class="report-card-body">
      <div class="activity-timeline">
        <% if (globalActivity.length === 0) { %>
          <p style="color: var(--text-muted); font-size: 14px; padding: 12px;">No recent activity.</p>
        <% } else { %>
          <% globalActivity.forEach(act => { %>
            <div class="activity-item">
              <div class="activity-icon blue">
                <i class="fa-solid fa-pencil"></i>
              </div>
              <div class="activity-content">
                <p class="activity-text"><strong><%= act.full_name %></strong> in <%= act.project_name %>: <%= act.completed %></p>
                <span class="activity-time"><%= new Date(act.created_at).toLocaleDateString('en-US', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) %></span>
              </div>
            </div>
          <% }) %>
        <% } %>
      </div>
    </div>
  </div>

</div>

<!-- =============================================
     TAB 2: ACTIVITY (Personal / Organization)
     ============================================= -->
<div class="tab-content <%= activeTab === 'activity' ? 'active' : '' %>" id="tab-activity">

  <!-- View Mode Toggle -->
  <div class="view-mode-toggle">
    <button type="button" class="view-mode-btn <%= activeView === 'personal' ? 'active' : '' %>" data-view="personal">
      <i class="fa-solid fa-user"></i> Personal
    </button>
    <button type="button" class="view-mode-btn <%= activeView === 'organization' ? 'active' : '' %>" data-view="organization">
      <i class="fa-solid fa-building"></i> Organization
    </button>
  </div>

  <!-- PERSONAL VIEW -->
  <div class="activity-view <%= activeView === 'personal' ? 'active' : '' %>" id="view-personal">

    <!-- Personal Stats -->
    <div class="stats-row">
      <div class="stat-card">
        <div class="stat-icon stat-icon-accent" aria-hidden="true">
          <i class="fa-solid fa-circle-check"></i>
        </div>
        <div class="stat-info">
          <p class="stat-value"><%= completedToday %></p>
          <p class="stat-label">Completed today</p>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon stat-icon-blue" aria-hidden="true">
          <i class="fa-solid fa-list-check"></i>
        </div>
        <div class="stat-info">
          <p class="stat-value"><%= weeklyTotal %></p>
          <p class="stat-label">Logs this week</p>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon stat-icon-yellow" aria-hidden="true">
          <i class="fa-solid fa-triangle-exclamation"></i>
        </div>
        <div class="stat-info">
          <p class="stat-value"><%= personalActiveBlockers %></p>
          <p class="stat-label">Active blockers</p>
        </div>
      </div>
    </div>

    <!-- Personal Activity Chart -->
    <div class="media-row single-chart-row">
      <div class="media-card chart-card">
        <div class="media-card-header" style="justify-content: space-between; flex-wrap: wrap; gap: 16px;">
          <div>
            <p class="media-card-title">Weekly Activity</p>
            <p class="media-card-sub" id="chartSubtitle">Logs submitted per day <%= weekOffset == 0 ? 'this week' : 'selected week' %> — click a bar to filter</p>
          </div>
          <div>
            <select class="form-select" onchange="window.location.href='?weekOffset='+this.value+'&orgWeekOffset=<%= orgWeekOffset %>&view=personal&tab=activity'" style="width: auto; margin: 0; padding: 8px 12px; font-size: 13px;">
              <option value="0" <%= weekOffset == 0 ? 'selected' : '' %>>This Week</option>
              <option value="1" <%= weekOffset == 1 ? 'selected' : '' %>>Last Week</option>
              <option value="2" <%= weekOffset == 2 ? 'selected' : '' %>>2 Weeks Ago</option>
              <option value="3" <%= weekOffset == 3 ? 'selected' : '' %>>3 Weeks Ago</option>
              <option value="4" <%= weekOffset == 4 ? 'selected' : '' %>>4 Weeks Ago</option>
            </select>
          </div>
        </div>
        <div class="chart-area">
          <canvas id="personalActivityChart"></canvas>
        </div>
      </div>
    </div>

    <!-- Today's Activities -->
    <div class="report-card">
      <div class="report-card-header">
        <h2 id="activitiesTitle">Today's Activities</h2>
        <span class="report-date" id="activitiesDate">
          <%= new Date().toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' }) %>
        </span>
      </div>

      <div class="report-card-body">
        <div class="activities-summary">
          <span class="summary-item">
            <span class="summary-count" id="loggedCount"><%= completedToday %></span> logged
          </span>
          <span class="summary-divider">•</span>
          <span class="summary-item">
            <span class="summary-count"><%= personalActiveBlockers %></span> active blockers
          </span>
        </div>

        <ul class="activity-list" id="personalActivityList">
          <% if (todayLogs.length > 0) { %>
            <% todayLogs.forEach(log => { %>
              <li class="activity-item">
                <span class="activity-text"><%= log.completed %></span>
              </li>
            <% }) %>
          <% } else { %>
            <li class="activity-item">
              <span class="activity-text" style="color: var(--text-muted);">No activities logged today.</span>
            </li>
          <% } %>
        </ul>
      </div>
    </div>

  </div>

  <!-- ORGANIZATION VIEW -->
  <div class="activity-view <%= activeView === 'organization' ? 'active' : '' %>" id="view-organization">

    <!-- Organization Stats -->
    <div class="stats-row">
      <div class="stat-card">
        <div class="stat-icon stat-icon-blue" aria-hidden="true">
          <i class="fa-solid fa-users"></i>
        </div>
        <div class="stat-info">
          <p class="stat-value"><%= orgActiveUsers %></p>
          <p class="stat-label">Active employees</p>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon stat-icon-accent" aria-hidden="true">
          <i class="fa-solid fa-clipboard-list"></i>
        </div>
        <div class="stat-info">
          <p class="stat-value"><%= orgTodayLogsCount %></p>
          <p class="stat-label">Logs today</p>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon stat-icon-yellow" aria-hidden="true">
          <i class="fa-solid fa-triangle-exclamation"></i>
        </div>
        <div class="stat-info">
          <p class="stat-value"><%= orgActiveBlockers %></p>
          <p class="stat-label">Active blockers</p>
        </div>
      </div>
    </div>

    <!-- Organization Activity Chart -->
    <div class="media-row single-chart-row">
      <div class="media-card chart-card">
        <div class="media-card-header" style="justify-content: space-between; flex-wrap: wrap; gap: 16px;">
          <div>
            <p class="media-card-title">Organization Activity</p>
            <p class="media-card-sub">Organization-wide activities per day <%= orgWeekOffset == 0 ? 'this week' : 'that week' %></p>
          </div>
          <div>
            <select class="form-select" onchange="window.location.href='?weekOffset=<%= weekOffset %>&orgWeekOffset='+this.value+'&view=organization&tab=activity'" style="width: auto; margin: 0; padding: 8px 12px; font-size: 13px;">
              <option value="0" <%= orgWeekOffset == 0 ? 'selected' : '' %>>This Week</option>
              <option value="1" <%= orgWeekOffset == 1 ? 'selected' : '' %>>Last Week</option>
              <option value="2" <%= orgWeekOffset == 2 ? 'selected' : '' %>>2 Weeks Ago</option>
              <option value="3" <%= orgWeekOffset == 3 ? 'selected' : '' %>>3 Weeks Ago</option>
              <option value="4" <%= orgWeekOffset == 4 ? 'selected' : '' %>>4 Weeks Ago</option>
            </select>
          </div>
        </div>
        <div class="chart-area">
          <canvas id="orgActivityChart"></canvas>
        </div>
      </div>
    </div>

    <!-- Team Activity Feed -->
    <div class="report-card">
      <div class="report-card-header">
        <div class="header-title-group">
          <h2 id="orgFeedTitle">Team Activity Feed</h2>
          <span class="activity-date" id="orgActivityDate" style="margin-left: 12px; font-weight: 500; font-size: 14px; color: var(--text-muted);">
            <%= new Date().toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' }) %>
          </span>
        </div>
        <select id="teamFilter" class="team-filter-select">
          <option value="">All Teams</option>
          <% teams.forEach(team => { %>
            <option value="<%= team.team_name %>"><%= team.team_name %></option>
          <% }) %>
        </select>
      </div>

      <div class="report-card-body">
        <div class="activities-summary">
          <span class="summary-item">
            <span class="summary-count" id="orgLoggedCount"><%= orgTodayLogsCount %></span> logged
          </span>
        </div>
        <div class="team-activity-feed" id="teamActivityFeed">
          <!-- Rendered by JS -->
        </div>
      </div>
    </div>

  </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const dayLabels = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri'];

    // Tabs principales: PM Dashboard / Activity
    document.querySelectorAll('.dashboard-tab').forEach((btn) => {
      btn.addEventListener('click', () => {
        const tab = btn.dataset.tab;
        window.location.href = `/project-manager/dashboard?tab=${tab}`;
      });
    });

    // Tabs internas: Personal / Organization
    document.querySelectorAll('.view-mode-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const view = btn.dataset.view;
        window.location.href = `/project-manager/dashboard?tab=activity&view=${view}`;
      });
    });

    // Gráfica personal
    const personalCanvas = document.getElementById('personalActivityChart');

    if (personalCanvas && window.Chart) {
      new Chart(personalCanvas, {
        type: 'bar',
        data: {
          labels: dayLabels,
          datasets: [{
            label: 'Personal logs',
            data: window.personalWeeklyData || [0, 0, 0, 0, 0],
            backgroundColor: '#f97316',
            borderRadius: 8
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { display: false }
          },
          scales: {
            y: {
              beginAtZero: true,
              ticks: { precision: 0 }
            }
          }
        }
      });
    }

    // Gráfica organización
    const orgCanvas = document.getElementById('orgActivityChart');

    if (orgCanvas && window.Chart) {
      new Chart(orgCanvas, {
        type: 'bar',
        data: {
          labels: dayLabels,
          datasets: [{
            label: 'Organization logs',
            data: window.orgWeeklyData || [0, 0, 0, 0, 0],
            backgroundColor: '#3b82f6',
            borderRadius: 8
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { display: false }
          },
          scales: {
            y: {
              beginAtZero: true,
              ticks: { precision: 0 }
            }
          }
        }
      });
    }

    // Render de actividad organizacional
    const teamActivityFeed = document.getElementById('teamActivityFeed');
    const teamFilter = document.getElementById('teamFilter');
    const orgLoggedCount = document.getElementById('orgLoggedCount');

    function renderOrgFeed() {
      if (!teamActivityFeed) return;

      const selectedTeam = teamFilter ? teamFilter.value : '';
      const orgLogsByDay = window.orgLogsByDay || [];
      const allLogs = orgLogsByDay.flat();

      const filteredLogs = selectedTeam
        ? allLogs.filter((log) => (log.team_names || '').includes(selectedTeam))
        : allLogs;

      if (orgLoggedCount) {
        orgLoggedCount.textContent = filteredLogs.length;
      }

      if (filteredLogs.length === 0) {
        teamActivityFeed.innerHTML = `
          <p style="color: var(--text-muted); font-size: 14px; padding: 12px;">
            No organization activity found.
          </p>
        `;
        return;
      }

      teamActivityFeed.innerHTML = filteredLogs.map((log) => `
        <div class="activity-item">
          <div class="activity-icon blue">
            <i class="fa-solid fa-list-check"></i>
          </div>
          <div class="activity-content">
            <p class="activity-text">
              <strong>${log.full_name || 'User'}</strong>: ${log.completed || ''}
            </p>
            <span class="activity-time">
              ${log.team_names || 'No team assigned'}
            </span>
          </div>
        </div>
      `).join('');
    }

    if (teamFilter) {
      teamFilter.addEventListener('change', renderOrgFeed);
    }

    renderOrgFeed();

    // Hacer cards del dashboard clickeables
    const statCards = document.querySelectorAll('.pm-stats-row .stat-card');

    if (statCards[0]) statCards[0].style.cursor = 'pointer';
    if (statCards[0]) statCards[0].addEventListener('click', () => {
      window.location.href = '/project-manager/projects';
    });

    if (statCards[2]) statCards[2].style.cursor = 'pointer';
    if (statCards[2]) statCards[2].addEventListener('click', () => {
      window.location.href = '/project-manager/blockers';
    });

    // Hacer proyectos del dashboard clickeables
    document.querySelectorAll('.project-summary-card').forEach((card, index) => {
      card.style.cursor = 'pointer';

      const projects = <%- JSON.stringify(projects) %>;
      const project = projects[index];

      if (project && project.id_project) {
        card.addEventListener('click', () => {
          window.location.href = `/project-manager/project/${project.id_project}`;
        });
      }
    });
  });
</script>