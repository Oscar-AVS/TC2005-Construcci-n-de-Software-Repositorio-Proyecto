  </div>

  <div class="project-card">
    <div class="project-status inactive">Inactive</div>
    <div class="project-content">
      <h3 class="project-title">Security Audit</h3>
      <p class="project-desc">Comprehensive security review and vulnerability assessment.</p>
      <div class="project-meta">
        <div class="meta-item">
          <i class="fa-solid fa-users"></i>
          <span>Security Team</span>
        </div>
        <div class="meta-item">
          <i class="fa-solid fa-calendar"></i>
          <span>Nov 10, 2025</span>
