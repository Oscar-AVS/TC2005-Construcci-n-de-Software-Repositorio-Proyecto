<h1 id="pageTitle" class="page-title">My Projects</h1>

<!-- Filters -->
<div class="report-card">
  <div class="report-card-header">
    <h2>Assigned Projects</h2>
  </div>

  <div class="report-card-body">
    <div class="filter-row">
      <div class="filter-group">
        <label class="form-label" for="filterStatus">Status</label>
        <select id="filterStatus" class="form-select">
          <option value="">All</option>
          <option value="active">Active</option>
          <option value="inactive">Inactive</option>
          <option value="completed">Completed</option>
        </select>
      </div>

      <button class="btn-submit" type="button">Filter</button>
    </div>
  </div>
</div>

<!-- Projects List -->
<div class="projects-grid">

  <div class="project-card">
    <div class="project-status active">Active</div>
    <div class="project-content">
      <h3 class="project-title">Platform Redesign</h3>
      <p class="project-desc">Improving user experience and performance optimization for the main platform.</p>
      <div class="project-meta">
        <div class="meta-item">
          <i class="fa-solid fa-users"></i>
          <span>Engineering Core</span>
        </div>
        <div class="meta-item">
          <i class="fa-solid fa-calendar"></i>
          <span>Jan 15, 2026</span>
        </div>
      </div>
    </div>
  </div>

  <div class="project-card">
    <div class="project-status active">Active</div>
    <div class="project-content">
