<h1 id="pageTitle" class="page-title">Achievements</h1>

<!-- Feedback message -->
<div id="achievementMsg" style="display:none;"></div>

<!-- New Achievement Form -->
<div class="report-card">
  <div class="report-card-header">
    <h2>New Achievement</h2>
  </div>

  <div class="report-card-body">
    <div class="form-row-grid">
      <div class="form-field">
        <label class="form-label" for="achievementTitle">Title</label>
        <input
          type="text"
          id="achievementTitle"
          class="form-input"
          placeholder="e.g. Launched new payment system"
        />
      </div>

      <div class="form-field">
        <label class="form-label" for="achievementDate">Date</label>
        <input type="date" id="achievementDate" class="form-input" />
      </div>
    </div>

    <div class="form-field">
      <label class="form-label" for="achievementDesc">Description</label>
      <textarea
        id="achievementDesc"
        rows="3"
        placeholder="Describe the achievement and its impact..."
      ></textarea>
    </div>

    <div class="form-row-grid">
      <div class="form-field">
        <label class="form-label" for="achievementProject">Project (optional)</label>
        <select id="achievementProject" class="form-select">
          <option value="">None</option>
          <% projects.forEach(p => { %>
            <option value="<%= p.id_project %>"><%= p.project_name %></option>
          <% }) %>
        </select>
      </div>

      <div class="form-field">
        <label class="form-label" for="achievementGoal">Goal (optional)</label>
        <select id="achievementGoal" class="form-select">
          <option value="">None</option>
        </select>
      </div>
    </div>

    <div class="action-row">
      <button class="btn-submit" type="button" id="saveAchievementBtn" onclick="saveAchievement()">
        Save Achievement
      </button>
    </div>
  </div>
</div>

<!-- Achievements Filter -->
<div class="report-card reports-filters-card">
  <div class="report-card-header">
    <h2>Filter Achievements</h2>
  </div>
  <div class="report-card-body">
    <form method="GET" action="<%= achievementsBase %>/achievements">
      <div class="filter-row">
        <div class="filter-group">
          <label class="form-label" for="achQuickFilter">Quick Filters</label>
          <select id="achQuickFilter" class="form-select">
            <option value="">Select a filter</option>
            <option value="LAST_WEEK">Last Week</option>
            <option value="LAST_MONTH">Last Month</option>
            <option value="Q1">Q1 (Jan - Mar)</option>
            <option value="Q2">Q2 (Apr - Jun)</option>
            <option value="Q3">Q3 (Jul - Sep)</option>
            <option value="Q4">Q4 (Oct - Dec)</option>
          </select>
        </div>

        <div class="filter-group">
          <label class="form-label" for="achFilterFrom">From</label>
          <input type="date" id="achFilterFrom" name="date_from" class="form-input" value="<%= filters.date_from || '' %>" />
        </div>

        <div class="filter-group">
          <label class="form-label" for="achFilterTo">To</label>
          <input type="date" id="achFilterTo" name="date_to" class="form-input" value="<%= filters.date_to || '' %>" />
        </div>

        <button class="btn-submit btn-filter-submit" type="submit">
          <i class="fa-solid fa-filter"></i> Filter
        </button>
      </div>
    </form>
  </div>
</div>

<!-- Achievements List -->
<div class="report-card">
  <div class="report-card-header">
    <h2>My Achievements</h2>
    <span class="item-count" id="achievementCount"><%= totalRecords %> total</span>
  </div>

  <div class="report-card-body">
    <div class="achievements-list" id="achievementsList">

      <% if (achievements.length === 0) { %>
        <div style="text-align: center; padding: 40px 0; color: #9ca3af;">
          <i class="fa-solid fa-trophy" style="font-size: 32px; margin-bottom: 12px; display: block; opacity: 0.4;"></i>
          <p style="margin: 0; font-size: 15px; font-style: italic;">No achievements yet. Add your first one above!</p>
        </div>
      <% } else { %>
        <% achievements.forEach(a => { %>
          <div class="achievement-card" id="achievement-<%= a.id_achievement %>" data-date="<%= new Date(a.created_at).toISOString().split('T')[0] %>">
            <div class="achievement-icon">
              <i class="fa-solid fa-trophy"></i>
            </div>
            <div class="achievement-content">
              <div class="achievement-header">
                <h3 class="achievement-title"><%= a.title || a.description %></h3>
              </div>
              <% if (a.description) { %>
                <p class="achievement-desc" style="margin: 4px 0 0; font-size: 13px; color: #5f6b85;"><%= a.description %></p>
              <% } %>
              <div class="achievement-tags" style="margin-top: 8px;">
                <%
                  const statusColors = {
                    pending:  { bg: '#fff7ed', color: '#c2410c', border: '#fed7aa', label: 'Pending Review' },
                    approved: { bg: '#f0fdf4', color: '#15803d', border: '#bbf7d0', label: 'Approved' },
                    rejected: { bg: '#fef2f2', color: '#b91c1c', border: '#fecaca', label: 'Rejected' },
                  };
                  const s = statusColors[a.validation_status] || statusColors.pending;
                %>
                <span style="display: inline-flex; align-items: center; gap: 5px; background: <%= s.bg %>; color: <%= s.color %>; border: 1px solid <%= s.border %>; border-radius: 8px; padding: 3px 10px; font-size: 12px; font-weight: 600;">
                  <i class="fa-solid <%= a.validation_status === 'approved' ? 'fa-circle-check' : a.validation_status === 'rejected' ? 'fa-circle-xmark' : 'fa-clock' %>" style="font-size: 10px;"></i>
                  <%= s.label %>
                </span>
              </div>
            </div>
              <div class="achievement-actions" style="display: flex; flex-direction: column; align-items: flex-end; gap: 8px;">
                <span class="achievement-date" style="font-size: 13px; color: #94a3b8;">
                  <%= new Date(a.created_at).toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                </span>
                <div style="display: flex; gap: 6px;">
                <!-- Use a specific date string representation for the date input -->
                <button class="btn-icon" type="button" title="Edit" onclick="openEditModal(<%= a.id_achievement %>, '<%= (a.title || '').replace(/'/g, "\\'") %>', '<%= (a.description || '').replace(/'/g, "\\'") %>', '<%= new Date(a.created_at).toISOString().split('T')[0] %>')">
                  <i class="fa-solid fa-pen"></i>
                </button>
                <button class="btn-icon btn-delete" type="button" title="Delete" onclick="openDeleteModal(<%= a.id_achievement %>)">
                  <i class="fa-solid fa-trash"></i>
                </button>
                </div>
              </div>
          </div>
        <% }) %>
      <% } %>

      <!-- Pagination -->
      <% if (totalPages > 1) { %>
        <div class="pagination-footer" style="display: flex; justify-content: space-between; align-items: center; margin-top: 24px; padding: 16px; background: #fff; border-radius: 12px; border: 1px solid #e1e4e8;">
          <a href="?page=<%= page - 1 %>&date_from=<%= filters.date_from || '' %>&date_to=<%= filters.date_to || '' %>"
             class="btn-draft" <%= !hasPrevPage ? 'style="pointer-events: none; opacity: 0.5;"' : '' %>>
            <i class="fa-solid fa-chevron-left"></i> Previous
          </a>
          <span style="color: #5f6b85; font-size: 14px; font-weight: 500;">Page <%= page %> of <%= totalPages %></span>
          <a href="?page=<%= page + 1 %>&date_from=<%= filters.date_from || '' %>&date_to=<%= filters.date_to || '' %>"
             class="btn-draft" <%= !hasNextPage ? 'style="pointer-events: none; opacity: 0.5;"' : '' %>>
            Next <i class="fa-solid fa-chevron-right"></i>
          </a>
        </div>
      <% } %>

    </div>
  </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal-overlay" id="deleteModal">
  <div class="modal" style="max-width: 400px; text-align: center;">
    <div class="modal-header" style="justify-content: center; border: none;">
      <h2 style="margin-bottom: 0;">Delete Achievement</h2>
    </div>
    <p style="color: var(--text-secondary); font-size: 14px; margin-bottom: 24px;">Are you sure you want to delete this achievement? This action cannot be undone.</p>
    <div class="action-row" style="justify-content: center; gap: 16px;">
      <button type="button" class="btn-draft" onclick="closeDeleteModal()">Cancel</button>
      <button type="button" class="btn-submit" style="background: #dc2626;" onclick="executeDelete()">Delete</button>
    </div>
  </div>
</div>

<!-- Edit Achievement Modal -->
<div class="modal-overlay" id="editModal">
  <div class="modal" style="max-width: 600px;">
    <div class="modal-header">
      <h2>Edit Achievement</h2>
    </div>
    
    <div class="form-row-grid" style="margin-top: 16px;">
      <div class="form-field">
        <label class="form-label" for="editAchievementTitle">Title</label>
        <input type="text" id="editAchievementTitle" class="form-input" />
      </div>
      <div class="form-field">
        <label class="form-label" for="editAchievementDate">Date</label>
        <input type="date" id="editAchievementDate" class="form-input" />
      </div>
    </div>
    <div class="form-field">
      <label class="form-label" for="editAchievementDesc">Description</label>
      <textarea id="editAchievementDesc" rows="3" class="form-input" style="width: 100%; border: 1px solid #e1e4e8; border-radius: 8px; padding: 12px; font-family: inherit; font-size: 14px;"></textarea>
    </div>

    <div class="action-row" style="justify-content: flex-end; gap: 16px; margin-top: 24px;">
      <button type="button" class="btn-draft" onclick="closeEditModal()">Cancel</button>
      <button type="button" class="btn-submit" onclick="executeEdit()">Save Changes</button>
    </div>
  </div>
</div>
<script>
  const csrfToken = '<%= csrfToken %>';

  function showMsg(text, type) {
    const el = document.getElementById('achievementMsg');
    const icon = type === 'success' ? 'fa-circle-check' : 'fa-circle-exclamation';
    
    el.innerHTML = `<i class="fa-solid ${icon}"></i> ${text}`;
    el.className = `toast-notification ${type === 'success' ? 'success' : 'error'}`;
    el.style.display = 'inline-flex';
    
    setTimeout(() => { 
      el.style.opacity = '0';
      setTimeout(() => {
        el.style.display = 'none';
        el.style.opacity = '1';
      }, 300);
    }, 4000);
  }

  async function saveAchievement() {
    const title       = document.getElementById('achievementTitle').value.trim();
    const description = document.getElementById('achievementDesc').value.trim();
    const created_at  = document.getElementById('achievementDate').value;

    if (!title)      { showMsg('Please enter a title.', 'error'); return; }
    if (!created_at) { showMsg('Please select a date.', 'error'); return; }

    const btn = document.getElementById('saveAchievementBtn');
    btn.disabled = true;
    btn.textContent = 'Saving...';

    try {
      const res = await fetch('<%= achievementsBase %>/achievements', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: new URLSearchParams({ title, description, created_at, _csrf: csrfToken }),
      });
      const data = await res.json();

      if (res.ok) {
        showMsg('Achievement saved! Waiting for team leader approval.', 'success');
        document.getElementById('achievementTitle').value = '';
        document.getElementById('achievementDesc').value = '';
        document.getElementById('achievementDate').value = '';
        document.getElementById('achievementProject').value = '';
        document.getElementById('achievementGoal').value = '';
        setTimeout(() => window.location.reload(), 1500);
      } else {
        showMsg(data.message || 'Error saving achievement.', 'error');
      }
    } catch (err) {
      showMsg('Unexpected error. Please try again.', 'error');
    } finally {
      btn.disabled = false;
      btn.textContent = 'Save Achievement';
    }
  }

  let currentDeleteId = null;

  function openDeleteModal(id) {
    currentDeleteId = id;
    document.getElementById('deleteModal').classList.add('active');
  }

  function closeDeleteModal() {
    currentDeleteId = null;
    document.getElementById('deleteModal').classList.remove('active');
  }

  document.addEventListener('DOMContentLoaded', () => {
    const dm = document.getElementById('deleteModal');
    if (dm) {
      dm.addEventListener('click', function(e) {
        if (e.target === this) closeDeleteModal();
      });
    }
    const em = document.getElementById('editModal');
    if (em) {
      em.addEventListener('click', function(e) {
        if (e.target === this) closeEditModal();
      });
    }
  });

  let currentEditId = null;

  function openEditModal(id, title, desc, date) {
    currentEditId = id;
    document.getElementById('editAchievementTitle').value = title;
    document.getElementById('editAchievementDesc').value = desc;
    document.getElementById('editAchievementDate').value = date;
    document.getElementById('editModal').classList.add('active');
  }

  function closeEditModal() {
    currentEditId = null;
    document.getElementById('editModal').classList.remove('active');
  }

  async function executeEdit() {
    if (!currentEditId) return;

    const title = document.getElementById('editAchievementTitle').value.trim();
    const description = document.getElementById('editAchievementDesc').value.trim();
    const created_at = document.getElementById('editAchievementDate').value;

    if (!title) { showMsg('Please enter a title.', 'error'); return; }
    if (!created_at) { showMsg('Please select a date.', 'error'); return; }

    try {
      const res = await fetch('<%= achievementsBase %>/achievements/edit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: new URLSearchParams({ id_achievement: currentEditId, title, description, created_at, _csrf: csrfToken }),
      });
      const data = await res.json();

      if (res.ok) {
        showMsg('Achievement updated.', 'success');
        setTimeout(() => window.location.reload(), 1000); // the easiest way to reflect changes fast
      } else {
        showMsg(data.message || 'Cannot edit this achievement.', 'error');
        closeEditModal();
      }
    } catch (err) {
      showMsg('Unexpected error.', 'error');
      closeEditModal();
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    const achQuickFilter = document.getElementById('achQuickFilter');
    const achFilterFrom = document.getElementById('achFilterFrom');
    const achFilterTo = document.getElementById('achFilterTo');

    achQuickFilter.addEventListener('change', () => {
      const val = achQuickFilter.value;
      const year = new Date().getFullYear();
      let startDate = '', endDate = '';

      switch (val) {
        case 'LAST_WEEK': {
          const today = new Date();
          const last = new Date();
          last.setDate(today.getDate() - 7);
          startDate = last.toISOString().split('T')[0];
          endDate = today.toISOString().split('T')[0];
          break;
        }
        case 'LAST_MONTH': {
          const today = new Date();
          const first = new Date(today.getFullYear(), today.getMonth() - 1, 1);
          const last = new Date(today.getFullYear(), today.getMonth(), 0);
          startDate = first.toISOString().split('T')[0];
          endDate = last.toISOString().split('T')[0];
          break;
        }
        case 'Q1': startDate = `${year}-01-01`; endDate = `${year}-03-31`; break;
        case 'Q2': startDate = `${year}-04-01`; endDate = `${year}-06-30`; break;
        case 'Q3': startDate = `${year}-07-01`; endDate = `${year}-09-30`; break;
        case 'Q4': startDate = `${year}-10-01`; endDate = `${year}-12-31`; break;
      }

      achFilterFrom.value = startDate;
      achFilterTo.value = endDate;
    });

    achFilterFrom.addEventListener('change', () => { achQuickFilter.value = ''; });
    achFilterTo.addEventListener('change', () => { achQuickFilter.value = ''; });
  });

  async function executeDelete() {
    if (!currentDeleteId) return;

    try {
      const res = await fetch('<%= achievementsBase %>/achievements/delete', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: new URLSearchParams({ id_achievement: currentDeleteId, _csrf: csrfToken }),
      });
      const data = await res.json();

      if (res.ok) {
        showMsg('Achievement deleted.', 'success');
        document.getElementById('achievement-' + currentDeleteId).remove();
        const countEl = document.getElementById('achievementCount');
        const current = parseInt(countEl.textContent) - 1;
        countEl.textContent = `${current} total`;
        closeDeleteModal();
      } else {
        showMsg(data.message || 'Cannot delete this achievement.', 'error');
        closeDeleteModal();
      }
    } catch (err) {
      showMsg('Unexpected error.', 'error');
      closeDeleteModal();
    }
  }
</script>