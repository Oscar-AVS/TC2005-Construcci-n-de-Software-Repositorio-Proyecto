<h1 id="pageTitle" class="page-title">My Profile</h1>

<!-- Profile Info -->
<div class="report-card">
  <div class="report-card-header">
    <h2>Personal Information</h2>
  </div>

  <div class="report-card-body">
    <div class="profile-section">
      <div class="profile-avatar">
        <img src="https://wallpapercave.com/wp/wp6608939.jpg" alt="Profile picture" />
      </div>
      <div class="profile-info">
        <h3 class="profile-name">Luis Miguel</h3>
        <p class="profile-role">Software Engineer</p>
        <p class="profile-team">Team: MUFASA</p>
      </div>
    </div>
  </div>
</div>

<!-- Slack Integration -->
<div class="report-card">
  <div class="report-card-header">
    <h2>Slack Integration</h2>
  </div>

  <div class="report-card-body">
    <form class="profile-form">
      <div class="form-field">
        <label class="form-label" for="slackUsername">Slack Username</label>
        <p class="form-hint">Used to sync your activity log entries from Slack.</p>
        <input 
          type="text" 
          id="slackUsername" 
          class="form-input" 
          placeholder="@elsolmx"
          value="@elsolmx"
        />
      </div>

      <div class="action-row">
        <button class="btn-submit" type="submit">Save Changes</button>
      </div>
    </form>
  </div>
</div>

<!-- Account Settings -->
<div class="report-card">
  <div class="report-card-header">
    <h2>Account Settings</h2>
  </div>

  <div class="report-card-body">
    <form class="profile-form">
      <div class="form-field">
        <label class="form-label" for="email">Email</label>
        <input 
          type="email" 
          id="email" 
          class="form-input" 
          placeholder="luis.mi@change.org"
          value="luis.mi@change.org"
          disabled
        />
      </div>

      <div class="form-field">
        <label class="form-label" for="currentPassword">Current Password</label>
        <input 
          type="password" 
          id="currentPassword" 
          class="form-input" 
          placeholder="••••••••"
        />
      </div>

      <div class="form-field">
        <label class="form-label" for="newPassword">New Password</label>
        <input 
          type="password" 
          id="newPassword" 
          class="form-input" 
          placeholder="••••••••"
        />
      </div>

      <div class="form-field">
        <label class="form-label" for="confirmPassword">Confirm New Password</label>
        <input 
          type="password" 
          id="confirmPassword" 
          class="form-input" 
          placeholder="••••••••"
        />
      </div>

      <div class="action-row">
        <button class="btn-submit" type="submit">Update Password</button>
      </div>
    </form>
  </div>
</div>