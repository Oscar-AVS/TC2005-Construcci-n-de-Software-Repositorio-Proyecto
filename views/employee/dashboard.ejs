<h1 id="pageTitle" class="page-title">Employee Dashboard</h1>

<script>
  window.personalWeeklyData = <%- JSON.stringify(weeklyData) %>;
  window.logsByDay = <%- JSON.stringify(logsByDay) %>;
  window.todayWeekday = <%= new Date().getDay() === 0 ? 6 : new Date().getDay() - 1 %>;
  window.orgWeeklyData = <%- JSON.stringify(orgWeeklyData) %>;
  window.orgLogsByDay = <%- JSON.stringify(orgLogsByDay) %>;
  window.teamsData = <%- JSON.stringify(teams) %>;
</script>

<div class="view-mode-toggle">
  <button type="button" class="view-mode-btn <%= activeView === 'personal' ? 'active' : '' %>" data-view="personal">
    <i class="fa-solid fa-user"></i> Personal
  </button>
  <button type="button" class="view-mode-btn <%= activeView === 'organization' ? 'active' : '' %>" data-view="organization">
    <i class="fa-solid fa-building"></i> Organization
  </button>
</div>

<!-- PERSONAL VIEW -->
<div class="activity-view <%= activeView === 'personal' ? 'active' : '' %>" id="view-personal">

  <div class="stats-row">
    <div class="stat-card">
      <div class="stat-icon stat-icon-accent" aria-hidden="true">
        <i class="fa-solid fa-circle-check"></i>
      </div>
      <div class="stat-info">
        <p class="stat-value"><%= completedToday %></p>
        <p class="stat-label">Completed today</p>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-icon stat-icon-blue" aria-hidden="true">
        <i class="fa-solid fa-list-check"></i>
      </div>
      <div class="stat-info">
        <p class="stat-value"><%= weeklyTotal %></p>
        <p class="stat-label">Logs this week</p>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-icon stat-icon-yellow" aria-hidden="true">
        <i class="fa-solid fa-triangle-exclamation"></i>
      </div>
      <div class="stat-info">
        <p class="stat-value"><%= activeBlockers %></p>
        <p class="stat-label">Active blockers</p>
      </div>
    </div>
  </div>

  <div class="media-row single-chart-row">
    <div class="media-card chart-card">
      <div class="media-card-header" style="justify-content: space-between; flex-wrap: wrap; gap: 16px;">
        <div>
          <p class="media-card-title">Weekly Activity</p>
          <p class="media-card-sub" id="chartSubtitle">Logs submitted per day <%= weekOffset == 0 ? 'this week' : 'selected week' %> — click a bar to filter</p>
        </div>
        <div>
          <select class="form-select" onchange="window.location.href='?weekOffset='+this.value+'&orgWeekOffset=<%= orgWeekOffset %>&view=personal'" style="width: auto; margin: 0; padding: 8px 12px; font-size: 13px;">
            <option value="0" <%= weekOffset == 0 ? 'selected' : '' %>>This Week</option>
            <option value="1" <%= weekOffset == 1 ? 'selected' : '' %>>Last Week</option>
            <option value="2" <%= weekOffset == 2 ? 'selected' : '' %>>2 Weeks Ago</option>
            <option value="3" <%= weekOffset == 3 ? 'selected' : '' %>>3 Weeks Ago</option>
            <option value="4" <%= weekOffset == 4 ? 'selected' : '' %>>4 Weeks Ago</option>
          </select>
        </div>
      </div>
      <div class="chart-area">
        <canvas id="personalActivityChart"></canvas>
      </div>
    </div>
  </div>

  <div class="report-card">
    <div class="report-card-header">
      <h2 id="activitiesTitle">Today's Activities</h2>
      <span class="report-date" id="activitiesDate">
        <%= new Date().toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' }) %>
      </span>
    </div>

    <div class="report-card-body">
      <div class="activities-summary">
        <span class="summary-item">
          <span class="summary-count" id="loggedCount"><%= completedToday %></span> logged
        </span>
        <span class="summary-divider">•</span>
        <span class="summary-item">
          <span class="summary-count"><%= activeBlockers %></span> active blockers
        </span>
      </div>

      <ul class="activity-list" id="personalActivityList">
        <% if (todayLogs.length > 0) { %>
          <% todayLogs.forEach(log => { %>
            <li class="activity-item">
              <span class="activity-text"><%= log.completed %></span>
            </li>
          <% }) %>
        <% } else { %>
          <li class="activity-item">
            <span class="activity-text" style="color: var(--text-muted);">No activities logged today.</span>
          </li>
        <% } %>
      </ul>
    </div>
  </div>

</div>

<!-- ORGANIZATION VIEW -->
<div class="activity-view <%= activeView === 'organization' ? 'active' : '' %>" id="view-organization">

  <div class="stats-row">
    <div class="stat-card">
      <div class="stat-icon stat-icon-blue" aria-hidden="true">
        <i class="fa-solid fa-users"></i>
      </div>
      <div class="stat-info">
        <p class="stat-value"><%= orgActiveUsers %></p>
        <p class="stat-label">Active employees</p>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-icon stat-icon-accent" aria-hidden="true">
        <i class="fa-solid fa-clipboard-list"></i>
      </div>
      <div class="stat-info">
        <p class="stat-value"><%= orgTodayLogsCount %></p>
        <p class="stat-label">Logs today</p>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-icon stat-icon-yellow" aria-hidden="true">
        <i class="fa-solid fa-triangle-exclamation"></i>
      </div>
      <div class="stat-info">
        <p class="stat-value"><%= orgActiveBlockers %></p>
        <p class="stat-label">Active blockers</p>
      </div>
    </div>
  </div>

  <div class="media-row single-chart-row">
    <div class="media-card chart-card">
      <div class="media-card-header" style="justify-content: space-between; flex-wrap: wrap; gap: 16px;">
        <div>
          <p class="media-card-title">Organization Activity</p>
          <p class="media-card-sub">Organization-wide activities per day <%= orgWeekOffset == 0 ? 'this week' : 'that week' %></p>
        </div>
        <div>
          <select class="form-select" onchange="window.location.href='?weekOffset=<%= weekOffset %>&orgWeekOffset='+this.value+'&view=organization'" style="width: auto; margin: 0; padding: 8px 12px; font-size: 13px;">
            <option value="0" <%= orgWeekOffset == 0 ? 'selected' : '' %>>This Week</option>
            <option value="1" <%= orgWeekOffset == 1 ? 'selected' : '' %>>Last Week</option>
            <option value="2" <%= orgWeekOffset == 2 ? 'selected' : '' %>>2 Weeks Ago</option>
            <option value="3" <%= orgWeekOffset == 3 ? 'selected' : '' %>>3 Weeks Ago</option>
            <option value="4" <%= orgWeekOffset == 4 ? 'selected' : '' %>>4 Weeks Ago</option>
          </select>
        </div>
      </div>
      <div class="chart-area">
        <canvas id="orgActivityChart"></canvas>
      </div>
    </div>
  </div>

  <div class="report-card">
    <div class="report-card-header">
      <div class="header-title-group">
        <h2 id="orgFeedTitle">Team Activity Feed</h2>
        <span class="activity-date" id="orgActivityDate" style="margin-left: 12px; font-weight: 500; font-size: 14px; color: var(--text-muted);">
          <%= new Date().toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' }) %>
        </span>
      </div>
      <select id="teamFilter" class="team-filter-select">
        <option value="">All Teams</option>
        <% teams.forEach(team => { %>
          <option value="<%= team.team_name %>"><%= team.team_name %></option>
        <% }) %>
      </select>
    </div>
    <div class="report-card-body">
      <div class="activities-summary">
        <span class="summary-item">
          <span class="summary-count" id="orgLoggedCount"><%= orgTodayLogsCount %></span> logged
        </span>
      </div>
      <div class="team-activity-feed" id="teamActivityFeed"></div>
    </div>
  </div>

</div>