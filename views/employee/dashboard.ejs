<h1 id="pageTitle" class="page-title">Employee Dashboard</h1>

<script>
  window.personalWeeklyData = <%- JSON.stringify(weeklyData) %>;
  window.logsByDay = <%- JSON.stringify(logsByDay) %>;
  window.todayWeekday = <%= new Date().getDay() === 0 ? 6 : new Date().getDay() - 1 %>;
</script>

<div class="view-mode-toggle">
  <button type="button" class="view-mode-btn active" data-view="personal">
    <i class="fa-solid fa-user"></i> Personal
  </button>
  <button type="button" class="view-mode-btn" data-view="organization">
    <i class="fa-solid fa-building"></i> Organization
  </button>
</div>

<!-- PERSONAL VIEW -->
<div class="activity-view active" id="view-personal">

  <div class="stats-row">
    <div class="stat-card">
      <div class="stat-icon stat-icon-accent" aria-hidden="true">
        <i class="fa-solid fa-circle-check"></i>
      </div>
      <div class="stat-info">
        <p class="stat-value"><%= completedToday %></p>
        <p class="stat-label">Completed today</p>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-icon stat-icon-blue" aria-hidden="true">
        <i class="fa-solid fa-list-check"></i>
      </div>
      <div class="stat-info">
        <p class="stat-value"><%= weeklyTotal %></p>
        <p class="stat-label">Logs this week</p>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-icon stat-icon-yellow" aria-hidden="true">
        <i class="fa-solid fa-triangle-exclamation"></i>
      </div>
      <div class="stat-info">
        <p class="stat-value"><%= activeBlockers %></p>
        <p class="stat-label">Active blockers</p>
      </div>
    </div>
  </div>

  <div class="media-row single-chart-row">
    <div class="media-card chart-card">
      <div class="media-card-header">
        <div>
          <p class="media-card-title">Weekly Activity</p>
          <p class="media-card-sub" id="chartSubtitle">Logs submitted per day this week — click a bar to filter</p>
        </div>
      </div>
      <div class="chart-area">
        <canvas id="personalActivityChart"></canvas>
      </div>
    </div>
  </div>

  <div class="report-card">
    <div class="report-card-header">
      <h2 id="activitiesTitle">Today's Activities</h2>
      <span class="report-date" id="activitiesDate">
        <%= new Date().toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' }) %>
      </span>
    </div>

    <div class="report-card-body">
      <div class="activities-summary">
        <span class="summary-item">
          <span class="summary-count" id="loggedCount"><%= completedToday %></span> logged
        </span>
        <span class="summary-divider">•</span>
        <span class="summary-item">
          <span class="summary-count"><%= activeBlockers %></span> active blockers
        </span>
      </div>

      <ul class="activity-list" id="personalActivityList">
        <% if (todayLogs.length > 0) { %>
          <% todayLogs.forEach(log => { %>
            <li class="activity-item">
              <span class="activity-text"><%= log.completed %></span>
            </li>
          <% }) %>
        <% } else { %>
          <li class="activity-item">
            <span class="activity-text" style="color: var(--text-muted);">No activities logged today.</span>
          </li>
        <% } %>
      </ul>
    </div>
  </div>

</div>

<!-- ORGANIZATION VIEW -->
<div class="activity-view" id="view-organization">

  <div class="stats-row">
    <div class="stat-card">
      <div class="stat-icon stat-icon-blue" aria-hidden="true">
        <i class="fa-solid fa-users"></i>
      </div>
      <div class="stat-info">
        <p class="stat-value">42</p>
        <p class="stat-label">Active employees</p>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-icon stat-icon-accent" aria-hidden="true">
        <i class="fa-solid fa-clipboard-list"></i>
      </div>
      <div class="stat-info">
        <p class="stat-value">156</p>
        <p class="stat-label">Logs today</p>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-icon stat-icon-yellow" aria-hidden="true">
        <i class="fa-solid fa-triangle-exclamation"></i>
      </div>
      <div class="stat-info">
        <p class="stat-value">8</p>
        <p class="stat-label">Active blockers</p>
      </div>
    </div>
  </div>

  <div class="media-row single-chart-row">
    <div class="media-card chart-card">
      <div class="media-card-header">
        <div>
          <p class="media-card-title">Organization Activity</p>
          <p class="media-card-sub">Organization-wide activities per day</p>
        </div>
      </div>
      <div class="chart-area">
        <canvas id="orgActivityChart"></canvas>
      </div>
    </div>
  </div>

  <div class="report-card">
    <div class="report-card-header">
      <div class="header-title-group">
        <h2 id="orgFeedTitle">Team Activity Feed</h2>
      </div>
      <select id="teamFilter" class="team-filter-select">
        <option value="">All Teams</option>
        <option value="mufasa">Mufasa Solutions</option>
        <option value="phoenix">Phoenix Team</option>
        <option value="delta">Delta Squad</option>
      </select>
    </div>
    <div class="report-card-body">
      <div class="team-activity-feed" id="teamActivityFeed"></div>
    </div>
  </div>

</div>