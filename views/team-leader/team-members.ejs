<h1 id="pageTitle" class="page-title">Team Members</h1>

<div class="report-card">
  <div class="report-card-header">
    <h2><%= teamName %></h2>
    <button class="btn-submit" type="button">
      <i class="fa-solid fa-plus"></i> Add Member
    </button>
  </div>

  <div class="report-card-body">
    <% if (members && members.length > 0) { %>
      <% members.forEach(member => { %>
        <div class="member-card">
          <div class="member-avatar">
            <img
              src="<%= member.avatar || 'https://www.shutterstock.com/image-vector/blank-avatar-photo-place-holder-600nw-1095249842.jpg' %>"
              alt="<%= member.full_name %>"
            />
          </div>

          <div class="member-info">
            <h3 class="member-name"><%= member.full_name %></h3>
            <p class="member-role"><%= member.role === 'team-leader' ? 'Team Leader' : member.role === 'project-manager' ? 'Project Manager' : member.role === 'manager' ? 'Manager' : member.role === 'admin' ? 'Administrator' : 'Employee' %></p>            <p class="member-email"><%= member.email %></p>
          </div>

          <div class="member-stats">
            <div class="stat-item">
              <span class="stat-value">--</span>
              <span class="stat-label">Entries this week</span>
            </div>
          </div>

          <div class="member-actions">
            <button class="btn-icon btn-danger" type="button" title="Remove from team">
              <i class="fa-solid fa-user-minus"></i>
            </button>
          </div>
        </div>
      <% }) %>
    <% } else { %>
      <p>No team members found.</p>
    <% } %>
  </div>
</div>