<h1 id="pageTitle" class="page-title">Team Activity Log</h1>

<div class="report-card">
  <div class="report-card-header">
    <h2>Filter Entries</h2>
  </div>

  <div class="report-card-body">
    <form action="/team-leader/team-log" method="GET" class="filter-row">
      <div class="filter-group">
        <label class="form-label" for="logQuickFilter">Quick Filters</label>
        <select id="logQuickFilter" class="form-select">
          <option value="">Select a filter</option>
          <option value="LAST_WEEK">Last Week</option>
          <option value="LAST_MONTH">Last Month</option>
          <option value="Q1">Q1 (Jan - Mar)</option>
          <option value="Q2">Q2 (Apr - Jun)</option>
          <option value="Q3">Q3 (Jul - Sep)</option>
          <option value="Q4">Q4 (Oct - Dec)</option>
        </select>
      </div>

      <div class="filter-group">
        <label class="form-label" for="filterMember">Team Member</label>
        <select id="filterMember" name="id_user" class="form-select">
          <option value="">All Members</option>
          <% members.forEach(member => { %>
            <option value="<%= member.id_user %>" <%= filters.id_user == member.id_user ? 'selected' : '' %>>
              <%= member.full_name %>
            </option>
          <% }) %>
        </select>
      </div>

      <div class="filter-group">
        <label class="form-label" for="filterProject">Project</label>
        <select id="filterProject" name="id_project" class="form-select">
          <option value="">All Projects</option>
          <% projects.forEach(project => { %>
            <option value="<%= project.id_project %>" <%= filters.id_project == project.id_project ? 'selected' : '' %>>
              <%= project.project_name %>
            </option>
          <% }) %>
        </select>
      </div>

      <div class="filter-group">
        <label class="form-label" for="filterFrom">From</label>
        <input
          type="date"
          id="filterFrom"
          name="date_from"
          class="form-input"
          value="<%= filters.date_from || '' %>"
        />
      </div>

      <div class="filter-group">
        <label class="form-label" for="filterTo">To</label>
        <input
          type="date"
          id="filterTo"
          name="date_to"
          class="form-input"
          value="<%= filters.date_to || '' %>"
        />
      </div>

      <button class="btn-submit" type="submit">Filter</button>
    </form>
  </div>
</div>

<div class="report-card">
  <div class="report-card-header">
    <h2>Entries</h2>
    <span class="item-count"><%= totalRecords %> entries</span>
  </div>

  <div class="report-card-body">
    <div class="team-entries-list">
      <% if (entries && entries.length > 0) { %>
        <% entries.forEach(entry => { %>
          <div class="team-entry-card <%= entry.blocker_description ? 'has-blocker' : '' %>">
            <div class="entry-header">
              <div class="entry-author">
                <img
                  src="<%= entry.avatar || 'https://www.shutterstock.com/image-vector/blank-avatar-photo-place-holder-600nw-1095249842.jpg' %>"
                  alt="<%= entry.full_name %>"
                />
                <div>
                  <p class="author-name"><%= entry.full_name %></p>
                  <p class="author-role">
                    <%= entry.role === 'team-leader' ? 'Team Leader' : entry.role === 'project-manager' ? 'Project Manager' : entry.role === 'manager' ? 'Manager' : entry.role === 'admin' ? 'Administrator' : 'Employee' %>
                  </p>
                </div>
              </div>

              <div class="entry-meta">
                <span class="entry-project"><%= entry.project_name %></span>
                <span class="entry-date"><%= new Date(entry.created_at).toLocaleDateString('en-GB') %></span>
              </div>
            </div>

            <div class="entry-body">
              <div class="entry-section">
                <div class="section-label completed">
                  <i class="fa-solid fa-check"></i> Completed
                </div>
                <p><%= entry.completed %></p>
              </div>

              <div class="entry-section">
                <div class="section-label planned">
                  <i class="fa-solid fa-calendar"></i> Planned
                </div>
                <p><%= entry.planned %></p>
              </div>

              <% if (entry.blocker_description) { %>
                <div class="entry-section">
                  <div class="section-label blocker">
                    <i class="fa-solid fa-triangle-exclamation"></i> Blocker
                  </div>
                  <p><%= entry.blocker_description %></p>
                </div>
              <% } %>
            </div>
          </div>
        <% }) %>

        <!-- Pagination -->
        <% if (totalPages > 1) { %>
          <div class="pagination-footer" style="display: flex; justify-content: space-between; align-items: center; margin-top: 24px; padding: 16px; background: #f8f9fc; border-radius: 12px; border: 1px solid #e1e4e8;">
            <a href="?page=<%= page - 1 %>&id_user=<%= filters.id_user || '' %>&id_project=<%= filters.id_project || '' %>&date_from=<%= filters.date_from || '' %>&date_to=<%= filters.date_to || '' %>"
               class="btn-draft" <%= !hasPrevPage ? 'style="pointer-events: none; opacity: 0.5;"' : '' %>>
              <i class="fa-solid fa-chevron-left"></i> Previous
            </a>
            <span style="color: #5f6b85; font-size: 14px; font-weight: 500;">Page <%= page %> of <%= totalPages %></span>
            <a href="?page=<%= page + 1 %>&id_user=<%= filters.id_user || '' %>&id_project=<%= filters.id_project || '' %>&date_from=<%= filters.date_from || '' %>&date_to=<%= filters.date_to || '' %>"
               class="btn-draft" <%= !hasNextPage ? 'style="pointer-events: none; opacity: 0.5;"' : '' %>>
              Next <i class="fa-solid fa-chevron-right"></i>
            </a>
          </div>
        <% } %>

      <% } else { %>
        <p>No entries found.</p>
      <% } %>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const logQuickFilter = document.getElementById('logQuickFilter');
    const filterFrom = document.getElementById('filterFrom');
    const filterTo = document.getElementById('filterTo');

    if (logQuickFilter && filterFrom && filterTo) {
      logQuickFilter.addEventListener('change', () => {
        const val = logQuickFilter.value;
        const year = new Date().getFullYear();
        let startDate = '', endDate = '';

        switch (val) {
          case 'LAST_WEEK': {
            const today = new Date();
            const last = new Date();
            last.setDate(today.getDate() - 7);
            startDate = last.toISOString().split('T')[0];
            endDate = today.toISOString().split('T')[0];
            break;
          }
          case 'LAST_MONTH': {
            const today = new Date();
            const first = new Date(today.getFullYear(), today.getMonth() - 1, 1);
            const last = new Date(today.getFullYear(), today.getMonth(), 0);
            startDate = first.toISOString().split('T')[0];
            endDate = last.toISOString().split('T')[0];
            break;
          }
          case 'Q1': startDate = `${year}-01-01`; endDate = `${year}-03-31`; break;
          case 'Q2': startDate = `${year}-04-01`; endDate = `${year}-06-30`; break;
          case 'Q3': startDate = `${year}-07-01`; endDate = `${year}-09-30`; break;
          case 'Q4': startDate = `${year}-10-01`; endDate = `${year}-12-31`; break;
        }

        filterFrom.value = startDate;
        filterTo.value = endDate;
      });

      filterFrom.addEventListener('change', () => { logQuickFilter.value = ''; });
      filterTo.addEventListener('change', () => { logQuickFilter.value = ''; });
    }
  });
</script>