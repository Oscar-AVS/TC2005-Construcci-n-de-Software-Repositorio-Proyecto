<h1 id="pageTitle" class="page-title">Team Activity Log</h1>

<!-- Filters -->
<div class="report-card">
  <div class="report-card-header">
    <h2>Filter Entries</h2>
  </div>

  <div class="report-card-body">
    <div class="filter-row">
      <div class="filter-group">
        <label class="form-label" for="filterMember">Team Member</label>
        <select id="filterMember" class="filter-select">
          <option value="">All Members</option>
          <option value="1">John Doe</option>
          <option value="2">Jane Smith</option>
          <option value="3">Mike Johnson</option>
        </select>
      </div>

      <div class="filter-group">
        <label class="form-label" for="filterDateFrom">From</label>
        <input type="date" id="filterDateFrom" class="filter-input" />
      </div>

      <div class="filter-group">
        <label class="form-label" for="filterDateTo">To</label>
        <input type="date" id="filterDateTo" class="filter-input" />
      </div>

      <button class="btn-submit" type="button">Filter</button>
    </div>
  </div>
</div>

<!-- Team Log Entries -->
<div class="report-card">
  <div class="report-card-header">
    <h2>Entries</h2>
  </div>

  <div class="report-card-body">

