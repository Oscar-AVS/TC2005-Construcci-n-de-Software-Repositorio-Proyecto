<% if (typeof noTeam !== 'undefined' && noTeam) { %>
  <h1 class="page-title">Team Dashboard</h1>
  <div style="margin-top:2rem; padding: 16px 24px; background: #fffbeb; border: 1px solid #f59e0b; border-radius: 10px; color: #92400e; font-size: 14px; font-weight: 500;">
    <strong>No team assigned yet.</strong> You have been granted the Team Leader role but haven't been assigned to a team. Please contact an administrator.
  </div>
<% } else { %>
<h1 id="pageTitle" class="page-title"><%= fullName.split(' ')[0] %>'s Team Dashboard</h1>

<script>
  window.personalWeeklyData = <%- JSON.stringify(weeklyData) %>;
  window.logsByDay = <%- JSON.stringify(logsByDay) %>;
  window.todayWeekday = <%= new Date().getDay() === 0 ? 6 : new Date().getDay() - 1 %>;
  window.orgWeeklyData = <%- JSON.stringify(orgWeeklyData) %>;
  window.orgLogsByDay = <%- JSON.stringify(orgLogsByDay) %>;
  window.teamsData = <%- JSON.stringify(teams) %>;
</script>

<!-- Dashboard Tabs -->
<div class="dashboard-tabs">
  <button type="button" class="dashboard-tab <%= activeView === 'team-dashboard' ? 'active' : '' %>" data-tab="team-dashboard">
    <i class="fa-solid fa-users"></i> Team Dashboard
  </button>
  <button type="button" class="dashboard-tab <%= activeView === 'activity' ? 'active' : '' %>" data-tab="activity">
    <i class="fa-solid fa-chart-line"></i> Activity
  </button>
</div>

<!-- =============================================
     TAB 1: TEAM DASHBOARD
     ============================================= -->
<div class="tab-content <%= activeView === 'team-dashboard' ? 'active' : '' %>" id="tab-team-dashboard">

  <!-- Team Stats -->
  <div class="stats-row">
    <div class="stat-card">
      <div class="stat-icon stat-icon-blue" aria-hidden="true">
        <i class="fa-solid fa-users"></i>
      </div>
      <div class="stat-info">
        <p class="stat-value"><%= summary.totalMembers %></p>
        <p class="stat-label">Team Members</p>
      </div>
    </div>

    <div class="stat-card">
      <div class="stat-icon stat-icon-accent" aria-hidden="true">
        <i class="fa-solid fa-clipboard-list"></i>
      </div>
      <div class="stat-info">
        <p class="stat-value"><%= summary.entriesThisWeek %></p>
        <p class="stat-label">Entries This Week</p>
      </div>
    </div>

    <div class="stat-card">
      <div class="stat-icon stat-icon-green" aria-hidden="true">
        <i class="fa-solid fa-trophy"></i>
      </div>
      <div class="stat-info">
        <p class="stat-value"><%= summary.totalAchievements %></p>
        <p class="stat-label">Achievements</p>
      </div>
    </div>

    <div class="stat-card">
      <div class="stat-icon stat-icon-yellow" aria-hidden="true">
        <i class="fa-solid fa-triangle-exclamation"></i>
      </div>
      <div class="stat-info">
        <p class="stat-value"><%= summary.totalBlockers %></p>
        <p class="stat-label">Active Blockers</p>
      </div>
    </div>
  </div>

  <!-- Two Column Layout -->
  <div class="dashboard-grid">

    <!-- Left Column: Blockers + Achievements -->
    <div class="dashboard-column">

      <!-- Active Blockers (paginated) -->
      <div class="report-card blockers-card">
        <div class="report-card-header">
          <div class="header-with-icon warning">
            <i class="fa-solid fa-triangle-exclamation"></i>
            <h2>Active Blockers</h2>
          </div>
          <a href="/team-leader/team-log" class="link-action">View All →</a>
        </div>

        <div class="report-card-body">
          <div class="blocker-list" id="blockerList">
            <% if (pendingBlockers && pendingBlockers.length > 0) { %>
              <% pendingBlockers.forEach((blocker, i) => { %>
                <div class="blocker-item" data-blocker-index="<%= i %>">
                  <img
                    src="<%= blocker.avatar || 'https://www.shutterstock.com/image-vector/blank-avatar-photo-place-holder-600nw-1095249842.jpg' %>"
                    alt="<%= blocker.full_name %>"
                  />
                  <div class="blocker-content">
                    <p class="blocker-author"><%= blocker.full_name %></p>
                    <p class="blocker-text"><%= blocker.description %></p>
                    <p class="blocker-project"><%= blocker.project_name %></p>
                  </div>

                  <div style="display: flex; flex-direction: column; align-items: end; gap: 8px;">
                    <span class="blocker-date"><%= new Date(blocker.created_at).toLocaleDateString('en-GB') %></span>

                    <form action="/team-leader/blockers/resolve" method="POST">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                      <input type="hidden" name="id_blocker" value="<%= blocker.id_blocker %>">
                      <button class="btn-submit" type="submit" style="padding: 6px 12px; font-size: 14px;">
                        Resolve
                      </button>
                    </form>
                  </div>
                </div>
              <% }) %>
            <% } else { %>
              <p>No active blockers.</p>
            <% } %>
          </div>

          <% if (pendingBlockers && pendingBlockers.length > 3) { %>
          <div style="display: flex; align-items: center; justify-content: center; gap: 12px; margin-top: 16px; padding-top: 12px; border-top: 1px solid #e1e4e8;">
            <button id="blockerPrevBtn" onclick="changeDashPage('blocker', -1)"
              style="background: none; border: 1px solid #d1d5db; border-radius: 6px; padding: 4px 10px; cursor: pointer; color: #5f6b85;">
              <i class="fa-solid fa-chevron-left"></i>
            </button>
            <span id="blockerPageInfo" style="font-size: 13px; color: #5f6b85; min-width: 60px; text-align: center;"></span>
            <button id="blockerNextBtn" onclick="changeDashPage('blocker', 1)"
              style="background: none; border: 1px solid #d1d5db; border-radius: 6px; padding: 4px 10px; cursor: pointer; color: #5f6b85;">
              <i class="fa-solid fa-chevron-right"></i>
            </button>
          </div>
          <% } %>
        </div>
      </div>

      <!-- Pending Achievements (paginated) -->
      <div class="report-card">
        <div class="report-card-header">
          <div class="header-with-icon success">
            <i class="fa-solid fa-trophy"></i>
            <h2>Pending Achievements</h2>
          </div>
        </div>

        <div class="report-card-body">
          <div class="blocker-list" id="achievementList">
            <% if (pendingAchievements && pendingAchievements.length > 0) { %>
              <% pendingAchievements.forEach((achievement, i) => { %>
                <div class="blocker-item" data-achievement-index="<%= i %>">
                  <img
                    src="<%= achievement.avatar || 'https://www.shutterstock.com/image-vector/blank-avatar-photo-place-holder-600nw-1095249842.jpg' %>"
                    alt="<%= achievement.full_name %>"
                  />

                  <div class="blocker-content">
                    <p class="blocker-author"><%= achievement.full_name %></p>
                    <p class="blocker-text"><%= achievement.description %></p>
                  </div>

                  <div style="display: flex; flex-direction: column; align-items: end; gap: 8px;">
                    <span class="blocker-date"><%= new Date(achievement.created_at).toLocaleDateString('en-GB') %></span>

                    <div style="display: flex; gap: 8px;">
                      <form action="/team-leader/achievements/approve" method="POST">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                        <input type="hidden" name="id_achievement" value="<%= achievement.id_achievement %>">
                        <button class="btn-submit" type="submit" style="padding: 6px 12px; font-size: 14px;">
                          Approve
                        </button>
                      </form>

                      <form action="/team-leader/achievements/reject" method="POST">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                        <input type="hidden" name="id_achievement" value="<%= achievement.id_achievement %>">
                        <button class="btn-secondary" type="submit" style="padding: 6px 12px; font-size: 14px;">
                          Reject
                        </button>
                      </form>
                    </div>
                  </div>
                </div>
              <% }) %>
            <% } else { %>
              <p>No pending achievements.</p>
            <% } %>
          </div>

          <% if (pendingAchievements && pendingAchievements.length > 3) { %>
          <div style="display: flex; align-items: center; justify-content: center; gap: 12px; margin-top: 16px; padding-top: 12px; border-top: 1px solid #e1e4e8;">
            <button id="achievementPrevBtn" onclick="changeDashPage('achievement', -1)"
              style="background: none; border: 1px solid #d1d5db; border-radius: 6px; padding: 4px 10px; cursor: pointer; color: #5f6b85;">
              <i class="fa-solid fa-chevron-left"></i>
            </button>
            <span id="achievementPageInfo" style="font-size: 13px; color: #5f6b85; min-width: 60px; text-align: center;"></span>
            <button id="achievementNextBtn" onclick="changeDashPage('achievement', 1)"
              style="background: none; border: 1px solid #d1d5db; border-radius: 6px; padding: 4px 10px; cursor: pointer; color: #5f6b85;">
              <i class="fa-solid fa-chevron-right"></i>
            </button>
          </div>
          <% } %>
        </div>
      </div>

    </div>

    <!-- Right Column: Quick Actions + Recent Activity + Team Members -->
    <div class="dashboard-column">

      <!-- Quick Actions -->
      <div class="report-card">
        <div class="report-card-header">
          <h2>Quick Actions</h2>
        </div>

        <div class="report-card-body">
          <div class="quick-actions">
            <a href="/team-leader/team-report" class="quick-action-btn">
              <i class="fa-solid fa-file-lines"></i>
              <span>Generate Report</span>
            </a>
            <a href="/team-leader/team-members" class="quick-action-btn">
              <i class="fa-solid fa-user-plus"></i>
              <span>Add Member</span>
            </a>
            <a href="/team-leader/log" class="quick-action-btn">
              <i class="fa-solid fa-pen"></i>
              <span>Log</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Recent Activity -->
      <div class="report-card">
        <div class="report-card-header">
          <h2>Recent Activity</h2>
          <a href="/team-leader/team-log" class="link-action">View Log →</a>
        </div>

        <div class="report-card-body">
          <div class="activity-feed">
            <% if (recentActivity && recentActivity.length > 0) { %>
              <% recentActivity.forEach(activity => { %>
                <div class="feed-item">
                  <div class="feed-icon
                    <%= activity.activity_type === 'log' ? 'green' : activity.activity_type === 'blocker' ? 'yellow' : 'accent' %>">
                    <i class="fa-solid
                      <%= activity.activity_type === 'log' ? 'fa-check' : activity.activity_type === 'blocker' ? 'fa-exclamation' : 'fa-trophy' %>"></i>
                  </div>
                  <div class="feed-content">
                    <p class="feed-text">
                      <span class="feed-author"><%= activity.full_name %></span>
                      <% if (activity.activity_type === 'log') { %>
                        submitted daily report
                      <% } else if (activity.activity_type === 'blocker') { %>
                        reported a blocker
                      <% } else { %>
                        added an achievement
                      <% } %>
                    </p>
                    <p class="feed-meta">
                      <%= activity.project_name || 'General' %> •
                      <%= new Date(activity.activity_date).toLocaleString('en-GB', {
                        day: '2-digit',
                        month: 'short',
                        hour: '2-digit',
                        minute: '2-digit'
                      }) %>
                    </p>
                  </div>
                </div>
              <% }) %>
            <% } else { %>
              <p>No recent activity found.</p>
            <% } %>
          </div>
        </div>
      </div>

      <!-- Team Members Overview -->
      <div class="report-card">
        <div class="report-card-header">
          <h2>Team Members</h2>
          <a href="/team-leader/team-members" class="link-action">Manage →</a>
        </div>

        <div class="report-card-body">
          <div class="members-overview">
            <% if (teamMembersOverview && teamMembersOverview.length > 0) { %>
              <% teamMembersOverview.forEach(member => { %>
                <div class="member-row">
                  <div class="member-info-mini">
                    <img
                      src="<%= member.avatar || 'https://www.shutterstock.com/image-vector/blank-avatar-photo-place-holder-600nw-1095249842.jpg' %>"
                      alt="<%= member.full_name %>"
                    />
                    <div>
                      <p class="member-name-mini"><%= member.full_name %></p>
                      <p class="member-role-mini"><%= member.email %></p>
                    </div>
                  </div>
                  <div class="member-week-stats">
                    <span class="week-entries"><%= member.entries_this_week %> entries</span>
                    <span class="member-status-badge <%= member.member_status === 'Blocked' ? 'blocked' : 'ok' %>">
                      <%= member.member_status %>
                    </span>
                  </div>
                </div>
              <% }) %>
            <% } else { %>
              <p>No team members found.</p>
            <% } %>
          </div>
        </div>
      </div>

    </div>

  </div>

</div>

<!-- =============================================
     TAB 2: ACTIVITY (Personal / Organization)
     ============================================= -->
<div class="tab-content <%= activeView === 'activity' ? 'active' : '' %>" id="tab-activity">

  <!-- View Mode Toggle -->
  <div class="view-mode-toggle">
    <button type="button" class="view-mode-btn <%= activeView === 'personal' || activeView === 'activity' ? 'active' : '' %>" data-view="personal">
      <i class="fa-solid fa-user"></i> Personal
    </button>
    <button type="button" class="view-mode-btn <%= activeView === 'organization' ? 'active' : '' %>" data-view="organization">
      <i class="fa-solid fa-building"></i> Organization
    </button>
  </div>

  <!-- PERSONAL VIEW -->
  <div class="activity-view active" id="view-personal">

    <!-- Personal Stats -->
    <div class="stats-row">
      <div class="stat-card">
        <div class="stat-icon stat-icon-accent" aria-hidden="true">
          <i class="fa-solid fa-circle-check"></i>
        </div>
        <div class="stat-info">
          <p class="stat-value" id="statCompletedPersonal"><%= completedToday %></p>
          <p class="stat-label">Completed today</p>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon stat-icon-blue" aria-hidden="true">
          <i class="fa-solid fa-list-check"></i>
        </div>
        <div class="stat-info">
          <p class="stat-value" id="statPendingPersonal"><%= weeklyTotal %></p>
          <p class="stat-label">Logs this week</p>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon stat-icon-yellow" aria-hidden="true">
          <i class="fa-solid fa-triangle-exclamation"></i>
        </div>
        <div class="stat-info">
          <p class="stat-value"><%= activeBlockers %></p>
          <p class="stat-label">Active blockers</p>
        </div>
      </div>
    </div>

    <!-- Personal Activity Chart -->
    <div class="media-row single-chart-row">
      <div class="media-card chart-card">
        <div class="media-card-header" style="justify-content: space-between; flex-wrap: wrap; gap: 16px;">
          <div>
            <p class="media-card-title">Weekly Activity</p>
            <p class="media-card-sub" id="chartSubtitle">Logs submitted per day <%= weekOffset == 0 ? 'this week' : 'selected week' %> — click a bar to filter</p>
          </div>
          <div>
            <select class="form-select" onchange="window.location.href='?weekOffset='+this.value+'&orgWeekOffset=<%= orgWeekOffset %>&view=activity'" style="width: auto; margin: 0; padding: 8px 12px; font-size: 13px;">
              <option value="0" <%= weekOffset == 0 ? 'selected' : '' %>>This Week</option>
              <option value="1" <%= weekOffset == 1 ? 'selected' : '' %>>Last Week</option>
              <option value="2" <%= weekOffset == 2 ? 'selected' : '' %>>2 Weeks Ago</option>
              <option value="3" <%= weekOffset == 3 ? 'selected' : '' %>>3 Weeks Ago</option>
              <option value="4" <%= weekOffset == 4 ? 'selected' : '' %>>4 Weeks Ago</option>
            </select>
          </div>
        </div>
        <div class="chart-area">
          <canvas id="personalActivityChart"></canvas>
        </div>
      </div>
    </div>

    <!-- Today's Activities -->
    <div class="report-card">
      <div class="report-card-header">
        <h2 id="personalActivitiesTitle">Today's Activities</h2>
        <span class="report-date" id="personalActivitiesDate">
          <%= new Date().toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' }) %>
        </span>
      </div>

      <div class="report-card-body">
        <div class="activities-summary">
          <span class="summary-item">
            <span class="summary-count" id="personalCompletedCount"><%= completedToday %></span> logged
          </span>
          <span class="summary-divider">•</span>
          <span class="summary-item">
            <span class="summary-count" id="personalPendingCount"><%= activeBlockers %></span> active blockers
          </span>
        </div>

        <ul class="activity-list" id="personalActivityList">
          <% if (todayLogs.length > 0) { %>
            <% todayLogs.forEach(log => { %>
              <li class="activity-item">
                <span class="activity-text"><%= log.completed %></span>
              </li>
            <% }) %>
          <% } else { %>
            <li class="activity-item">
              <span class="activity-text" style="color: var(--text-muted);">No activities logged today.</span>
            </li>
          <% } %>
        </ul>
      </div>
    </div>

  </div>

  <!-- ORGANIZATION VIEW -->
  <div class="activity-view" id="view-organization">

    <!-- Organization Stats -->
    <div class="stats-row">
      <div class="stat-card">
        <div class="stat-icon stat-icon-blue" aria-hidden="true">
          <i class="fa-solid fa-users"></i>
        </div>
        <div class="stat-info">
          <p class="stat-value"><%= orgActiveUsers %></p>
          <p class="stat-label">Active employees</p>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon stat-icon-accent" aria-hidden="true">
          <i class="fa-solid fa-clipboard-list"></i>
        </div>
        <div class="stat-info">
          <p class="stat-value"><%= orgTodayLogsCount %></p>
          <p class="stat-label">Logs today</p>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon stat-icon-yellow" aria-hidden="true">
          <i class="fa-solid fa-triangle-exclamation"></i>
        </div>
        <div class="stat-info">
          <p class="stat-value"><%= orgActiveBlockers %></p>
          <p class="stat-label">Active blockers</p>
        </div>
      </div>
    </div>

    <!-- Organization Activity Chart -->
    <div class="media-row single-chart-row">
      <div class="media-card chart-card">
        <div class="media-card-header" style="justify-content: space-between; flex-wrap: wrap; gap: 16px;">
          <div>
            <p class="media-card-title">Organization Activity</p>
            <p class="media-card-sub">Organization-wide activities per day <%= orgWeekOffset == 0 ? 'this week' : 'that week' %></p>
          </div>
          <div>
            <select class="form-select" onchange="window.location.href='?weekOffset=<%= weekOffset %>&orgWeekOffset='+this.value+'&view=organization'" style="width: auto; margin: 0; padding: 8px 12px; font-size: 13px;">
              <option value="0" <%= orgWeekOffset == 0 ? 'selected' : '' %>>This Week</option>
              <option value="1" <%= orgWeekOffset == 1 ? 'selected' : '' %>>Last Week</option>
              <option value="2" <%= orgWeekOffset == 2 ? 'selected' : '' %>>2 Weeks Ago</option>
              <option value="3" <%= orgWeekOffset == 3 ? 'selected' : '' %>>3 Weeks Ago</option>
              <option value="4" <%= orgWeekOffset == 4 ? 'selected' : '' %>>4 Weeks Ago</option>
            </select>
          </div>
        </div>
        <div class="chart-area">
          <canvas id="orgActivityChart"></canvas>
        </div>
      </div>
    </div>

    <!-- Team Activity Feed -->
    <div class="report-card">
      <div class="report-card-header">
        <div class="header-title-group">
          <h2 id="orgFeedTitle">Team Activity Feed</h2>
          <span class="report-date" id="orgFeedDate" style="display: none;"></span>
        </div>
        <select id="teamFilter" class="team-filter-select">
          <option value="">All Teams</option>
          <% teams.forEach(team => { %>
            <option value="<%= team.team_name %>"><%= team.team_name %></option>
          <% }) %>
        </select>
      </div>

      <div class="report-card-body">
        <div class="team-activity-feed" id="teamActivityFeed">
          <!-- Rendered by JS -->
        </div>
      </div>
    </div>

  </div>

</div>

<script>
  (function () {
    const ITEMS_PER_PAGE = 3;
    const state = { blocker: 0, achievement: 0 };

    function renderDashPage(type) {
      const items = document.querySelectorAll(`[data-${type}-index]`);
      if (!items.length) return;

      const total = items.length;
      const totalPages = Math.ceil(total / ITEMS_PER_PAGE);
      const page = state[type];

      items.forEach((el, i) => {
        el.style.display = (i >= page * ITEMS_PER_PAGE && i < (page + 1) * ITEMS_PER_PAGE) ? '' : 'none';
      });

      const info = document.getElementById(`${type}PageInfo`);
      const prev = document.getElementById(`${type}PrevBtn`);
      const next = document.getElementById(`${type}NextBtn`);

      if (info) info.textContent = `${page + 1} / ${totalPages}`;
      if (prev) prev.disabled = page === 0;
      if (next) next.disabled = page >= totalPages - 1;
    }

    window.changeDashPage = function (type, delta) {
      const items = document.querySelectorAll(`[data-${type}-index]`);
      const totalPages = Math.ceil(items.length / ITEMS_PER_PAGE);
      state[type] = Math.max(0, Math.min(state[type] + delta, totalPages - 1));
      renderDashPage(type);
    };

    document.addEventListener('DOMContentLoaded', function () {
      renderDashPage('blocker');
      renderDashPage('achievement');
    });
  })();
</script>
<% } %>
