<!DOCTYPE html>
<html lang="en">
  <%- include('../partials/head') %>
  <body>
    <div id="loginScreen" class="login-screen">
      <div class="login-card">

        <div class="login-brand">
          <img src="/images/logo.png" alt="Change.org" style="height: 40px;" />
        </div>

        <h1 class="login-title">Create Account</h1>
        <p class="login-sub">Fill in your details to get started</p>

        <% if (typeof success !== 'undefined' && success) { %>
          <div style="background: #dcfce7; color: #166534; border: 1px solid #bbf7d0; border-radius: 10px; padding: 12px 14px; font-size: 14px; margin-bottom: 16px;">
            <i class="fa-solid fa-circle-check" style="margin-right: 6px;"></i>
            <%= success %>
          </div>
        <% } else { %>
          <form class="login-form" action="/signup" method="POST" autocomplete="off">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

            <div class="lf-field">
              <label class="lf-label" for="fullName">Full Name</label>
              <div class="lf-input-wrap">
                <i class="fa-regular fa-user lf-icon" aria-hidden="true"></i>
                <input id="fullName" name="full_name" type="text" placeholder="Your full name" required />
              </div>
            </div>

            <div class="lf-field" style="position: relative;">
              <label class="lf-label" for="signupEmail">Email</label>
              <div class="lf-input-wrap">
                <i class="fa-regular fa-envelope lf-icon" aria-hidden="true"></i>
                <input id="signupEmail" name="email" type="text" placeholder="email@change.org" required autocomplete="off" />
              </div>
              <div id="emailSuggestions" style="display: none; position: absolute; top: 100%; left: 0; right: 0; background: #fff; border: 1px solid #dcdcdc; border-radius: 10px; box-shadow: 0 8px 20px rgba(0,0,0,0.1); z-index: 100; overflow: hidden; margin-top: 4px;"></div>
            </div>

            <div class="lf-field">
              <label class="lf-label" for="signupPass">Password</label>
              <div class="lf-input-wrap">
                <i class="fa-solid fa-lock lf-icon" aria-hidden="true"></i>
                <input id="signupPass" name="password" type="password" placeholder="••••••••" required />
                <button id="togglePass" class="lf-eye" type="button" tabindex="-1" aria-label="Show password">
                  <i id="eyeIcon" class="fa-regular fa-eye" aria-hidden="true"></i>
                </button>
              </div>
            </div>

            <p id="signupError" class="lf-error" aria-live="polite"><%= typeof error !== 'undefined' ? error : '' %></p>

            <button id="signupBtn" class="btn-login" type="submit">
              <span>Create Account</span>
              <i class="fa-solid fa-user-plus" aria-hidden="true"></i>
            </button>

            <p style="text-align: center; margin-top: 16px; color: #5f6b85; font-size: 14px;">
              Already have an account?
              <a href="/login" style="color: #f25c2a; font-weight: 700;">Log in</a>
            </p>
          </form>
        <% } %>

      </div>
    </div>

    <script>
      const passwordInput = document.getElementById('signupPass');
      const toggleBtn = document.getElementById('togglePass');
      const eyeIcon = document.getElementById('eyeIcon');

      if (toggleBtn) {
        toggleBtn.addEventListener('click', () => {
          const isPassword = passwordInput.type === 'password';
          passwordInput.type = isPassword ? 'text' : 'password';
          eyeIcon.className = isPassword ? 'fa-regular fa-eye-slash' : 'fa-regular fa-eye';
        });
      }

      const emailInput = document.getElementById('signupEmail');
      const emailSuggestions = document.getElementById('emailSuggestions');
      const domains = ['@change.org', '@gmail.com', '@hotmail.com', '@outlook.com'];

      emailInput.addEventListener('input', () => {
        const val = emailInput.value;

        if (!val || val.includes('@')) {
          emailSuggestions.style.display = 'none';
          emailSuggestions.innerHTML = '';
          return;
        }

        emailSuggestions.innerHTML = domains.map(domain => `
          <button type="button" data-value="${val}${domain}" style="width: 100%; border: none; background: #fff; padding: 10px 14px; text-align: left; cursor: pointer; font-size: 14px; color: #1f2a44; display: block; border-bottom: 1px solid #f0f0f0;">
            ${val}<strong style="color: #f25c2a;">${domain}</strong>
          </button>
        `).join('');

        emailSuggestions.style.display = 'block';

        emailSuggestions.querySelectorAll('button').forEach(btn => {
          btn.addEventListener('mouseenter', () => btn.style.background = '#f7f8fb');
          btn.addEventListener('mouseleave', () => btn.style.background = '#fff');
          btn.addEventListener('click', () => {
            emailInput.value = btn.dataset.value;
            emailSuggestions.style.display = 'none';
          });
        });
      });

      document.addEventListener('click', (e) => {
        if (e.target !== emailInput) {
          emailSuggestions.style.display = 'none';
        }
      });
    </script>
  </body>
</html>