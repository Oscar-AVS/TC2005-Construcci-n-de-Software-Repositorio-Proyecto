<!-- Admin Teams View -->
<h1 id="pageTitle" class="page-title">Teams Management</h1>

<!-- Add Team Card -->
<div class="report-card">
  <div class="report-card-header">
    <h2>Create New Team</h2>
  </div>

  <div class="report-card-body">
    <div class="form-row-grid">
      <div class="form-field">
        <label class="form-label" for="teamName">Team Name</label>
        <input type="text" id="teamName" class="form-input" placeholder="Enter team name..." />
      </div>

      <div class="form-field">
        <label class="form-label" for="teamLeader">Team Leader</label>
        <select id="teamLeader" class="form-select">
          <option value="">Select team leader...</option>
          <option value="1">Oscar Vilchis</option>
          <option value="2">Carlos Mendez</option>
          <option value="3">Maria Lopez</option>
        </select>
      </div>
    </div>

    <div class="action-row">
      <button class="btn-submit" type="button">
        <i class="fa-solid fa-people-group"></i> Create Team
      </button>
    </div>
  </div>
</div>

<!-- Teams Grid -->
<div class="report-card">
  <div class="report-card-header">
    <h2>All Teams</h2>
    <span class="item-count">8 teams</span>
  </div>

  <div class="report-card-body">
