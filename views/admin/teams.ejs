            <span class="team-member-name">Oscar Vilchis</span>
            <span class="team-member-role">Backend</span>
          </div>
        </div>

        <div class="team-card-footer">
          <span class="team-stat">
            <i class="fa-solid fa-users"></i> 3 members
          </span>
          <button class="btn-icon" type="button" title="Add member">
