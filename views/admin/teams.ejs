<!-- Admin Teams View -->
<h1 id="pageTitle" class="page-title">Teams Management</h1>

<!-- Add Team Card -->
<div class="report-card">
  <div class="report-card-header">
    <h2>Create New Team</h2>
  </div>

  <div class="report-card-body">
    <form action="/admin/teams/create" method="POST">
      <div class="form-row-grid">
        <div class="form-field">
          <label class="form-label" for="teamName">Team Name</label>
          <input type="text" id="teamName" name="team_name" class="form-input" placeholder="Enter team name..." required />
        </div>

        <div class="form-field">
          <label class="form-label" for="teamLeader">Team Leader</label>
          <select id="teamLeader" name="id_leader" class="form-select" required>
            <option value="">Select team leader...</option>
            <% users.forEach(u => { %>
              <option value="<%= u.id %>"><%= u.full_name %></option>
            <% }) %>
          </select>
        </div>
      </div>

      <div class="form-row-grid">
        <div class="form-field">
          <label class="form-label" for="teamDescription">Description</label>
          <input type="text" id="teamDescription" name="description" class="form-input" placeholder="Enter team description..." />
        </div>
      </div>

      <div class="action-row">
        <button class="btn-submit" type="submit">
          <i class="fa-solid fa-people-group"></i> Create Team
        </button>
      </div>
    </form>
  </div>
</div>

<!-- Teams Grid -->
<div class="report-card">
  <div class="report-card-header">
    <h2>All Teams</h2>
    <span class="item-count"><%= teams.length %> teams</span>
  </div>

  <div class="report-card-body">
    <div class="teams-grid">
      <% if (teams && teams.length > 0) { %>
        <% teams.forEach(team => { %>
          <div class="team-card">
            <div class="team-card-header">
              <div>
                <h3 class="team-card-title"><%= team.team_name %></h3>
                <p class="team-card-leader">Leader: <span><%= team.leader_name || '—' %></span></p>
              </div>
              <div class="team-card-actions">
                <button class="btn-icon" type="button" title="Edit">
                  <i class="fa-solid fa-pen"></i>
                </button>
                <button class="btn-icon btn-danger" type="button" title="Delete">
                  <i class="fa-solid fa-trash"></i>
                </button>
              </div>
            </div>

            <div class="team-card-footer">
              <span class="team-stat">
                <i class="fa-solid fa-calendar"></i> <%= team.created_at ? new Date(team.created_at).toLocaleDateString('en-GB') : '—' %>
              </span>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <p>No teams found.</p>
      <% } %>
    </div>
  </div>
</div>