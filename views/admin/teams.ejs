<!-- Admin Teams View -->
<h1 id="pageTitle" class="page-title">Teams Management</h1>

<!-- Add Team Card -->
<div class="report-card">
  <div class="report-card-header">
    <h2>Create New Team</h2>
  </div>

  <div class="report-card-body">
    <form action="/admin/teams/create" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <div class="form-row-grid">
        <div class="form-field">
          <label class="form-label" for="teamName">Team Name</label>
          <input type="text" id="teamName" name="team_name" class="form-input" placeholder="Enter team name..." required />
        </div>

        <div class="form-field">
          <label class="form-label" for="teamLeader">Team Leader</label>
          <select id="teamLeader" name="id_leader" class="form-select">
            <option value="">Select team leader...</option>
            <% users.forEach(u => { %>
              <option value="<%= u.id %>"><%= u.full_name %></option>
            <% }) %>
          </select>
        </div>
      </div>

      <div class="form-row-grid">
        <div class="form-field">
          <label class="form-label" for="teamDescription">Description</label>
          <input type="text" id="teamDescription" name="description" class="form-input" placeholder="Enter team description..." />
        </div>
      </div>

      <div class="action-row">
        <button class="btn-submit" type="submit">
          <i class="fa-solid fa-people-group"></i> Create Team
        </button>
      </div>
    </form>
  </div>
</div>

<!-- Teams Grid -->
<div class="report-card">
  <div class="report-card-header">
    <h2>All Teams</h2>
    <span class="item-count"><%= teams.length %> teams</span>
  </div>

  <div class="report-card-body">
    <div class="teams-grid">
      <% if (teams && teams.length > 0) { %>
        <% teams.forEach(team => { %>
          <div class="team-card">
            <div class="team-card-header">
              <div>
                <h3 class="team-card-title"><%= team.team_name %></h3>
                <p class="team-card-leader">Leader: <span><%= team.leader_name || '—' %></span></p>
              </div>
              <div class="team-card-actions">
                <button
                  class="btn-icon"
                  type="button"
                  title="Edit"
                  onclick="openEditTeamModal(<%= team.id_team %>, '<%= team.team_name %>', '<%= team.description || '' %>', <%= team.leader_id || 'null' %>)"
                >
                  <i class="fa-solid fa-pen"></i>
                </button>
                <button
                  class="btn-icon btn-danger"
                  type="button"
                  title="Delete"
                  onclick="openDeleteTeamModal(<%= team.id_team %>)"
                >
                  <i class="fa-solid fa-trash"></i>
                </button>
              </div>
            </div>

            <div style="padding: 0 16px; margin-bottom: 12px;">
              <p style="margin: 0 0 8px 0; font-size: 12px; font-weight: 700; color: #9ca3af; text-transform: uppercase; letter-spacing: 0.5px;">
                <i class="fa-solid fa-users" style="margin-right: 4px;"></i>
                Members (<%= team.members.length %>)
              </p>
              <% if (team.members.length > 0) { %>
                <% team.members.forEach((m, mIdx) => { %>
                  <div class="team-member-item" data-member-idx="<%= mIdx %>" style="display: flex; align-items: center; gap: 10px; padding: 8px 0; border-bottom: 1px solid #f3f4f6;">
                    <div style="width: 30px; height: 30px; border-radius: 50%; background: #fb0202; display: flex; align-items: center; justify-content: center; color: #fff; font-weight: 700; font-size: 12px; flex-shrink: 0;">
                      <%= m.full_name.charAt(0).toUpperCase() %>
                    </div>
                    <div style="min-width: 0;">
                      <p style="margin: 0; font-size: 13px; font-weight: 600; color: #1f2a44; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;"><%= m.full_name %></p>
                      <p style="margin: 0; font-size: 11px; color: #5f6b85; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;"><%= m.email %></p>
                    </div>
                  </div>
                <% }) %>
              <% } else { %>
                <p style="color: #9ca3af; font-size: 13px; font-style: italic; margin: 0;">No members assigned.</p>
              <% } %>

              <div class="team-member-pager" style="display: none; align-items: center; justify-content: space-between; padding: 8px 0 0 0; margin-top: 4px;">
                <button class="team-member-pager-prev" style="border: 1px solid #e5e7eb; background: #fff; color: #374151; padding: 4px 12px; border-radius: 8px; font-size: 12px; font-weight: 600; cursor: pointer;">&#8592; Prev</button>
                <span class="team-member-pager-info" style="font-size: 12px; color: #5f6b85; font-weight: 600;"></span>
                <button class="team-member-pager-next" style="border: 1px solid #e5e7eb; background: #fff; color: #374151; padding: 4px 12px; border-radius: 8px; font-size: 12px; font-weight: 600; cursor: pointer;">Next &#8594;</button>
              </div>
            </div>

            <div class="team-card-footer">
              <span class="team-stat">
                <i class="fa-solid fa-calendar"></i> <%= team.created_at ? new Date(team.created_at).toLocaleDateString('en-GB') : '—' %>
              </span>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <p>No teams found.</p>
      <% } %>
    </div>

    <div id="teams-pagination" style="display: none; align-items: center; justify-content: center; gap: 12px; padding: 16px 0; border-top: 1px solid #f3f4f6; margin-top: 8px;">
      <button id="teams-prev" style="border: 1px solid #e5e7eb; background: #fff; color: #374151; padding: 6px 14px; border-radius: 8px; font-size: 13px; font-weight: 600; cursor: pointer;">&#8592; Prev</button>
      <span id="teams-page-info" style="font-size: 13px; color: #5f6b85; font-weight: 600;"></span>
      <button id="teams-next" style="border: 1px solid #e5e7eb; background: #fff; color: #374151; padding: 6px 14px; border-radius: 8px; font-size: 13px; font-weight: 600; cursor: pointer;">Next &#8594;</button>
    </div>
  </div>
</div>

<!-- Edit Team Modal -->
<div
  id="editTeamModal"
  style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.4); backdrop-filter: blur(4px); z-index: 9999; align-items: center; justify-content: center;"
>
  <div style="background: #fff; width: min(480px, 90vw); border-radius: 20px; padding: 32px; box-shadow: 0 24px 48px rgba(0,0,0,0.2);">
    <h3 style="margin: 0 0 20px 0; font-size: 22px; color: #1f2a44;">Edit Team</h3>

    <form action="/admin/teams/edit" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <input type="hidden" name="id_team" id="editTeamId" />

      <div class="form-field" style="margin-bottom: 12px;">
        <label class="form-label" for="editTeamName">Team Name</label>
        <input type="text" id="editTeamName" name="team_name" class="form-input" required />
      </div>

      <div class="form-field" style="margin-bottom: 12px;">
        <label class="form-label" for="editTeamDescription">Description</label>
        <input type="text" id="editTeamDescription" name="description" class="form-input" />
      </div>

      <div class="form-field" style="margin-bottom: 24px;">
        <label class="form-label" for="editTeamLeader">Team Leader</label>
        <select id="editTeamLeader" name="id_leader" class="form-select">
          <option value="">Select team leader...</option>
          <% users.forEach(u => { %>
            <option value="<%= u.id %>"><%= u.full_name %></option>
          <% }) %>
        </select>
      </div>

      <div style="display: flex; justify-content: flex-end; gap: 10px;">
        <button type="button" onclick="closeEditTeamModal()" style="display: inline-flex; align-items: center; gap: 8px; border: none; background: #f1f5f9; color: #374151; padding: 12px 20px; border-radius: 12px; font-weight: 700; cursor: pointer; font-size: 14px;">
          <i class="fa-solid fa-xmark"></i> Cancel
        </button>
        <button type="submit" style="display: inline-flex; align-items: center; gap: 8px; border: none; background: #f25c2a; color: #fff; padding: 12px 20px; border-radius: 12px; font-weight: 700; cursor: pointer; font-size: 14px;">
          <i class="fa-solid fa-check"></i> Save
        </button>
      </div>
    </form>
  </div>
</div>

<!-- Delete Team Modal -->
<div
  id="deleteTeamModal"
  style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.4); backdrop-filter: blur(4px); z-index: 9999; align-items: center; justify-content: center;"
>
  <div style="background: #fff; width: min(400px, 90vw); border-radius: 20px; padding: 32px; box-shadow: 0 24px 48px rgba(0,0,0,0.2); text-align: center;">
    <div style="width: 56px; height: 56px; border-radius: 50%; background: #fee2e2; display: flex; align-items: center; justify-content: center; margin: 0 auto 16px; font-size: 24px; color: #e74c3c;">
      <i class="fa-solid fa-trash"></i>
    </div>
    <h3 style="margin: 0 0 8px 0; font-size: 20px; color: #1f2a44;">Delete Team</h3>
    <p style="color: #5f6b85; margin-bottom: 28px; font-size: 14px; line-height: 1.5;">Are you sure you want to delete this team? This action cannot be undone.</p>

    <form action="/admin/teams/delete" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <input type="hidden" name="id_team" id="deleteTeamId" />
      <div style="display: flex; justify-content: center; gap: 12px;">
        <button type="button" onclick="closeDeleteTeamModal()" style="display: inline-flex; align-items: center; gap: 8px; border: none; background: #f1f5f9; color: #374151; padding: 12px 24px; border-radius: 12px; font-weight: 700; cursor: pointer; font-size: 14px;">
          <i class="fa-solid fa-xmark"></i> Cancel
        </button>
        <button type="submit" style="display: inline-flex; align-items: center; gap: 8px; border: none; background: #e74c3c; color: #fff; padding: 12px 24px; border-radius: 12px; font-weight: 700; cursor: pointer; font-size: 14px;">
          <i class="fa-solid fa-trash"></i> Delete
        </button>
      </div>
    </form>
  </div>
</div>

<script src="/js/modules/teams.js"></script>
<script>
(function () {
  var PER_PAGE = 6;
  var cards = Array.from(document.querySelectorAll('.teams-grid .team-card'));
  if (cards.length <= PER_PAGE) return;

  var pagination = document.getElementById('teams-pagination');
  var prevBtn = document.getElementById('teams-prev');
  var nextBtn = document.getElementById('teams-next');
  var info = document.getElementById('teams-page-info');
  var totalPages = Math.ceil(cards.length / PER_PAGE);
  var page = 1;

  function render() {
    cards.forEach(function (card, i) {
      card.style.display = (i >= (page - 1) * PER_PAGE && i < page * PER_PAGE) ? '' : 'none';
    });
    info.textContent = 'Page ' + page + ' of ' + totalPages;
    prevBtn.style.opacity = page === 1 ? '0.4' : '1';
    prevBtn.style.cursor = page === 1 ? 'default' : 'pointer';
    nextBtn.style.opacity = page === totalPages ? '0.4' : '1';
    nextBtn.style.cursor = page === totalPages ? 'default' : 'pointer';
  }

  prevBtn.addEventListener('click', function () { if (page > 1) { page--; render(); } });
  nextBtn.addEventListener('click', function () { if (page < totalPages) { page++; render(); } });

  pagination.style.display = 'flex';
  render();
})();

(function () {
  var PER_PAGE = 5;
  document.querySelectorAll('.team-card').forEach(function (card) {
    var items = Array.from(card.querySelectorAll('.team-member-item'));
    if (items.length <= PER_PAGE) return;

    var pager = card.querySelector('.team-member-pager');
    var prevBtn = pager.querySelector('.team-member-pager-prev');
    var nextBtn = pager.querySelector('.team-member-pager-next');
    var info = pager.querySelector('.team-member-pager-info');
    var totalPages = Math.ceil(items.length / PER_PAGE);
    var page = 1;

    function render() {
      items.forEach(function (item, i) {
        item.style.display = (i >= (page - 1) * PER_PAGE && i < page * PER_PAGE) ? 'flex' : 'none';
      });
      info.textContent = 'Page ' + page + ' of ' + totalPages;
      prevBtn.style.opacity = page === 1 ? '0.4' : '1';
      prevBtn.style.cursor = page === 1 ? 'default' : 'pointer';
      nextBtn.style.opacity = page === totalPages ? '0.4' : '1';
      nextBtn.style.cursor = page === totalPages ? 'default' : 'pointer';
    }

    prevBtn.addEventListener('click', function () { if (page > 1) { page--; render(); } });
    nextBtn.addEventListener('click', function () { if (page < totalPages) { page++; render(); } });

    pager.style.display = 'flex';
    render();
  });
})();
</script>