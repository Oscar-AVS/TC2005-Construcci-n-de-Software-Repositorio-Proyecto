      <!-- Team 1 -->
      <div class="team-card">
        <div class="team-card-header">
          <div>
            <h3 class="team-card-title">Mufasa Solutions</h3>
            <p class="team-card-leader">Leader: <span>Oscar Vilchis</span></p>
          </div>
          <div class="team-card-actions">
            <button class="btn-icon" type="button" title="Edit">
              <i class="fa-solid fa-pen"></i>
            </button>
            <button class="btn-icon btn-danger" type="button" title="Delete">
              <i class="fa-solid fa-trash"></i>
            </button>
          </div>
        </div>

        <div class="team-members-preview">
          <div class="team-member-row">
            <img src="https://www.shutterstock.com/image-vector/blank-avatar-photo-place-holder-600nw-1095249842.jpg" alt="Francisco Arreola" />
            <span class="team-member-name">Francisco Arreola</span>
            <span class="team-member-role">Full Stack</span>
          </div>
          <div class="team-member-row">
            <img src="https://www.shutterstock.com/image-vector/blank-avatar-photo-place-holder-600nw-1095249842.jpg" alt="Lakshmi Martinez" />
