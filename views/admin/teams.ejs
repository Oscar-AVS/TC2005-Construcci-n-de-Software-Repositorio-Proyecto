<!-- Admin Teams View -->
<h1 id="pageTitle" class="page-title">Teams Management</h1>

<!-- Add Team Card -->
<div class="report-card">
  <div class="report-card-header">
    <h2>Create New Team</h2>
  </div>

  <div class="report-card-body">
    <form action="/admin/teams/create" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <div class="form-row-grid">
        <div class="form-field">
          <label class="form-label" for="teamName">Team Name</label>
          <input type="text" id="teamName" name="team_name" class="form-input" placeholder="Enter team name..." required />
        </div>

        <div class="form-field">
          <label class="form-label" for="teamLeader">Team Leader</label>
          <select id="teamLeader" name="id_leader" class="form-select" required>
            <option value="">Select team leader...</option>
            <% users.forEach(u => { %>
              <option value="<%= u.id_user %>"><%= u.full_name %></option>
            <% }) %>
          </select>
        </div>
      </div>

      <div class="form-row-grid">
        <div class="form-field">
          <label class="form-label" for="teamDescription">Description</label>
          <input type="text" id="teamDescription" name="description" class="form-input" placeholder="Enter team description..." />
        </div>
      </div>

      <div class="action-row">
        <button class="btn-submit" type="submit">
          <i class="fa-solid fa-people-group"></i> Create Team
        </button>
      </div>
    </form>
  </div>
</div>

<!-- Teams Grid -->
<div class="report-card">
  <div class="report-card-header">
    <h2>All Teams</h2>
    <span class="item-count"><%= teams.length %> teams</span>
  </div>

  <div class="report-card-body">
    <div class="teams-grid">
      <% if (teams && teams.length > 0) { %>
        <% teams.forEach(team => { %>
          <div class="team-card">
            <div class="team-card-header">
              <div>
                <h3 class="team-card-title"><%= team.team_name %></h3>
                <p class="team-card-leader">Leader: <span><%= team.leader_name || '—' %></span></p>
              </div>
              <div class="team-card-actions">
                <button
                  class="btn-icon"
                  type="button"
                  title="Edit"
                  onclick="openEditTeamModal(<%= team.id_team %>, '<%= team.team_name %>', '<%= team.description || '' %>', <%= team.leader_id || 'null' %>)"
                >
                  <i class="fa-solid fa-pen"></i>
                </button>
                <button
                  class="btn-icon btn-danger"
                  type="button"
                  title="Delete"
                  onclick="openDeleteTeamModal(<%= team.id_team %>)"
                >
                  <i class="fa-solid fa-trash"></i>
                </button>
              </div>
            </div>

            <div class="team-card-footer">
              <span class="team-stat">
                <i class="fa-solid fa-calendar"></i> <%= team.created_at ? new Date(team.created_at).toLocaleDateString('en-GB') : '—' %>
              </span>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <p>No teams found.</p>
      <% } %>
    </div>
  </div>
</div>

<!-- Edit Team Modal -->
<div
  id="editTeamModal"
  style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.35); z-index: 9999; align-items: center; justify-content: center;"
>
  <div style="background: #fff; width: min(480px, 90vw); border-radius: 18px; padding: 24px; box-shadow: 0 20px 40px rgba(0,0,0,0.18);">
    <h3 style="margin: 0 0 20px 0; font-size: 22px; color: #1f2a44;">Edit Team</h3>

    <form action="/admin/teams/edit" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <input type="hidden" name="id_team" id="editTeamId" />

      <div class="form-field" style="margin-bottom: 12px;">
        <label class="form-label" for="editTeamName">Team Name</label>
        <input type="text" id="editTeamName" name="team_name" class="form-input" required />
      </div>

      <div class="form-field" style="margin-bottom: 12px;">
        <label class="form-label" for="editTeamDescription">Description</label>
        <input type="text" id="editTeamDescription" name="description" class="form-input" />
      </div>

      <div class="form-field" style="margin-bottom: 20px;">
        <label class="form-label" for="editTeamLeader">Team Leader</label>
        <select id="editTeamLeader" name="id_leader" class="form-select" required>
          <option value="">Select team leader...</option>
          <% users.forEach(u => { %>
            <option value="<%= u.id_user %>"><%= u.full_name %></option>
          <% }) %>
        </select>
      </div>

      <div style="display: flex; justify-content: flex-end; gap: 10px;">
        <button type="button" onclick="closeEditTeamModal()" style="display: inline-flex; align-items: center; gap: 8px; border: none; background: #e74c3c; color: #fff; padding: 10px 16px; border-radius: 12px; font-weight: 700; cursor: pointer;">
          <i class="fa-solid fa-xmark"></i> Cancel
        </button>
        <button type="submit" style="display: inline-flex; align-items: center; gap: 8px; border: none; background: #27ae60; color: #fff; padding: 10px 16px; border-radius: 12px; font-weight: 700; cursor: pointer;">
          <i class="fa-solid fa-check"></i> Save
        </button>
      </div>
    </form>
  </div>
</div>

<!-- Delete Team Modal -->
<div
  id="deleteTeamModal"
  style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.35); z-index: 9999; align-items: center; justify-content: center;"
>
  <div style="background: #fff; width: min(400px, 90vw); border-radius: 18px; padding: 24px; box-shadow: 0 20px 40px rgba(0,0,0,0.18); text-align: center;">
    <h3 style="margin: 0 0 10px 0; font-size: 20px; color: #1f2a44;">Delete Team</h3>
    <p style="color: #6b7280; margin-bottom: 24px; font-size: 14px;">Are you sure you want to delete this team? This action cannot be undone.</p>

    <form action="/admin/teams/delete" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <input type="hidden" name="id_team" id="deleteTeamId" />
      <div style="display: flex; justify-content: center; gap: 10px;">
        <button type="button" onclick="closeDeleteTeamModal()" style="display: inline-flex; align-items: center; gap: 8px; border: none; background: #e5e7eb; color: #374151; padding: 10px 16px; border-radius: 12px; font-weight: 700; cursor: pointer;">
          <i class="fa-solid fa-xmark"></i> Cancel
        </button>
        <button type="submit" style="display: inline-flex; align-items: center; gap: 8px; border: none; background: #e74c3c; color: #fff; padding: 10px 16px; border-radius: 12px; font-weight: 700; cursor: pointer;">
          <i class="fa-solid fa-trash"></i> Delete
        </button>
      </div>
    </form>
  </div>
</div>

<script src="/js/modules/teams.js"></script>