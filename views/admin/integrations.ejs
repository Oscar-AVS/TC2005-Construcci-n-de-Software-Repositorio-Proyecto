<!-- Admin Integrations View -->
<h1 id="pageTitle" class="page-title">Integrations</h1>

<!-- Integrations Grid -->
<div class="report-card">
  <div class="report-card-header">
    <h2>Available Integrations</h2>
    <span class="item-count">2 integrations</span>
  </div>

  <div class="report-card-body">
    <div class="integrations-grid">

      <!-- Slack -->
      <div class="integration-card connected">
        <div class="integration-header">
          <div class="integration-info">
            <div class="integration-icon slack">
              <i class="fa-brands fa-slack"></i>
            </div>
            <div>
              <h3 class="integration-name">Slack</h3>
              <span class="integration-status connected">
                <i class="fa-solid fa-circle"></i> Connected
              </span>
            </div>
          </div>
        </div>

        <p class="integration-desc">Sync daily logs and receive notifications directly in Slack channels. Enable team collaboration with automatic updates.</p>

        <div class="integration-actions">
          <button class="btn-configure" type="button">
            <i class="fa-solid fa-gear"></i> Configure
          </button>
          <button class="btn-disconnect" type="button">
            <i class="fa-solid fa-plug-circle-xmark"></i> Disconnect
          </button>
        </div>
      </div>

      <!-- GitHub -->
      <div class="integration-card connected">
        <div class="integration-header">
          <div class="integration-info">
            <div class="integration-icon github">
              <i class="fa-brands fa-github"></i>
            </div>
            <div>
              <h3 class="integration-name">GitHub</h3>
              <span class="integration-status connected">
                <i class="fa-solid fa-circle"></i> Connected
              </span>
            </div>
          </div>
        </div>

        <p class="integration-desc">Link commits and pull requests to daily logs. Automatically track development activity and code contributions.</p>

        <div class="integration-actions">
          <button class="btn-configure" type="button">
            <i class="fa-solid fa-gear"></i> Configure
          </button>
          <button class="btn-disconnect" type="button">
            <i class="fa-solid fa-plug-circle-xmark"></i> Disconnect
          </button>
        </div>
      </div>

    </div>
  </div>
</div>