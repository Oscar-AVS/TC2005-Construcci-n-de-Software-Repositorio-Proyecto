<!-- Admin Users View -->
<h1 id="pageTitle" class="page-title">Users Management</h1>

<!-- Add User Card -->
<div class="report-card">
  <div class="report-card-header">
    <h2>Add New User</h2>
  </div>
  <div class="report-card-body">
    <form action="/admin/users/create" method="POST">
      <div class="form-row-grid">
        <div class="form-field">
          <label class="form-label" for="userName">Full Name</label>
          <input type="text" id="userName" name="full_name" class="form-input" placeholder="Enter full name..." required />
        </div>
        <div class="form-field">
          <label class="form-label" for="userEmail">Email</label>
          <input type="email" id="userEmail" name="email" class="form-input" placeholder="email@change.org" required />
        </div>
      </div>
      <div class="form-row-grid">
        <div class="form-field">
          <label class="form-label" for="userUsername">Username</label>
          <input type="text" id="userUsername" name="username" class="form-input" placeholder="username" required />
        </div>
        <div class="form-field">
          <label class="form-label" for="userPassword">Password</label>
          <input type="password" id="userPassword" name="password" class="form-input" placeholder="••••••••" required />
        </div>
      </div>
      <div class="form-row-grid">
        <div class="form-field">
          <label class="form-label" for="userRole">Role</label>
          <select id="userRole" name="id_role" class="form-select" required>
            <option value="">Select role...</option>
            <% roles.forEach(r => { %>
              <option value="<%= r.id_role %>"><%= r.role_name %></option>
            <% }) %>
          </select>
        </div>
      </div>
      <div class="action-row">
        <button class="btn-submit" type="submit">
          <i class="fa-solid fa-user-plus"></i> Create User
        </button>
      </div>
    </form>
  </div>
</div>

<!-- Users Table -->
<div class="report-card users-table-card">
  <div class="report-card-header">
    <h2>All Users</h2>
    <span class="item-count"><%= users.length %> users</span>
  </div>

  <div class="report-card-body" style="padding: 0;">
    <table class="users-table">
      <thead>
        <tr>
          <th>User</th>
          <th>Role</th>
          <th>Team</th>
          <th>Status</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% users.forEach(user => { %>
        <tr id="user-row-<%= user.id %>">
          <td>
            <div class="user-cell">
              <img
                src="https://www.shutterstock.com/image-vector/blank-avatar-photo-place-holder-600nw-1095249842.jpg"
                alt="<%= user.full_name %>"
              />
              <div class="user-cell-info">
                <span class="user-cell-name"><%= user.full_name %></span>
                <span class="user-cell-email"><%= user.email %></span>
              </div>
            </div>
          </td>
          <td>
            <span class="role-badge <%= user.role %>"><%= user.role %></span>
          </td>
          <td><%= user.team || '—' %></td>
          <td>
            <span
              id="status-badge-<%= user.id %>"
              class="status-badge <%= user.is_active ? 'active' : 'inactive' %>"
            >
              <%= user.is_active ? 'Active' : 'Inactive' %>
            </span>
          </td>
          <td>
            <div class="table-actions">
              <button class="btn-icon" type="button" title="Edit">
                <i class="fa-solid fa-pen"></i>
              </button>
              <button class="btn-icon" type="button" title="Reset Password">
                <i class="fa-solid fa-key"></i>
              </button>
              <button
                class="btn-icon <%= user.is_active ? 'btn-danger' : '' %>"
                type="button"
                title="<%= user.is_active ? 'Deactivate' : 'Activate' %>"
                onclick="toggleStatus(<%= user.id %>, <%= user.is_active %>)"
                id="toggle-btn-<%= user.id %>"
              >
                <i
                  id="toggle-icon-<%= user.id %>"
                  class="fa-solid <%= user.is_active ? 'fa-user-slash' : 'fa-user-check' %>"
                ></i>
              </button>
            </div>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<script>
  async function toggleStatus(userId, currentStatus) {
    const confirmed = confirm(
      currentStatus
        ? 'Are you sure you want to deactivate this account?'
        : 'Do you want to reactivate this account?'
    );
    if (!confirmed) return;

    try {
      const res = await fetch(`/admin/users/${userId}/toggle-status`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
      });

      const data = await res.json();

      if (res.status === 404) {
        alert('User not found. Refreshing list...');
        location.reload();
        return;
      }

      if (!res.ok || !data.success) {
        alert('Something went wrong. No changes were made.');
        return;
      }

      const isNowActive = data.is_active === 1;

      const badge = document.getElementById(`status-badge-${userId}`);
      badge.textContent = isNowActive ? 'Active' : 'Inactive';
      badge.className = `status-badge ${isNowActive ? 'active' : 'inactive'}`;

      const btn = document.getElementById(`toggle-btn-${userId}`);
      btn.title = isNowActive ? 'Deactivate' : 'Activate';
      btn.className = `btn-icon ${isNowActive ? 'btn-danger' : ''}`;

      const icon = document.getElementById(`toggle-icon-${userId}`);
      icon.className = `fa-solid ${isNowActive ? 'fa-user-slash' : 'fa-user-check'}`;

      btn.setAttribute('onclick', `toggleStatus(${userId}, ${isNowActive ? 1 : 0})`);

    } catch (err) {
      console.error('toggleStatus error:', err);
      alert('Connection error. Please try again.');
    }
  }
</script>