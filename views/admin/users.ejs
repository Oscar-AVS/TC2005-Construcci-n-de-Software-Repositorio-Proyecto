<!-- Admin Users View -->
<meta name="csrf-token" content="<%= csrfToken %>" />
<h1 id="pageTitle" class="page-title">Users Management</h1>

<!-- Add User Card -->
<div class="report-card">
  <div class="report-card-header">
    <h2>Add New User</h2>
  </div>
  <div class="report-card-body">
    <div id="createUserError" style="display: none; background: #fee2e2; color: #e74c3c; border: 1px solid #fca5a5; border-radius: 10px; padding: 12px 16px; font-size: 14px; margin-bottom: 16px;">
      <i class="fa-solid fa-circle-exclamation" style="margin-right: 6px;"></i>
      <span id="createUserErrorText"></span>
    </div>
    <form action="/admin/users/create" method="POST" id="createUserForm">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <div class="form-row-grid">
        <div class="form-field">
          <label class="form-label" for="userName">Full Name</label>
          <input type="text" id="userName" name="full_name" class="form-input" placeholder="Enter full name..." />
        </div>
        <div class="form-field">
          <label class="form-label" for="userEmail">Email</label>
          <input type="text" id="userEmail" name="email" class="form-input" placeholder="email@change.org" />
        </div>
      </div>
      <div class="form-row-grid">
        <div class="form-field">
          <label class="form-label" for="userPassword">Password</label>
          <input type="password" id="userPassword" name="password" class="form-input" placeholder="••••••••" />
        </div>
        <div class="form-field">
          <label class="form-label" for="userRole">Role</label>
          <select id="userRole" name="id_role" class="form-select">
            <option value="">Select role...</option>
            <% roles.forEach(r => { %>
              <option value="<%= r.id_role %>"><%= r.role_name %></option>
            <% }) %>
          </select>
        </div>
      </div>
      <div class="action-row">
        <button class="btn-submit" type="button" onclick="validateCreateUser()">
          <i class="fa-solid fa-user-plus"></i> Create User
        </button>
      </div>
    </form>
  </div>
</div>

<!-- Pending Approval -->
<% if (pending && pending.length > 0) { %>
<div class="report-card" style="border-left: 4px solid #e74c3c; margin-top: 24px;">
  <div class="report-card-header">
    <h2 style="color: #e74c3c;"><i class="fa-solid fa-clock"></i> Pending Approval</h2>
    <span class="item-count"><%= pending.length %> pending</span>
  </div>
  <div class="report-card-body" style="padding: 0;">
    <table class="users-table">
      <thead>
        <tr>
          <th>User</th>
          <th>Status</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% pending.forEach(user => { %>
        <tr>
          <td>
            <div class="user-cell">
              <div style="width: 38px; height: 38px; border-radius: 50%; background: #fb0202; display: flex; align-items: center; justify-content: center; color: #fff; font-weight: 700; font-size: 15px; flex-shrink: 0;">
                <%= user.full_name.charAt(0).toUpperCase() %>
              </div>
              <div class="user-cell-info">
                <span class="user-cell-name"><%= user.full_name %></span>
                <span class="user-cell-email"><%= user.email %></span>
              </div>
            </div>
          </td>
          <td>
            <span class="status-badge" style="background: #fff7ed; color: #c2410c; border: 1px solid #fed7aa;">
              Pending
            </span>
          </td>
          <td>
            <div class="table-actions">
              <button class="btn-icon" type="button" title="Approve" style="color: #27ae60;"
                onclick="openApproveModal('<%= user.id_user %>', '<%= user.full_name %>')">
                <i class="fa-solid fa-user-check"></i>
              </button>
              <button class="btn-icon btn-danger" type="button" title="Reject"
                onclick="openRejectModal('<%= user.id_user %>', '<%= user.full_name %>')">
                <i class="fa-solid fa-user-xmark"></i>
              </button>
            </div>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
<% } %>

<!-- Users Table -->
<div class="report-card users-table-card" style="margin-top: 24px;">
  <div class="report-card-header" style="flex-wrap: wrap; gap: 12px;">
    <h2>All Users</h2>
    <div style="display: flex; align-items: center; gap: 12px; flex-wrap: wrap;">
      <input
        type="text"
        id="userSearchInput"
        class="form-input"
        placeholder="Search by name, email or role..."
        autocomplete="off"
        style="min-width: 240px;"
      />
      <span class="item-count" id="usersCountLabel"><%= users.length %> users</span>
    </div>
  </div>
  <div class="report-card-body" style="padding: 0;">
    <table class="users-table">
      <thead>
        <tr>
          <th>User</th>
          <th>Role</th>
          <th>Team</th>
          <th>Status</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% users.forEach(user => { %>
        <tr id="user-row-<%= user.id %>">
          <td>
            <div class="user-cell">
              <div style="width: 38px; height: 38px; border-radius: 50%; background: #fb0202; display: flex; align-items: center; justify-content: center; color: #fff; font-weight: 700; font-size: 15px; flex-shrink: 0;">
                <%= user.full_name.charAt(0).toUpperCase() %>
              </div>
              <div class="user-cell-info">
                <span class="user-cell-name"><%= user.full_name %></span>
                <span class="user-cell-email"><%= user.email %></span>
              </div>
            </div>
          </td>
          <td><span class="role-badge <%= user.role %>"><%= user.role %></span></td>
          <td>
            <% if (user.team) { %>
              <div style="display: flex; flex-wrap: wrap; gap: 6px;">
                <% user.team.split('||').forEach(t => { %>
                  <span style="display: inline-flex; align-items: center; gap: 5px; background: #eef2ff; color: #4338ca; border: 1px solid #c7d2fe; border-radius: 8px; padding: 4px 10px; font-size: 12px; font-weight: 600;">
                    <i class="fa-solid fa-users" style="font-size: 10px; opacity: 0.7;"></i>
                    <%= t.trim() %>
                  </span>
                <% }) %>
              </div>
            <% } else { %>
              <span style="color: #9ca3af; font-size: 13px; font-style: italic;">No team</span>
            <% } %>
          </td>
          <td>
            <span id="status-badge-<%= user.id %>" class="status-badge <%= user.is_active ? 'active' : 'inactive' %>">
              <%= user.is_active ? 'Active' : 'Inactive' %>
            </span>
          </td>
          <td>
            <div class="table-actions">
              <button class="btn-icon" type="button" title="Edit"
                onclick="openEditModal(<%= user.id %>, '<%= user.full_name %>', '<%= user.email %>', <%= user.id_role %>)">
                <i class="fa-solid fa-pen"></i>
              </button>
              <button
                class="btn-icon <%= user.is_active ? 'btn-danger' : '' %>"
                type="button"
                title="<%= user.is_active ? 'Deactivate' : 'Activate' %>"
                onclick="openToggleModal(<%= user.id %>, <%= user.is_active %>, '<%= user.full_name %>')"
                id="toggle-btn-<%= user.id %>"
              >
                <i id="toggle-icon-<%= user.id %>" class="fa-solid <%= user.is_active ? 'fa-user-slash' : 'fa-user-check' %>"></i>
              </button>
              <button class="btn-icon btn-danger" type="button" title="Delete"
                onclick="openDeleteUserModal(<%= user.id %>, '<%= user.full_name %>')">
                <i class="fa-solid fa-trash"></i>
              </button>
            </div>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
    <div id="users-pagination" style="display: none; align-items: center; justify-content: center; gap: 12px; padding: 16px 24px; border-top: 1px solid #f3f4f6;">
      <button id="users-prev" style="border: 1px solid #e5e7eb; background: #fff; color: #374151; padding: 6px 14px; border-radius: 8px; font-size: 13px; font-weight: 600; cursor: pointer;">&#8592; Prev</button>
      <span id="users-page-info" style="font-size: 13px; color: #5f6b85; font-weight: 600;"></span>
      <button id="users-next" style="border: 1px solid #e5e7eb; background: #fff; color: #374151; padding: 6px 14px; border-radius: 8px; font-size: 13px; font-weight: 600; cursor: pointer;">Next &#8594;</button>
    </div>
  </div>
</div>

<!-- Approve Modal -->
<div id="approveModal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.4); backdrop-filter: blur(4px); z-index: 9999; align-items: center; justify-content: center;">
  <div style="background: #fff; width: min(420px, 90vw); border-radius: 20px; padding: 32px; box-shadow: 0 24px 48px rgba(0,0,0,0.2); text-align: center;">
    <div style="width: 56px; height: 56px; border-radius: 50%; background: #dcfce7; display: flex; align-items: center; justify-content: center; margin: 0 auto 16px; font-size: 24px; color: #27ae60;">
      <i class="fa-solid fa-user-check"></i>
    </div>
    <h3 style="margin: 0 0 8px 0; font-size: 22px; color: #1f2a44;">Approve account</h3>
    <p id="approveModalText" style="color: #5f6b85; margin-bottom: 28px; font-size: 14px; line-height: 1.5;"></p>
    <form action="/admin/users/approve" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <input type="hidden" name="id_user" id="approveUserId" />
      <div style="display: flex; justify-content: center; gap: 12px;">
        <button type="button" onclick="closeApproveModal()" style="display: inline-flex; align-items: center; gap: 8px; border: none; background: #f1f5f9; color: #374151; padding: 12px 24px; border-radius: 12px; font-weight: 700; cursor: pointer; font-size: 14px;">
          <i class="fa-solid fa-xmark"></i> Cancel
        </button>
        <button type="submit" style="display: inline-flex; align-items: center; gap: 8px; border: none; background: #27ae60; color: #fff; padding: 12px 24px; border-radius: 12px; font-weight: 700; cursor: pointer; font-size: 14px;">
          <i class="fa-solid fa-check"></i> Approve
        </button>
      </div>
    </form>
  </div>
</div>

<!-- Reject Modal -->
<div id="rejectModal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.4); backdrop-filter: blur(4px); z-index: 9999; align-items: center; justify-content: center;">
  <div style="background: #fff; width: min(420px, 90vw); border-radius: 20px; padding: 32px; box-shadow: 0 24px 48px rgba(0,0,0,0.2); text-align: center;">
    <div style="width: 56px; height: 56px; border-radius: 50%; background: #fee2e2; display: flex; align-items: center; justify-content: center; margin: 0 auto 16px; font-size: 24px; color: #e74c3c;">
      <i class="fa-solid fa-user-xmark"></i>
    </div>
    <h3 style="margin: 0 0 8px 0; font-size: 22px; color: #1f2a44;">Reject account</h3>
    <p id="rejectModalText" style="color: #5f6b85; margin-bottom: 28px; font-size: 14px; line-height: 1.5;"></p>
    <form action="/admin/users/reject" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <input type="hidden" name="id_user" id="rejectUserId" />
      <div style="display: flex; justify-content: center; gap: 12px;">
        <button type="button" onclick="closeRejectModal()" style="display: inline-flex; align-items: center; gap: 8px; border: none; background: #f1f5f9; color: #374151; padding: 12px 24px; border-radius: 12px; font-weight: 700; cursor: pointer; font-size: 14px;">
          <i class="fa-solid fa-xmark"></i> Cancel
        </button>
        <button type="submit" style="display: inline-flex; align-items: center; gap: 8px; border: none; background: #e74c3c; color: #fff; padding: 12px 24px; border-radius: 12px; font-weight: 700; cursor: pointer; font-size: 14px;">
          <i class="fa-solid fa-user-xmark"></i> Reject
        </button>
      </div>
    </form>
  </div>
</div>

<!-- Edit User Modal -->
<div id="editUserModal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.4); backdrop-filter: blur(4px); z-index: 9999; align-items: center; justify-content: center;">
  <div style="background: #fff; width: min(480px, 90vw); border-radius: 20px; padding: 32px; box-shadow: 0 24px 48px rgba(0,0,0,0.2);">
    <h3 style="margin: 0 0 20px 0; font-size: 22px; color: #1f2a44;">Edit User</h3>
    <div id="editUserError" style="display: none; background: #fee2e2; color: #e74c3c; border: 1px solid #fca5a5; border-radius: 10px; padding: 12px 16px; font-size: 14px; margin-bottom: 16px;">
      <i class="fa-solid fa-circle-exclamation" style="margin-right: 6px;"></i>
      <span id="editUserErrorText"></span>
    </div>
    <form action="/admin/users/edit" method="POST" id="editUserForm">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <input type="hidden" name="id_user" id="editUserId" />
      <div class="form-field" style="margin-bottom: 12px;">
        <label class="form-label" for="editFullName">Full Name</label>
        <input type="text" id="editFullName" name="full_name" class="form-input" />
      </div>
      <div class="form-field" style="margin-bottom: 12px;">
        <label class="form-label" for="editEmail">Email</label>
        <input type="text" id="editEmail" name="email" class="form-input" />
      </div>
      <div class="form-field" style="margin-bottom: 24px;">
        <label class="form-label" for="editRole">Role</label>
        <select id="editRole" name="id_role" class="form-select">
          <% roles.forEach(r => { %>
            <option value="<%= r.id_role %>"><%= r.role_name %></option>
          <% }) %>
        </select>
      </div>
      <div style="display: flex; justify-content: flex-end; gap: 10px;">
        <button type="button" onclick="closeEditModal()" style="display: inline-flex; align-items: center; gap: 8px; border: none; background: #f1f5f9; color: #374151; padding: 12px 20px; border-radius: 12px; font-weight: 700; cursor: pointer; font-size: 14px;">
          <i class="fa-solid fa-xmark"></i> Cancel
        </button>
        <button type="button" onclick="validateEditUser()" style="display: inline-flex; align-items: center; gap: 8px; border: none; background: #f25c2a; color: #fff; padding: 12px 20px; border-radius: 12px; font-weight: 700; cursor: pointer; font-size: 14px;">
          <i class="fa-solid fa-check"></i> Save Changes
        </button>
      </div>
    </form>
  </div>
</div>

<!-- Toggle Status Modal -->
<div id="toggleStatusModal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.4); backdrop-filter: blur(4px); z-index: 9999; align-items: center; justify-content: center;">
  <div style="background: #fff; width: min(420px, 90vw); border-radius: 20px; padding: 32px; box-shadow: 0 24px 48px rgba(0,0,0,0.2); text-align: center;">
    <div id="toggleModalIcon" style="width: 56px; height: 56px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 16px; font-size: 24px;"></div>
    <h3 id="toggleModalTitle" style="margin: 0 0 8px 0; font-size: 22px; color: #1f2a44;"></h3>
    <p id="toggleModalText" style="margin: 0 0 28px 0; color: #5f6b85; line-height: 1.5; font-size: 14px;"></p>
    <div style="display: flex; justify-content: center; gap: 12px;">
      <button type="button" id="cancelToggleBtn" style="display: inline-flex; align-items: center; gap: 8px; border: none; background: #f1f5f9; color: #374151; padding: 12px 24px; border-radius: 12px; font-weight: 700; cursor: pointer; font-size: 14px;">
        <i class="fa-solid fa-xmark"></i> Cancel
      </button>
      <button type="button" id="confirmToggleBtn" style="display: inline-flex; align-items: center; gap: 8px; border: none; padding: 12px 24px; border-radius: 12px; font-weight: 700; cursor: pointer; font-size: 14px;">
        <i class="fa-solid fa-check"></i> Confirm
      </button>
    </div>
  </div>
</div>

<!-- Delete User Modal -->
<div id="deleteUserModal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.4); backdrop-filter: blur(4px); z-index: 9999; align-items: center; justify-content: center;">
  <div style="background: #fff; width: min(420px, 90vw); border-radius: 20px; padding: 32px; box-shadow: 0 24px 48px rgba(0,0,0,0.2); text-align: center;">
    <div style="width: 56px; height: 56px; border-radius: 50%; background: #fee2e2; display: flex; align-items: center; justify-content: center; margin: 0 auto 16px; font-size: 24px; color: #e74c3c;">
      <i class="fa-solid fa-trash"></i>
    </div>
    <h3 style="margin: 0 0 8px 0; font-size: 22px; color: #1f2a44;">Delete User</h3>
    <p id="deleteUserText" style="color: #5f6b85; margin-bottom: 28px; font-size: 14px; line-height: 1.5;"></p>
    <form action="/admin/users/delete" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <input type="hidden" name="id_user" id="deleteUserId" />
      <div style="display: flex; justify-content: center; gap: 12px;">
        <button type="button" onclick="closeDeleteUserModal()" style="display: inline-flex; align-items: center; gap: 8px; border: none; background: #f1f5f9; color: #374151; padding: 12px 24px; border-radius: 12px; font-weight: 700; cursor: pointer; font-size: 14px;">
          <i class="fa-solid fa-xmark"></i> Cancel
        </button>
        <button type="submit" style="display: inline-flex; align-items: center; gap: 8px; border: none; background: #e74c3c; color: #fff; padding: 12px 24px; border-radius: 12px; font-weight: 700; cursor: pointer; font-size: 14px;">
          <i class="fa-solid fa-trash"></i> Delete
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  const csrfToken = document.querySelector('meta[name="csrf-token"]').content;
  let pendingToggleUserId = null;
  let pendingToggleStatus = null;

  function showCreateError(msg) {
    const box = document.getElementById('createUserError');
    document.getElementById('createUserErrorText').textContent = msg;
    box.style.display = 'block';
    box.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }

  function validateCreateUser() {
  const fullName = document.getElementById('userName').value.trim();
  const email = document.getElementById('userEmail').value.trim();
  const password = document.getElementById('userPassword').value.trim();
  const role = document.getElementById('userRole').value;

  document.getElementById('createUserError').style.display = 'none';

  if (!fullName) return showCreateError('Full name is required.');
  if (!/^[a-zA-ZáéíóúÁÉÍÓÚñÑüÜ\s]+$/.test(fullName)) return showCreateError('Full name must contain letters only, no numbers.');
  if (fullName.split(' ').filter(w => w).length < 2) return showCreateError('Please enter first and last name.');
  if (!email) return showCreateError('Email is required.');
  if (!email.includes('@')) return showCreateError('Please enter a valid email address.');
  if (!password) return showCreateError('Password is required.');
  if (!role) return showCreateError('Please select a role.');

  document.getElementById('createUserForm').submit();
}

  function showEditError(msg) {
    const box = document.getElementById('editUserError');
    document.getElementById('editUserErrorText').textContent = msg;
    box.style.display = 'block';
  }

  function validateEditUser() {
    const fullName = document.getElementById('editFullName').value.trim();
    const email = document.getElementById('editEmail').value.trim();

    document.getElementById('editUserError').style.display = 'none';

    if (!fullName) return showEditError('Full name is required.');
    if (!/^[a-zA-ZáéíóúÁÉÍÓÚñÑüÜ\s]+$/.test(fullName)) return showEditError('Full name must contain letters only.');
    if (fullName.split(' ').filter(w => w).length < 2) return showEditError('Please enter full name (first and last name).');

    document.getElementById('editUserForm').submit();
  }

  function openApproveModal(id, fullName) {
    document.getElementById('approveUserId').value = id;
    document.getElementById('approveModalText').textContent = `Are you sure you want to approve ${fullName}'s account? They will be able to log in.`;
    document.getElementById('approveModal').style.display = 'flex';
  }

  function closeApproveModal() {
    document.getElementById('approveModal').style.display = 'none';
  }

  document.getElementById('approveModal').addEventListener('click', (e) => {
    if (e.target === document.getElementById('approveModal')) closeApproveModal();
  });

  function openRejectModal(id, fullName) {
    document.getElementById('rejectUserId').value = id;
    document.getElementById('rejectModalText').textContent = `Are you sure you want to reject ${fullName}'s account? This action cannot be undone.`;
    document.getElementById('rejectModal').style.display = 'flex';
  }

  function closeRejectModal() {
    document.getElementById('rejectModal').style.display = 'none';
  }

  document.getElementById('rejectModal').addEventListener('click', (e) => {
    if (e.target === document.getElementById('rejectModal')) closeRejectModal();
  });

  function openToggleModal(userId, currentStatus, fullName) {
    pendingToggleUserId = userId;
    pendingToggleStatus = currentStatus;

    const icon = document.getElementById('toggleModalIcon');
    const title = document.getElementById('toggleModalTitle');
    const text = document.getElementById('toggleModalText');
    const confirmBtn = document.getElementById('confirmToggleBtn');

    if (currentStatus) {
      icon.style.background = '#fee2e2';
      icon.style.color = '#e74c3c';
      icon.innerHTML = '<i class="fa-solid fa-user-slash"></i>';
      title.textContent = 'Deactivate account';
      text.textContent = `Are you sure you want to deactivate ${fullName}'s account? They will no longer be able to log in.`;
      confirmBtn.style.background = '#e74c3c';
      confirmBtn.style.color = '#fff';
    } else {
      icon.style.background = '#dcfce7';
      icon.style.color = '#27ae60';
      icon.innerHTML = '<i class="fa-solid fa-user-check"></i>';
      title.textContent = 'Activate account';
      text.textContent = `Do you want to reactivate ${fullName}'s account? They will be able to log in again.`;
      confirmBtn.style.background = '#27ae60';
      confirmBtn.style.color = '#fff';
    }

    document.getElementById('toggleStatusModal').style.display = 'flex';
  }

  document.getElementById('cancelToggleBtn').addEventListener('click', () => {
    pendingToggleUserId = null;
    pendingToggleStatus = null;
    document.getElementById('toggleStatusModal').style.display = 'none';
  });

  document.getElementById('confirmToggleBtn').addEventListener('click', async () => {
    document.getElementById('toggleStatusModal').style.display = 'none';

    try {
      const res = await fetch(`/admin/users/${pendingToggleUserId}/toggle-status`, {
        method: 'PATCH',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': csrfToken,
        },
      });

      if (res.redirected || !res.ok) {
        location.reload();
        return;
      }

      const data = await res.json();

      if (!data.success) {
        location.reload();
        return;
      }

      const isNowActive = data.is_active === 1;

      const badge = document.getElementById(`status-badge-${pendingToggleUserId}`);
      badge.textContent = isNowActive ? 'Active' : 'Inactive';
      badge.className = `status-badge ${isNowActive ? 'active' : 'inactive'}`;

      const btn = document.getElementById(`toggle-btn-${pendingToggleUserId}`);
      btn.title = isNowActive ? 'Deactivate' : 'Activate';
      btn.className = `btn-icon ${isNowActive ? 'btn-danger' : ''}`;

      const icon = document.getElementById(`toggle-icon-${pendingToggleUserId}`);
      icon.className = `fa-solid ${isNowActive ? 'fa-user-slash' : 'fa-user-check'}`;

      btn.setAttribute('onclick', `openToggleModal(${pendingToggleUserId}, ${isNowActive ? 1 : 0}, '${btn.getAttribute('data-name')}')`);
    } catch (err) {
      console.error('toggleStatus error:', err);
      location.reload();
    }
  });

  document.getElementById('toggleStatusModal').addEventListener('click', (e) => {
    if (e.target === document.getElementById('toggleStatusModal')) {
      pendingToggleUserId = null;
      pendingToggleStatus = null;
      document.getElementById('toggleStatusModal').style.display = 'none';
    }
  });

  function openEditModal(id, fullName, email, idRole) {
    document.getElementById('editUserId').value = id;
    document.getElementById('editFullName').value = fullName;
    document.getElementById('editEmail').value = email;
    document.getElementById('editRole').value = idRole;
    document.getElementById('editUserError').style.display = 'none';
    document.getElementById('editUserModal').style.display = 'flex';
  }

  function closeEditModal() {
    document.getElementById('editUserModal').style.display = 'none';
  }

  document.getElementById('editUserModal').addEventListener('click', (e) => {
    if (e.target === document.getElementById('editUserModal')) closeEditModal();
  });

  function openDeleteUserModal(id, fullName) {
    document.getElementById('deleteUserId').value = id;
    document.getElementById('deleteUserText').textContent = `Are you sure you want to delete ${fullName}? This action cannot be undone.`;
    document.getElementById('deleteUserModal').style.display = 'flex';
  }

  function closeDeleteUserModal() {
    document.getElementById('deleteUserModal').style.display = 'none';
  }

  document.getElementById('deleteUserModal').addEventListener('click', (e) => {
    if (e.target === document.getElementById('deleteUserModal')) closeDeleteUserModal();
  });

  (function () {
    var PER_PAGE = 10;
    var tbody = document.querySelector('.users-table-card tbody');
    if (!tbody) return;

    var allRows = Array.from(tbody.querySelectorAll('tr'));
    var pagination = document.getElementById('users-pagination');
    var prevBtn = document.getElementById('users-prev');
    var nextBtn = document.getElementById('users-next');
    var info = document.getElementById('users-page-info');
    var countLabel = document.getElementById('usersCountLabel');
    var searchInput = document.getElementById('userSearchInput');
    var activeRows = allRows;
    var page = 1;
    var searchTimeout;

    function render() {
      var totalPages = Math.max(1, Math.ceil(activeRows.length / PER_PAGE));
      if (page > totalPages) page = 1;

      allRows.forEach(function (row) { row.style.display = 'none'; });
      activeRows.slice((page - 1) * PER_PAGE, page * PER_PAGE).forEach(function (row) {
        row.style.display = '';
      });

      if (activeRows.length <= PER_PAGE) {
        pagination.style.display = 'none';
      } else {
        pagination.style.display = 'flex';
        info.textContent = 'Page ' + page + ' of ' + totalPages;
        prevBtn.style.opacity = page === 1 ? '0.4' : '1';
        prevBtn.style.cursor = page === 1 ? 'default' : 'pointer';
        nextBtn.style.opacity = page === totalPages ? '0.4' : '1';
        nextBtn.style.cursor = page === totalPages ? 'default' : 'pointer';
      }

      if (countLabel) {
        countLabel.textContent = activeRows.length + ' user' + (activeRows.length !== 1 ? 's' : '');
      }
    }

    if (searchInput) {
      searchInput.addEventListener('input', function () {
        clearTimeout(searchTimeout);
        searchTimeout = setTimeout(function () {
          var query = searchInput.value.trim().toLowerCase();
          activeRows = query
            ? allRows.filter(function (row) { return row.textContent.toLowerCase().includes(query); })
            : allRows;
          page = 1;
          render();
        }, 250);
      });
    }

    prevBtn.addEventListener('click', function () { if (page > 1) { page--; render(); } });
    nextBtn.addEventListener('click', function () {
      if (page < Math.ceil(activeRows.length / PER_PAGE)) { page++; render(); }
    });

    render();
  })();
</script>