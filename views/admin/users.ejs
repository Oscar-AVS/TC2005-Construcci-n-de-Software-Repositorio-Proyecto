<!-- Admin Users View -->
<h1 id="pageTitle" class="page-title">Users Management</h1>

<!-- Add User Card -->
<div class="report-card">
  <div class="report-card-header">
    <h2>Add New User</h2>
  </div>
  <div class="report-card-body">
    <form action="/admin/users/create" method="POST">
      <div class="form-row-grid">
        <div class="form-field">
          <label class="form-label" for="userName">Full Name</label>
          <input type="text" id="userName" name="full_name" class="form-input" placeholder="Enter full name..." required />
        </div>
        <div class="form-field">
          <label class="form-label" for="userEmail">Email</label>
          <input type="email" id="userEmail" name="email" class="form-input" placeholder="email@change.org" required />
        </div>
      </div>
      <div class="form-row-grid">
        <div class="form-field">
          <label class="form-label" for="userUsername">Username</label>
          <input type="text" id="userUsername" name="username" class="form-input" placeholder="username" required />
        </div>
        <div class="form-field">
          <label class="form-label" for="userPassword">Password</label>
          <input type="password" id="userPassword" name="password" class="form-input" placeholder="••••••••" required />
        </div>
      </div>
      <div class="form-row-grid">
        <div class="form-field">
          <label class="form-label" for="userRole">Role</label>
          <select id="userRole" name="id_role" class="form-select" required>
            <option value="">Select role...</option>
            <% roles.forEach(r => { %>
              <option value="<%= r.id_role %>"><%= r.role_name %></option>
            <% }) %>
          </select>
        </div>
      </div>
      <div class="action-row">
        <button class="btn-submit" type="submit">
          <i class="fa-solid fa-user-plus"></i> Create User
        </button>
      </div>
    </form>
  </div>
</div>

<!-- Users Table -->
<div class="report-card users-table-card">
  <div class="report-card-header">
    <h2>All Users</h2>
    <span class="item-count"><%= users.length %> users</span>
  </div>

  <div class="report-card-body" style="padding: 0;">
    <table class="users-table">
      <thead>
        <tr>
          <th>User</th>
          <th>Role</th>
          <th>Team</th>
          <th>Status</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% users.forEach(user => { %>
        <tr id="user-row-<%= user.id %>">
          <td>
            <div class="user-cell">
              <img
                src="https://www.shutterstock.com/image-vector/blank-avatar-photo-place-holder-600nw-1095249842.jpg"
                alt="<%= user.full_name %>"
              />
              <div class="user-cell-info">
                <span class="user-cell-name"><%= user.full_name %></span>
                <span class="user-cell-email"><%= user.email %></span>
              </div>
            </div>
          </td>
          <td>
            <span class="role-badge <%= user.role %>"><%= user.role %></span>
          </td>
          <td><%= user.team || '—' %></td>
          <td>
            <span
              id="status-badge-<%= user.id %>"
              class="status-badge <%= user.is_active ? 'active' : 'inactive' %>"
            >
              <%= user.is_active ? 'Active' : 'Inactive' %>
            </span>
          </td>
          <td>
            <div class="table-actions">
              <button
                class="btn-icon"
                type="button"
                title="Edit"
                onclick="openEditModal(<%= user.id %>, '<%= user.full_name %>', '<%= user.email %>', '<%= user.username %>', <%= user.id_role %>)"
              >
                <i class="fa-solid fa-pen"></i>
              </button>
              <button class="btn-icon" type="button" title="Reset Password">
                <i class="fa-solid fa-key"></i>
              </button>
              <button
                class="btn-icon <%= user.is_active ? 'btn-danger' : '' %>"
                type="button"
                title="<%= user.is_active ? 'Deactivate' : 'Activate' %>"
                onclick="openToggleModal(<%= user.id %>, <%= user.is_active %>)"
                id="toggle-btn-<%= user.id %>"
              >
                <i
                  id="toggle-icon-<%= user.id %>"
                  class="fa-solid <%= user.is_active ? 'fa-user-slash' : 'fa-user-check' %>"
                ></i>
              </button>
            </div>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<!-- Edit User Modal -->
<div
  id="editUserModal"
  style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.35); z-index: 9999; align-items: center; justify-content: center;"
>
  <div style="background: #fff; width: min(480px, 90vw); border-radius: 18px; padding: 24px; box-shadow: 0 20px 40px rgba(0,0,0,0.18);">
    <h3 style="margin: 0 0 20px 0; font-size: 22px; color: #1f2a44;">Edit User</h3>

    <form action="/admin/users/edit" method="POST">
      <input type="hidden" name="id_user" id="editUserId" />

      <div class="form-field" style="margin-bottom: 12px;">
        <label class="form-label" for="editFullName">Full Name</label>
        <input type="text" id="editFullName" name="full_name" class="form-input" required />
      </div>

      <div class="form-field" style="margin-bottom: 12px;">
        <label class="form-label" for="editEmail">Email</label>
        <input type="email" id="editEmail" name="email" class="form-input" required />
      </div>

      <div class="form-field" style="margin-bottom: 12px;">
        <label class="form-label" for="editUsername">Username</label>
        <input type="text" id="editUsername" name="username" class="form-input" required />
      </div>

      <div class="form-field" style="margin-bottom: 20px;">
        <label class="form-label" for="editRole">Role</label>
        <select id="editRole" name="id_role" class="form-select" required>
          <% roles.forEach(r => { %>
            <option value="<%= r.id_role %>"><%= r.role_name %></option>
          <% }) %>
        </select>
      </div>

      <div style="display: flex; justify-content: flex-end; gap: 10px;">
        <button type="button" onclick="closeEditModal()" style="display: inline-flex; align-items: center; gap: 8px; border: none; background: #e74c3c; color: #fff; padding: 10px 16px; border-radius: 12px; font-weight: 700; cursor: pointer;">
          <i class="fa-solid fa-xmark"></i> Cancel
        </button>
        <button type="submit" style="display: inline-flex; align-items: center; gap: 8px; border: none; background: #27ae60; color: #fff; padding: 10px 16px; border-radius: 12px; font-weight: 700; cursor: pointer;">
          <i class="fa-solid fa-check"></i> Save
        </button>
      </div>
    </form>
  </div>
</div>

<!-- Toggle Status Modal -->
<div
  id="toggleStatusModal"
  style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.35); z-index: 9999; align-items: center; justify-content: center;"
>
  <div style="background: #fff; width: min(420px, 90vw); border-radius: 18px; padding: 24px; box-shadow: 0 20px 40px rgba(0,0,0,0.18);">
    <h3 style="margin: 0 0 10px 0; font-size: 22px; color: #1f2a44;" id="toggleModalTitle">Deactivate account</h3>
    <p id="toggleModalText" style="margin: 0 0 20px 0; color: #5f6b85; line-height: 1.5;">Are you sure you want to deactivate this account?</p>

    <div style="display: flex; justify-content: flex-end; gap: 10px;">
      <button
        type="button"
        id="cancelToggleBtn"
        style="display: inline-flex; align-items: center; gap: 8px; border: none; background: #e74c3c; color: #fff; padding: 10px 16px; border-radius: 12px; font-weight: 700; cursor: pointer;"
      >
        <i class="fa-solid fa-xmark"></i> Cancel
      </button>
      <button
        type="button"
        id="confirmToggleBtn"
        style="display: inline-flex; align-items: center; gap: 8px; border: none; background: #27ae60; color: #fff; padding: 10px 16px; border-radius: 12px; font-weight: 700; cursor: pointer;"
      >
        <i class="fa-solid fa-check"></i> Confirm
      </button>
    </div>
  </div>
</div>

<script>
  let pendingToggleUserId = null;
  let pendingToggleStatus = null;

  function openToggleModal(userId, currentStatus) {
    pendingToggleUserId = userId;
    pendingToggleStatus = currentStatus;

    document.getElementById('toggleModalTitle').textContent = currentStatus ? 'Deactivate account' : 'Activate account';
    document.getElementById('toggleModalText').textContent = currentStatus
      ? 'Are you sure you want to deactivate this account?'
      : 'Do you want to reactivate this account?';

    document.getElementById('toggleStatusModal').style.display = 'flex';
  }

  document.getElementById('cancelToggleBtn').addEventListener('click', () => {
    pendingToggleUserId = null;
    pendingToggleStatus = null;
    document.getElementById('toggleStatusModal').style.display = 'none';
  });

  document.getElementById('confirmToggleBtn').addEventListener('click', async () => {
    document.getElementById('toggleStatusModal').style.display = 'none';

    try {
      const res = await fetch(`/admin/users/${pendingToggleUserId}/toggle-status`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
      });

      if (res.redirected || !res.ok) {
        location.reload();
        return;
      }

      const data = await res.json();

      if (!data.success) {
        alert('Something went wrong. No changes were made.');
        return;
      }

      const isNowActive = data.is_active === 1;

      const badge = document.getElementById(`status-badge-${pendingToggleUserId}`);
      badge.textContent = isNowActive ? 'Active' : 'Inactive';
      badge.className = `status-badge ${isNowActive ? 'active' : 'inactive'}`;

      const btn = document.getElementById(`toggle-btn-${pendingToggleUserId}`);
      btn.title = isNowActive ? 'Deactivate' : 'Activate';
      btn.className = `btn-icon ${isNowActive ? 'btn-danger' : ''}`;

      const icon = document.getElementById(`toggle-icon-${pendingToggleUserId}`);
      icon.className = `fa-solid ${isNowActive ? 'fa-user-slash' : 'fa-user-check'}`;

      btn.setAttribute('onclick', `openToggleModal(${pendingToggleUserId}, ${isNowActive ? 1 : 0})`);

    } catch (err) {
      console.error('toggleStatus error:', err);
      alert('Connection error. Please try again.');
    }
  });

  document.getElementById('toggleStatusModal').addEventListener('click', (e) => {
    if (e.target === document.getElementById('toggleStatusModal')) {
      pendingToggleUserId = null;
      pendingToggleStatus = null;
      document.getElementById('toggleStatusModal').style.display = 'none';
    }
  });

  function openEditModal(id, fullName, email, username, idRole) {
    document.getElementById('editUserId').value = id;
    document.getElementById('editFullName').value = fullName;
    document.getElementById('editEmail').value = email;
    document.getElementById('editUsername').value = username;
    document.getElementById('editRole').value = idRole;
    document.getElementById('editUserModal').style.display = 'flex';
  }

  function closeEditModal() {
    document.getElementById('editUserModal').style.display = 'none';
  }

  document.getElementById('editUserModal').addEventListener('click', (e) => {
    if (e.target === document.getElementById('editUserModal')) closeEditModal();
  });
</script>