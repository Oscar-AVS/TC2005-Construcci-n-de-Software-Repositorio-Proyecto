<!-- Admin Roles View -->
<h1 id="pageTitle" class="page-title">Roles & Permissions</h1>

<!-- Roles Overview -->
<div class="report-card">
  <div class="report-card-header">
    <h2>System Roles</h2>
    <span class="item-count">4 roles</span>
  </div>

  <div class="report-card-body">
    <div class="roles-grid">

      <!-- Admin Role -->
      <div class="role-card admin-role">
        <div class="role-card-header">
          <div>
            <h3 class="role-card-title">Admin</h3>
            <p class="role-card-count">2 users</p>
          </div>
          <button class="btn-icon" type="button" title="Edit Permissions">
            <i class="fa-solid fa-pen"></i>
          </button>
        </div>

        <div class="role-permissions">
          <div class="permission-item">
            <i class="fa-solid fa-check"></i>
            <span>Manage all users</span>
          </div>
          <div class="permission-item">
            <i class="fa-solid fa-check"></i>
            <span>Create and delete teams</span>
          </div>
          <div class="permission-item">
            <i class="fa-solid fa-check"></i>
            <span>Configure integrations</span>
          </div>
          <div class="permission-item">
            <i class="fa-solid fa-check"></i>
            <span>Manage roles and permissions</span>
          </div>
          <div class="permission-item">
            <i class="fa-solid fa-check"></i>
            <span>Reset user credentials</span>
          </div>
        </div>
      </div>

      <!-- Manager Role -->
      <div class="role-card manager-role">
        <div class="role-card-header">
          <div>
            <h3 class="role-card-title">Manager</h3>
            <p class="role-card-count">5 users</p>
          </div>
          <button class="btn-icon" type="button" title="Edit Permissions">
            <i class="fa-solid fa-pen"></i>
          </button>
        </div>

        <div class="role-permissions">
          <div class="permission-item">
            <i class="fa-solid fa-check"></i>
            <span>Define goals and objectives</span>
          </div>
          <div class="permission-item">
            <i class="fa-solid fa-check"></i>
            <span>Create and manage highlights</span>
          </div>
          <div class="permission-item">
            <i class="fa-solid fa-check"></i>
            <span>View all contribution history</span>
          </div>
          <div class="permission-item">
            <i class="fa-solid fa-check"></i>
            <span>Generate AI summaries</span>
          </div>
          <div class="permission-item">
            <i class="fa-solid fa-check"></i>
            <span>Export reports (PDF/Excel)</span>
          </div>
        </div>
      </div>

      <!-- Team Leader Role -->
      <div class="role-card team-leader-role">
        <div class="role-card-header">
          <div>
            <h3 class="role-card-title">Team Leader</h3>
            <p class="role-card-count">8 users</p>
          </div>
          <button class="btn-icon" type="button" title="Edit Permissions">
            <i class="fa-solid fa-pen"></i>
          </button>
        </div>

        <div class="role-permissions">
          <div class="permission-item">
            <i class="fa-solid fa-check"></i>
            <span>View team members' logs</span>
          </div>
          <div class="permission-item">
            <i class="fa-solid fa-check"></i>
            <span>Add/remove team members</span>
          </div>
          <div class="permission-item">
            <i class="fa-solid fa-check"></i>
            <span>Generate team reports</span>
          </div>
          <div class="permission-item">
            <i class="fa-solid fa-check"></i>
            <span>Receive blocker notifications</span>
          </div>
          <div class="permission-item denied">
            <i class="fa-solid fa-xmark"></i>
            <span>Cannot manage other teams</span>
          </div>
        </div>
      </div>

      <!-- Employee Role -->
      <div class="role-card employee-role">
        <div class="role-card-header">
          <div>
            <h3 class="role-card-title">Employee</h3>
            <p class="role-card-count">32 users</p>
          </div>
          <button class="btn-icon" type="button" title="Edit Permissions">
            <i class="fa-solid fa-pen"></i>
          </button>
        </div>

        <div class="role-permissions">
          <div class="permission-item">
            <i class="fa-solid fa-check"></i>
            <span>Create daily log entries</span>
          </div>
          <div class="permission-item">
            <i class="fa-solid fa-check"></i>
            <span>View own history</span>
          </div>
          <div class="permission-item">
            <i class="fa-solid fa-check"></i>
            <span>Create self-reviews</span>
          </div>
          <div class="permission-item">
            <i class="fa-solid fa-check"></i>
            <span>View assigned projects</span>
          </div>
          <div class="permission-item denied">
            <i class="fa-solid fa-xmark"></i>
            <span>Cannot view others' logs</span>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>